@prefix udir: <http://psi.udir.no/ontologi/> .
@prefix u:    <http://psi.udir.no/ontologi/kl06/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix schema: <https://schema.org/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# udir:-laget (fase 4): begreper fra fagområdet som ikke er knyttet til én revisjon.
#
# Et forslag til Udir, brukt i Grep-sandkassen (beslutning B6, docs/plan-nattlig-normalisering.md).
# udir: brukes bare der det tilfører noe, for eksempel et overbegrep på tvers av revisjonene.
# Klasser som allerede gjelder begge revisjonene (u:Fagkode, u:Opplaeringsfag, ...) får ingen udir:-utgave.
#
# Lastes inn i urn:graph:ontologi av scripts/nattlig-innlasting.sh. Regel R1 (sparql/utledning/01-typer.ru)
# følger rdfs:subClassOf, så ?s a udir:Laereplan gir treff uten endringer i reglene.
#
# Bygges stegvis i dialog med fagansvarlig. Steg 1 (2026-11-08): overbegreper.

udir: a owl:Ontology ;
    rdfs:label "Udir-ontologi (forslag)"@nb, "Udir-ontologi (forslag)"@nn, "Udir ontology (proposal)"@en ;
    rdfs:comment "Begreper fra fagområdet som ikke er knyttet til én revisjon. Forslag fra Grep-sandkassen."@nb ;
    rdfs:seeAlso <https://github.com/aremjolsnes/grep-jena-fuseki/blob/main/docs/plan-nattlig-normalisering.md> .

# ---------------------------------------------------------------------------------------------------
# Overbegreper på tvers av revisjonene (LK06 og LK20)
# Avklart med fagansvarlig 2026-11-08: læreplan, kompetansemål og kompetansemålsett er samme begrep
# i begge revisjonene, i hver sin utgave.
# ---------------------------------------------------------------------------------------------------

udir:Laereplan a owl:Class ;
    rdfs:label "Læreplan"@nb, "Læreplan"@nn, "Curriculum"@en ;
    rdfs:comment "Læreplan uavhengig av revisjon. Omfatter læreplaner i LK06 og LK20."@nb,
        "Læreplan uavhengig av revisjon. Omfattar læreplanar i LK06 og LK20."@nn,
        "Curriculum regardless of revision. Covers curricula in LK06 and LK20."@en .

udir:Kompetansemaal a owl:Class ;
    rdfs:label "Kompetansemål"@nb, "Kompetansemål"@nn, "Competence aim"@en ;
    rdfs:comment "Kompetansemål uavhengig av revisjon. Omfatter kompetansemål i LK06 og LK20."@nb,
        "Kompetansemål uavhengig av revisjon. Omfattar kompetansemål i LK06 og LK20."@nn,
        "Competence aim regardless of revision. Covers competence aims in LK06 and LK20."@en .

udir:Kompetansemaalsett a owl:Class ;
    rdfs:label "Kompetansemålsett"@nb, "Kompetansemålsett"@nn, "Set of competence aims"@en ;
    rdfs:comment "Kompetansemålsett uavhengig av revisjon. Omfatter kompetansemålsett i LK06 og LK20."@nb,
        "Kompetansemålsett uavhengig av revisjon. Omfattar kompetansemålsett i LK06 og LK20."@nn,
        "Set of competence aims regardless of revision. Covers sets in LK06 and LK20."@en .

u:Laereplan rdfs:subClassOf udir:Laereplan .
u:Laereplan_lk20 rdfs:subClassOf udir:Laereplan .

u:Kompetansemaal rdfs:subClassOf udir:Kompetansemaal .
u:Kompetansemaal_lk20 rdfs:subClassOf udir:Kompetansemaal .

u:Kompetansemaalsett rdfs:subClassOf udir:Kompetansemaalsett .
u:Kompetansemaalsett_lk20 rdfs:subClassOf udir:Kompetansemaalsett .

# ---------------------------------------------------------------------------------------------------
# Hovedområde (LK06) og kjerneelement (LK20): beslektet, men ikke samme begrep
# Avklart med fagansvarlig 2026-11-08: ingen felles overbegrep og ingen kobling mellom ressursene,
# fordi en mapping mellom dem ville blitt en redaksjonell utfordring. De har en lignende plass i
# læreplanen, og det dokumenteres her uten at noe utledes.
# ---------------------------------------------------------------------------------------------------

u:Hovedomraade owl:disjointWith u:Kjerneelement_lk20 ;
    rdfs:seeAlso u:Kjerneelement_lk20 .

u:Kjerneelement_lk20 rdfs:seeAlso u:Hovedomraade .

[] a owl:Axiom ;
    owl:annotatedSource u:Hovedomraade ;
    owl:annotatedProperty rdfs:seeAlso ;
    owl:annotatedTarget u:Kjerneelement_lk20 ;
    rdfs:comment "Hovedområder (LK06) og kjerneelementer (LK20) har en lignende plass i læreplanen, men er ulike begreper. Det finnes ingen kobling mellom dem."@nb .

# ---------------------------------------------------------------------------------------------------
# Steg 2 (2026-11-08): reform og revisjon
# Avklart med fagansvarlig: Én reform, Kunnskapsløftet (KL06), med to revisjoner: LK06 og LK20
# (fagfornyelsen). Samiske læreplanverk (LK06S, LK20S) er varianter innenfor hver revisjon, ikke egne
# revisjoner. Klasser som gjelder begge revisjonene (fagkode, opplæringsfag, programområde ...) har ingen
# revisjon. Regel R3 (sparql/utledning/03-revisjon.ru) gir hver ressurs udir:revisjon fra klassen.
# ---------------------------------------------------------------------------------------------------

udir:Reform a owl:Class ;
    rdfs:label "Reform"@nb, "Reform"@nn, "Reform"@en ;
    rdfs:comment "En utdanningsreform, for eksempel Kunnskapsløftet."@nb,
        "Ei utdanningsreform, til dømes Kunnskapsløftet."@nn,
        "An education reform, for example the Knowledge Promotion."@en .

udir:Revisjon a owl:Class ;
    rdfs:label "Revisjon"@nb, "Revisjon"@nn, "Revision"@en ;
    rdfs:comment "En revisjon av en reform, med eget læreplanverk. Samiske læreplanverk er varianter innenfor revisjonen."@nb,
        "Ein revisjon av ei reform, med eige læreplanverk. Samiske læreplanverk er variantar innanfor revisjonen."@nn,
        "A revision of a reform, with its own national curriculum. Sami curricula are variants within the revision."@en .

udir:reform a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "reform"@nb, "reform"@nn, "reform"@en ;
    rdfs:comment "Reformen revisjonen hører til."@nb ;
    rdfs:domain udir:Revisjon ;
    rdfs:range udir:Reform .

udir:rekkefoelge a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "rekkefølge"@nb, "rekkjefølgje"@nn, "order"@en ;
    rdfs:comment "Nummeret til revisjonen innenfor reformen: 1 for den første, 2 for den neste."@nb ;
    rdfs:domain udir:Revisjon ;
    rdfs:range xsd:integer .

udir:revisjon a owl:ObjectProperty ;
    rdfs:label "revisjon"@nb, "revisjon"@nn, "revision"@en ;
    rdfs:comment "Revisjonen ressursen hører til. Utledes hver natt av regel R3 fra klassen (udir:gjelderRevisjon)."@nb ;
    rdfs:range udir:Revisjon .

udir:gjelderRevisjon a owl:AnnotationProperty ;
    rdfs:label "gjelder revisjon"@nb, "gjeld revisjon"@nn, "applies to revision"@en ;
    rdfs:comment "Sier at alle ressurser av klassen hører til revisjonen. Brukes av regel R3."@nb .

udir:KL06 a udir:Reform ;
    rdfs:label "Kunnskapsløftet"@nb, "Kunnskapsløftet"@nn, "The Knowledge Promotion"@en ;
    skos:notation "KL06" .

udir:LK06 a udir:Revisjon ;
    rdfs:label "LK06"@nb, "LK06"@nn, "LK06"@en ;
    rdfs:comment "Læreplanverket for Kunnskapsløftet, innført fra 2006."@nb ;
    udir:reform udir:KL06 ;
    udir:rekkefoelge 1 ;
    skos:notation "LK06" .

udir:LK20 a udir:Revisjon ;
    rdfs:label "LK20 (fagfornyelsen)"@nb, "LK20 (fagfornyinga)"@nn, "LK20 (the subject renewal)"@en ;
    rdfs:comment "Revisjonen av Kunnskapsløftet (fagfornyelsen), innført fra 2020."@nb ;
    udir:reform udir:KL06 ;
    udir:rekkefoelge 2 ;
    skos:notation "LK20" .

# LK06-klassene
u:Laereplan udir:gjelderRevisjon udir:LK06 .
u:Kompetansemaal udir:gjelderRevisjon udir:LK06 .
u:Kompetansemaalsett udir:gjelderRevisjon udir:LK06 .
u:Hovedomraade udir:gjelderRevisjon udir:LK06 .
u:Programfag udir:gjelderRevisjon udir:LK06 .

# LK20-klassene
u:Laereplan_lk20 udir:gjelderRevisjon udir:LK20 .
u:Kompetansemaal_lk20 udir:gjelderRevisjon udir:LK20 .
u:Kompetansemaalsett_lk20 udir:gjelderRevisjon udir:LK20 .
u:Kjerneelement_lk20 udir:gjelderRevisjon udir:LK20 .
u:Tverrfaglig_tema_lk20 udir:gjelderRevisjon udir:LK20 .
u:Grunnleggende_ferdighet_lk20 udir:gjelderRevisjon udir:LK20 .
u:Ordforklaring_lk20 udir:gjelderRevisjon udir:LK20 .
u:Verb_lk20 udir:gjelderRevisjon udir:LK20 .

# ---------------------------------------------------------------------------------------------------
# Steg 3 (2026-11-08): SKOS-begrepssystemer
# Avklart med fagansvarlig: Grep-ressursene blir selv SKOS-begreper (regel R4,
# sparql/utledning/04-skos.ru). Her står bare begrepssystemene og hvilke klasser som hører til dem,
# så nye verdier i Grep kommer med automatisk.
# - Fagområde er et underbegrep av fagkategori (ett system med to nivåer). Hierarkiet kommer fra
#   u:fagkategori via R2.
# - Fagtype er ikke et underbegrep av opplæringsnivå, og de kobles ikke i SKOS. Dataene har allerede
#   u:opplaeringsnivaa på fagtypen (valgfag brukes i grunnskolen).
# ---------------------------------------------------------------------------------------------------

udir:begrepssystem a owl:AnnotationProperty ;
    rdfs:label "begrepssystem"@nb, "omgrepssystem"@nn, "concept scheme"@en ;
    rdfs:comment "Sier at alle ressurser av klassen er begreper i begrepssystemet. Brukes av regel R4."@nb .

udir:Fagtyper a skos:ConceptScheme ;
    rdfs:label "Fagtyper"@nb, "Fagtypar"@nn, "Subject types"@en ;
    skos:prefLabel "Fagtyper"@nb, "Fagtypar"@nn, "Subject types"@en ;
    rdfs:comment "Hva slags fag en fagkode er, for eksempel fellesfag, valgfag eller felles programfag."@nb .

udir:Opplaeringsnivaaer a skos:ConceptScheme ;
    rdfs:label "Opplæringsnivåer"@nb, "Opplæringsnivå"@nn, "Levels of education"@en ;
    skos:prefLabel "Opplæringsnivåer"@nb, "Opplæringsnivå"@nn, "Levels of education"@en ;
    rdfs:comment "Grunnskole, videregående opplæring og forberedende opplæring for voksne."@nb .

udir:Fagkategorier a skos:ConceptScheme ;
    rdfs:label "Fagkategorier og fagområder"@nb, "Fagkategoriar og fagområde"@nn, "Subject categories and areas"@en ;
    skos:prefLabel "Fagkategorier og fagområder"@nb, "Fagkategoriar og fagområde"@nn, "Subject categories and areas"@en ;
    rdfs:comment "Fagkategorier (for eksempel Estetiske fag) med fagområdene under (for eksempel Dansefag)."@nb .

u:Fagtype udir:begrepssystem udir:Fagtyper .
u:Opplaeringsnivaa udir:begrepssystem udir:Opplaeringsnivaaer .
u:Fagkategori udir:begrepssystem udir:Fagkategorier .
u:Fagomraade udir:begrepssystem udir:Fagkategorier .

# Fagområdet peker på fagkategorien sin (bare fagområder bruker u:fagkategori, 51 av 51)
u:fagkategori rdfs:subPropertyOf skos:broader .

# ---------------------------------------------------------------------------------------------------
# Steg 4 (2026-11-08): språk og språknivå
# Avklart med fagansvarlig:
# - Språkene i Grep (d:nob, d:sme ...) er nøyaktig de samme som i EUs språktabell (ISO 639), så de får
#   skos:exactMatch dit (regel R5, sparql/utledning/05-spraak.ru). Alle ti finnes der (sjekket 2026-11-08).
# - Språknivå I–III blir et eget begrepssystem. De svarer til CEFR-nivåene A1, A2 og B1 (u:cefr i Grep),
#   men CEFR har ikke noe offisielt endepunkt med faste adresser ennå. Vi lager ikke egne CEFR-begreper:
#   de hører til Europarådet. Kobles når et offisielt vokabular finnes.
# ---------------------------------------------------------------------------------------------------

udir:Spraak a skos:ConceptScheme ;
    rdfs:label "Språk"@nb, "Språk"@nn, "Languages"@en ;
    skos:prefLabel "Språk"@nb, "Språk"@nn, "Languages"@en ;
    rdfs:comment "Språkene i Grep, koblet til EUs språktabell (http://publications.europa.eu/resource/authority/language)."@nb ;
    rdfs:seeAlso <http://publications.europa.eu/resource/authority/language> .

udir:Spraaknivaaer a skos:ConceptScheme ;
    rdfs:label "Språknivåer"@nb, "Språknivå"@nn, "Language levels"@en ;
    skos:prefLabel "Språknivåer"@nb, "Språknivå"@nn, "Language levels"@en ;
    rdfs:comment "Nivå I, II og III i fremmedspråk. Svarer til CEFR-nivåene A1, A2 og B1 (u:cefr)."@nb .

u:Spraak udir:begrepssystem udir:Spraak .
u:Spraaknivaa udir:begrepssystem udir:Spraaknivaaer .

# ---------------------------------------------------------------------------------------------------
# Steg 5 (2026-11-08): Dublin Core
# Avklart med fagansvarlig: vi begynner med relasjonene. Tekst og datoer som tittel, kode, sist endret og
# beskrivelse (ca. 250 000 tripler) venter til noen trenger dem. R2 (sparql/utledning/02-egenskaper.ru)
# følger rdfs:subPropertyOf, så ingen ny regel trengs.
# - u:fastsatt-dato er datoen planen ble vedtatt: dcterms:dateAccepted (ikke dcterms:issued).
# - u:fastsatt-spraak er språket planen er fastsatt på: dcterms:language. u:tilgjengelige-spraak kobles
#   ikke: den omfatter alle språkene planen er tilgjengelig på, også det fastsatte.
# ---------------------------------------------------------------------------------------------------

u:erstatter rdfs:subPropertyOf dcterms:replaces .
u:erstattes-av rdfs:subPropertyOf dcterms:isReplacedBy .
u:tilhoerer-laereplan rdfs:subPropertyOf dcterms:isPartOf .
u:fastsatt-dato rdfs:subPropertyOf dcterms:dateAccepted .
u:fastsatt-spraak rdfs:subPropertyOf dcterms:language .

# ---------------------------------------------------------------------------------------------------
# N5 (2026-11-08): tittel per målform, med reserve (sparql/normalisering/04-titler.ru)
# Avklart med fagansvarlig: u:tittel@default er fastsettelsesspråket, som kan være samisk (bare LK20) eller
# nynorsk. To speilvendte egenskaper gir én tittel for hver målform. Verdien er merket med språket den
# faktisk er på, så LANG() viser om en reserve er brukt.
# ---------------------------------------------------------------------------------------------------

udir:bokmaalTittel a owl:DatatypeProperty ;
    rdfs:label "bokmålstittel"@nb, "bokmålstittel"@nn, "title in Bokmål"@en ;
    rdfs:comment "Tittelen på bokmål. Reserve: nynorsk, deretter tittelen på fastsettelsesspråket. Gjelder læreplaner og alt som hører til dem."@nb ;
    rdfs:range rdf:langString .

udir:nynorskTittel a owl:DatatypeProperty ;
    rdfs:label "nynorsktittel"@nb, "nynorsktittel"@nn, "title in Nynorsk"@en ;
    rdfs:comment "Tittelen på nynorsk. Reserve: bokmål, deretter tittelen på fastsettelsesspråket. Gjelder læreplaner og alt som hører til dem."@nb ;
    rdfs:range rdf:langString .

# ---------------------------------------------------------------------------------------------------
# Steg 6 (2026-11-08): gyldighetsvokabularet
# Egenskapene finnes i data fra N1 (sparql/normalisering/01-gyldighet.ru) og N4 (03-perioder.ru). Her blir de
# beskrevet formelt. Avklart med fagansvarlig:
# - Alle datoer er xsd:date. Til-datoen er siste gyldige dag. 1970-01-01 og 2100-12-31 betyr at perioden er
#   åpen i den enden (sandkassens egne verdier, ikke Udirs).
# - Gyldighet (redaksjonell), undervisning og eksamen er tre ulike perioder.
# - Bare gyldigFra/gyldigTil kobles til schema.org (validFrom/validThrough), via R2. Undervisning og eksamen
#   kobles ikke, for da ville schema.org ikke lenger skille mellom de tre periodene.
# ---------------------------------------------------------------------------------------------------

udir:Gyldighet a owl:Class ;
    rdfs:label "Gyldighet"@nb, "Gyldigheit"@nn, "Validity"@en ;
    rdfs:comment "Gyldighetsperioden for én kobling mellom to ressurser, for eksempel hvilket opplæringsfag en fagkode hørte til i en periode. Lages av N1 fra de blanke nodene i Grep."@nb,
        "Gyldigheitsperioden for éi kopling mellom to ressursar. Blir laga av N1 frå dei blanke nodane i Grep."@nn,
        "The validity period of one link between two resources. Made by N1 from the blank nodes in Grep."@en .

udir:gyldighet a owl:ObjectProperty ;
    rdfs:label "gyldighet"@nb, "gyldigheit"@nn, "validity"@en ;
    rdfs:comment "Fra ressursen til gyldighetsperioden for en av koblingene dens."@nb ;
    rdfs:range udir:Gyldighet .

udir:relasjon a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "relasjon"@nb, "relasjon"@nn, "relation"@en ;
    rdfs:comment "Hvilken Grep-egenskap koblingen gjelder, for eksempel u:opplaeringsfag."@nb ;
    rdfs:domain udir:Gyldighet .

udir:objekt a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "objekt"@nb, "objekt"@nn, "object"@en ;
    rdfs:comment "Ressursen koblingen peker til."@nb ;
    rdfs:domain udir:Gyldighet .

udir:gyldigFra a owl:DatatypeProperty ;
    rdfs:label "gyldig fra"@nb, "gyldig frå"@nn, "valid from"@en ;
    rdfs:comment "Første gyldige dag, satt redaksjonelt i Grep eller utledet fra første semester. 1970-01-01 betyr åpen start."@nb ;
    rdfs:range xsd:date ;
    rdfs:subPropertyOf schema:validFrom .

udir:gyldigTil a owl:DatatypeProperty ;
    rdfs:label "gyldig til"@nb, "gyldig til"@nn, "valid through"@en ;
    rdfs:comment "Siste gyldige dag, satt redaksjonelt i Grep eller utledet fra siste semester. 2100-12-31 betyr inntil videre."@nb ;
    rdfs:range xsd:date ;
    rdfs:subPropertyOf schema:validThrough .

udir:undervisningFra a owl:DatatypeProperty ;
    rdfs:label "undervisning fra"@nb, "undervisning frå"@nn, "teaching from"@en ;
    rdfs:comment "Første dag det gis undervisning i fagkoden (første dag i første undervisningssemester)."@nb ;
    rdfs:range xsd:date .

udir:undervisningTil a owl:DatatypeProperty ;
    rdfs:label "undervisning til"@nb, "undervisning til"@nn, "teaching until"@en ;
    rdfs:comment "Siste dag det gis undervisning i fagkoden (siste dag i siste undervisningssemester). 2100-12-31 betyr inntil videre."@nb ;
    rdfs:range xsd:date .

udir:eksamenFra a owl:DatatypeProperty ;
    rdfs:label "eksamen fra"@nb, "eksamen frå"@nn, "exam from"@en ;
    rdfs:comment "Første dag man kan ta eksamen i fagkoden (første dag i første eksamenssemester)."@nb ;
    rdfs:range xsd:date .

udir:eksamenTil a owl:DatatypeProperty ;
    rdfs:label "eksamen til"@nb, "eksamen til"@nn, "exam until"@en ;
    rdfs:comment "Siste dag man kan ta eksamen i fagkoden (siste dag i siste eksamenssemester). 2100-12-31 betyr inntil videre."@nb ;
    rdfs:range xsd:date .

udir:startdato a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "startdato"@nb, "startdato"@nn, "start date"@en ;
    rdfs:comment "Første dag i semesteret: 1. januar for vår, 1. august for høst."@nb ;
    rdfs:domain u:Semester ;
    rdfs:range xsd:date .

udir:sluttdato a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "sluttdato"@nb, "sluttdato"@nn, "end date"@en ;
    rdfs:comment "Siste dag i semesteret: 31. juli for vår, 31. desember for høst."@nb ;
    rdfs:domain u:Semester ;
    rdfs:range xsd:date .
