    sssom:mapping_tool "Claude (Anthropic)" ;
    sssom:comment "Funnet i stikkprøve av bortvalgte kandidater (2026-11-10). HMS-regelverket i transport er en del av «i tråd med lovverk, helse-, miljø- og sikkerhetstiltak»" .
<http://psi.udir.no/kl06/KM8642> <http://www.w3.org/2004/02/skos/core#narrowMatch> <http://data.europa.eu/esco/skill/74ad37e3-325b-4ccd-ab2a-04f7696750e8> .

<http://psi.udir.no/kl06/kobling/km-esco/BMK03-03/KM8642/a6aa15be-1d6b-4361-9eaf-bb6be5eb6f10> a sssom:Mapping ;
    sssom:mapping_set <http://psi.udir.no/kl06/kobling/km-esco/BMK03-03> ;
    sssom:subject_id <http://psi.udir.no/kl06/KM8642> ;
