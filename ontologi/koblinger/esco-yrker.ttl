    skos:prefLabel "spesialisert selger, tobakk"@nb ;
    skos:definition "Spesialiserte selgere, tobakk selger tobakksprodukter i spesialbutikker."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/547b304b-9a72-4717-9b24-b7046df5f64e> ;
