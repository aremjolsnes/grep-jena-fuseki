<http://data.europa.eu/esco/occupation/8269720b-49c7-4185-ad7e-05d8d31ac041> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5223.7.37" ;
    skos:prefLabel "spesialisert selger innen spill og leker"@nb ;
    skos:definition "Spesialiserte selgere innen spill og leker selger leker og spill i spesialbutikker."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/547b304b-9a72-4717-9b24-b7046df5f64e> ;
