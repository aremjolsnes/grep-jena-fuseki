@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix esco:  <http://data.europa.eu/esco/model#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<http://data.europa.eu/esco/occupation/72381086-cb6e-455e-a40b-ccb26550aab6> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3131.1" ;
    skos:prefLabel "operatør på energikraftverk"@nb ;
    skos:definition "Operatører på energikraftverk overvåker og betjener utstyret på kraftstasjoner og andre anlegg for energiproduksjon. De reparerer feil, betjener maskiner direkte eller fra et kontrollrom, og håndterer materialer knyttet til produksjon av elektrisitet i samsvar med sikkerhets- og miljøprosedyrer. De legger til rette for samhandling mellom anlegg for elektrisk energi og sikrer at distribusjonen skjer på en sikker måte."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C3131> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/74332fd0-4a50-464e-9116-98fa9b8127ac> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3131.1.1" ;
    skos:prefLabel "operatør, strømdistribusjon"@nb ;
    skos:definition "Operatører innen strømdistribusjon betjener og vedlikeholder utstyr som leverer energi fra overføringsnettet til forbrukeren. De overvåker vedlikehold og reparasjoner av kraftledningen og sikrer at distribusjonsbehovene er oppfylt. De reagerer også på feil i distribusjonssystemet som forårsaker strømbrudd og andre problemer."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/72381086-cb6e-455e-a40b-ccb26550aab6> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/7cdeb653-8f3d-4921-832b-b95f9d700a86> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3131.1.2" ;
    skos:prefLabel "operatør av elektrisitetssystem"@nb ;
    skos:definition "Operatører av elektrisitetssystemer transporterer energi i form av elektrisk effekt. De overfører elektrisk effekt fra elektrisitetsverk over et sammenkoplet nettverk, et strømnett, til eldistribusjonsstasjoner."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/72381086-cb6e-455e-a40b-ccb26550aab6> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/16b974f4-cb8c-436c-8c05-a16957c40131> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3131.1.3" ;
    skos:prefLabel "energiverksoperatør, fossilt brensel"@nb ;
    skos:definition "Energiverksoperatører innen fossilt brensel betjener og vedlikeholder industrielt utstyr, for eksempel generatorer, turbiner og kjeler, som produserer elektrisitet framstilt av fossilt brensel, for eksempel naturgass eller kull. De sørger for sikker drift og at utstyret er i samsvar med lovgivningen. De kan også arbeide i kombinerte kraftverk, der avgassvarme fra en operasjon gjenvinnes og driver dampturbiner."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/72381086-cb6e-455e-a40b-ccb26550aab6> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/c3959398-a5d7-4b26-abcf-ef7af87e5822> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3131.1.4" ;
    skos:prefLabel "operatør på geotermisk kraftanlegg"@nb ;
    skos:definition "Operatører på geotermiske kraftanlegg betjener og vedlikeholder utstyr, ofte dampdrevne turbiner, som produserer elektrisk energi. De overvåker måleutstyr for å sørge for sikker drift, og at produksjonsbehovene er oppfylt. De reagerer også på systemproblemer og reparerer feil. De kan regulere generatorene for å kontrollere strømmen av elektrisitet til kraftlinjene."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/72381086-cb6e-455e-a40b-ccb26550aab6> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/12938d1a-eeb2-4b1e-a22b-f0bebeadfb73> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3131.1.5" ;
    skos:prefLabel "operatør på vannkraftverk"@nb ;
    skos:definition "Operatører på vannkraftverk betjener og vedlikeholder utstyr som brukes i produksjonen av energi fra vannbevegelser. De overvåker måleutstyret, vurderer produksjonsbehovene og tilpasser vannstrømmen for å oppfylle disse behovene. De utfører også reparasjons- og vedlikeholdsoppgaver."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/72381086-cb6e-455e-a40b-ccb26550aab6> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/b2eacfdf-5de5-4e8c-a8cb-3d32e201c210> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3131.1.6" ;
    skos:prefLabel "driftstekniker, kjernekraftverk"@nb ;
    skos:definition "Driftsteknikere på kjernekraftverk kontrollerer kjernereaktorer på kraftanlegg direkte fra kontrollpaneler, og har eneansvar for endringer i reaktoraktiviteten. De starter driften og reagerer på endringer i status, for eksempel ulykker og kritiske hendelser. De overvåker parametere og sikrer at sikkerhetsreglene overholdes."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/72381086-cb6e-455e-a40b-ccb26550aab6> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/f33a70bd-c5b6-495d-8e0c-5e2c6e56d93e> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3131.1.7" ;
    skos:prefLabel "kontrollromoperatør, kraftverk"@nb ;
    skos:definition "Kontrollromoperatører på kraftverk har ansvar for sikker og riktig drift av kraftverk, friluftsstasjoner og tilhørende kontrollstrukturer. De reparerer og vedlikeholder maskinene og utstyret som er involvert, for å sikre at anlegget drives på en effektiv måte, og for å håndtere strømbrudd og andre nødssituasjoner."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/72381086-cb6e-455e-a40b-ccb26550aab6> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/6d823dbb-4008-4fb7-b98d-f9d934478647> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3131.1.8" ;
    skos:prefLabel "operatør ved solenergianlegg"@nb ;
    skos:definition "Operatører ved solenergianlegg betjener og vedlikeholder utstyr som produserer elektrisk energi fra solenergi. De overvåker måleutstyr for å sørge for sikker drift, og at produksjonsbehovene er oppfylt. De reagerer også på systemproblemer og reparerer feil."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/72381086-cb6e-455e-a40b-ccb26550aab6> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/aac62c63-b6bf-4387-8ba3-75a487f25824> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3131.1.9" ;
    skos:prefLabel "operatør av dampturbin"@nb ;
    skos:definition "Operatører av dampturbin betjener og vedlikeholder maskiner som genererer strøm. De sørger for sikker drift og overvåker driften for å oppdage problemer og reagere på nødssituasjoner."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/72381086-cb6e-455e-a40b-ccb26550aab6> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/0da75680-fbf9-44d8-802a-ac12eb425a34> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3141.1" ;
    skos:prefLabel "tekniker, bioteknologi"@nb ;
    skos:definition "Teknikere innen bioteknologi utfører teknologisk arbeid for å bistå forskere. De arbeider i laboratoriemiljøer, der de kan hjelpe forskere med å forske på, utvikle og teste former for bioteknologi. De setter opp laboratorieutstyr, klargjør vitenskapelige tester og samler inn vitenskapelige data."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C3141> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/4fef1907-cf82-413b-841a-02ef57e299a6> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3141.2" ;
    skos:prefLabel "vitenskapelig laboratorietekniker"@nb ;
    skos:definition "Vitenskapelige laboratorieteknikere foretar laboratoriebasert forskning, analyse og testing og støtter profesjonelle innen livsvitenskap. De tar prøver, tester, måler, forsker og analyserer i områder som for eksempel biologi, bioteknologi, miljøvitenskap, rettsmedisin og farmakologi. Vitenskapelige laboratorieteknikere observerer og overvåker også laboratorieaktiviteter, registrerer testsekvenser og analyserer resultatene."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C3141> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/f3b99acc-b212-45cf-bb4f-7b83cc6f0d71> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3141.2.1" ;
    skos:prefLabel "laboratorietekniker innen bakteriologi"@nb ;
    skos:definition "Laboratorieteknikere innen bakteriologi gir teknisk bistand i forskning på og testing av bakterier ved hjelp av laboratorieutstyr. De samler inn og analyserer data til eksperimenter, setter sammen rapporter og vedlikeholder laboratoriebeholdningen."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/4fef1907-cf82-413b-841a-02ef57e299a6> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/95324a4a-a5ea-4d89-8ede-4422ccb46a28> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3141.2.2" ;
    skos:prefLabel "biokjemitekniker"@nb ;
    skos:definition "Biokjemiteknikere gir teknisk bistand innen forskning på, analyse av og testing av reaksjoner som skyldes kjemikalier i levende organismer. De bruker laboratorieutstyr for å bidra til å utvikle eller forbedre kjemibaserte produkter, de samler inn og analyserer data til eksperimenter, de utarbeider rapporter, og de vedlikeholde laboratorielageret."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/4fef1907-cf82-413b-841a-02ef57e299a6> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/31cc4199-703c-4f8a-9b46-a2070a6d35df> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3141.2.3" ;
    skos:prefLabel "laboratorietekniker innen biologi"@nb ;
    skos:definition "Laboratorieteknikere innen biologi gir teknisk bistand innen forskning på og analyse av forholdet mellom levende organismer og deres miljø. De bruker laboratorieutstyr til å undersøke organiske stoffer, for eksempel kroppsvæsker, medisiner, planter og næringsmidler. De samler inn og analyserer data til eksperimenter, setter sammen rapporter og vedlikeholder laboratoriebeholdningen."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/4fef1907-cf82-413b-841a-02ef57e299a6> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/2c5ae1b4-c3ca-4882-b7ce-e346ae5b5b00> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3141.2.4" ;
    skos:prefLabel "laboratorietekniker innen botanikk"@nb ;
    skos:definition "Laboratorieteknikere innen botanikk gir teknisk bistand ved forskning på og testing av ulike plantearter, for å overvåke egenskaper, for eksempel vekst og struktur. De samler inn og analyserer data, ved hjelp av laboratorieutstyr, setter sammen rapporter og vedlikeholder laboratoriebeholdningen. Laboratorieteknikere innen botanikk studerer også planter for å finne ut hvordan de kan brukes innen medisin, mat og materialer og på andre områder."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/4fef1907-cf82-413b-841a-02ef57e299a6> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/ff4c28e2-66b1-4ae7-9053-fba8ec3428be> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3141.2.5" ;
    skos:prefLabel "zoologitekniker"@nb ;
    skos:definition "Zoologiteknikere gir teknisk bistand i forskning på og testing av dyrearter ved hjelp av laboratorieutstyr. De bistår i forskning knyttet til både dyr og miljøene og økosystemene de tilhører. De samler inn og analyserer data, setter sammen rapporter og vedlikeholder laboratoriebeholdningen."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/4fef1907-cf82-413b-841a-02ef57e299a6> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/1f8314c2-01bd-4af4-babc-04d7034591b8> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3142.1" ;
    skos:prefLabel "agrotekniker"@nb ;
    skos:definition "Agroteknikere samler inn og utfører eksperimenter og tester på prøver innen landbruk og akvakultur. De gir støtte til forskere og gårdbrukere, og analyserer og rapporterer også om forholdene i miljøene der prøvene er samlet inn."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C3142> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/f9cbdeb4-1559-4d45-b2d7-edf8aebe400b> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3142.1.1" ;
    skos:prefLabel "kvalitetsinspektør innen akvakultur"@nb ;
    skos:definition "Kvalitetsinspektører innen akvakultur fastsetter standarder og policyer for kvalitetskontroll av produksjon av akvatiske organismer. De tester og inspiserer beholdningen i henhold til prinsipper for fareanalyse og kritiske kontrollpunkter (HACCP) og sikkerhetsforskrifter."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/1f8314c2-01bd-4af4-babc-04d7034591b8> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/ac036ea7-883a-4265-96d5-c02bbe6667e1> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3142.1.2" ;
    skos:prefLabel "driftsleder ved akvakulturbruk"@nb ;
    skos:definition "Driftsledere ved akvakulturbruk fører tilsyn med produksjonsprosesser i store akvakulturvirksomheter og inspiserer akvakulturanlegg for å opprettholde og forbedre ytelsen. De vedlikeholder helse, trygghet og sikkerhet på arbeidsplassen, de utarbeider styringsplaner for å redusere risiko fra skadedyr, rovdyr og sykdommer, de overvåker deponering av biologisk og kjemisk avfall, og de overvåker vedlikehold av utstyr og maskiner."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/1f8314c2-01bd-4af4-babc-04d7034591b8> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/b9e51ff4-d7fb-4653-bc72-65086ffc6e65> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3142.1.3" ;
    skos:prefLabel "rådgiver innen vinproduksjon"@nb ;
    skos:definition "Rådgivere innen vinproduksjon gir råd om hvordan vinproduksjon kan forbedres."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/1f8314c2-01bd-4af4-babc-04d7034591b8> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/521bbfd5-c179-46e3-879b-e74bd6db367c> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3214.1" ;
    skos:prefLabel "audiograf"@nb ;
    skos:definition "Audiografer lager og vedlikeholder høreapparater og hørselsvernprodukter. De utleverer, tilpasser og leverer høreapparater til dem som trenger dem."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C3214> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/76bded28-876a-40b2-9efb-3123c8f14cf6> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3214.2" ;
    skos:prefLabel "tanntekniker"@nb ;
    skos:definition "Tannteknikere produserer tilpassede innretninger som broer, kroner, tannproteser og innretninger under tilsyn av tannleger, i henhold til deres anvisninger og spesifikasjoner."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C3214> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/929b5c9d-2fbf-44f2-980d-2ac6c0dc212f> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3214.3" ;
    skos:prefLabel "protesemaker"@nb ;
    skos:definition "Protesemakere designer og tilpasser proteser og ortoser for personer som mangler et lem som følge av ulykke, sykdom eller genetisk tilstand, eller personer som har funksjonsnedsettelser, mangler eller svakheter som følge av skade, patologi eller genetisk misdannelse. De blander pasientbehandling med design og produksjon av disse enhetene, for oppfylle pasientenes behov."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C3214> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/500b7b14-507c-4c49-816d-c1d0b05b85e4> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3214.3.1" ;
    skos:prefLabel "ortopedi- og protesetekniker"@nb ;
    skos:definition "Ortopedi- og proteseteknikere designer, lager, tilpasser og reparerer kirurgiske og medisinske innretninger som støtter, ledd og innleggssåler."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/929b5c9d-2fbf-44f2-980d-2ac6c0dc212f> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/0c041d1e-1841-4acb-b0a1-2c387a61bf65> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3256.1" ;
    skos:prefLabel "legeassistent"@nb ;
    skos:definition "Legeassistenter støtter leger i medisinske handlinger og hjelper med å utføre enkle støtteaktiviteter under medisinske prosedyrer, standardiserte diagnostiske programmer og standardiserte tester, sikrer kirurgisk hygiene, rengjøring, desinfisering, sterilisering og vedlikehold av medisinsk utstyr og utfører de organisatoriske og administrative oppgavene som er nødvendige for å drive den kirurgiske virksomheten, under tilsyn av etter instrukser fra legen."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C3256> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/64e909ad-1bd0-493c-a8dc-1afbed0c9c2f> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3258.1" ;
    skos:prefLabel "ambulansesjåfør"@nb ;
    skos:definition "Ambulansesjåfører bruker nødkjøretøyer for å respondere på medisinske nødssituasjoner og støtter arbeidet til ambulansearbeidere, flytter pasienter på en sikker måte, legger merke til endringer i pasientens vitale tegn, rapporterer til de ansvarlige førstehjelperne og sikrer at det medisinske utstyret lagres og transporteres på riktig måte, og at det er funksjonelt, under tilsyn av og etter instrukser fra en lege."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C3258> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/0b5dfc02-b825-4445-811d-d39ed442657e> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3258.2" ;
    skos:prefLabel "ambulansearbeider"@nb ;
    skos:definition "Ambulansearbeidere gir nødhjelp til syke, skadde og sårbare personer i akuttmedisinske situasjoner, før og under transporten til en medisinsk fasilitet. De gjennomfører og fører tilsyn med transporten av pasienten. De gir bistand i akutte situasjoner, implementerer livreddende tiltak og overvåker gjennomføringen av transportprosessen. Hvis nasjonal lovgivning tillater det, kan de også gi oksygen, visse legemidler, punktere perifere vener, tilføre krystalloidløsninger og utføre endotracheal intubering hvis det er nødvendig, for umiddelbar forebygging av trusler for liv og helse for en pasient i nødtilstand."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C3258> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/14031d4a-6e99-442f-b4fe-18262b6432b2> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3322.1" ;
    skos:prefLabel "salgsrepresentant"@nb ;
    skos:definition "Salgsrepresentanter representerer et selskap ved å selge og gi informasjon om varer og tjenester til foretak og organisasjoner."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C3322> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/4c6b3657-316e-43b5-872a-ea763411190d> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3322.1.1" ;
    skos:prefLabel "elsalgskonsulent"@nb ;
    skos:definition "Elsalgkonsulenter vurderer kundens energibehov og anbefaler kjøp av strøm fra deres foretak. De promoterer selskapets tjenester og forhandler fram kjøpsavtaler med kunder."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/14031d4a-6e99-442f-b4fe-18262b6432b2> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/ff3a164d-4045-4511-a472-49093dabf9fc> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3322.1.2" ;
    skos:prefLabel "selger, fornybar energi"@nb ;
    skos:definition "Selgere innen fornybar energi vurderer kundenes energibehov og forsøker å sikre salg av for fornybare energimetoder. De promoterer leverandører av fornybar energi og bruk av fornybare energiprodukter, og tar kontakt med forbrukere for å øke salget."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/14031d4a-6e99-442f-b4fe-18262b6432b2> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/66542dd6-05a6-4d9e-97ff-3f4858c31ff9> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3431.1" ;
    skos:prefLabel "fotograf"@nb ;
    skos:definition "Fotografer tar bilder ved hjelp av kamera eller utstyr som er digitalt eller bruker film. Fotografer kan fremkalle negativer eller bruke dataprogramvare til å produsere ferdige bilder og utskrifter."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C3431> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/480d2853-db07-43d4-847f-7ffdd8d368f5> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3431.2" ;
    skos:prefLabel "fotojournalist"@nb ;
    skos:definition "Fotojournalister dekker alle slags nyhetshendelser ved å ta informative bilder. De forteller historier ved å ta, redigere og presentere bilder for aviser, tidsskrifter, magasiner, TV og andre medier."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C3431> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/73e776fb-4d99-4031-bad4-7716f121155d> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3432.1" ;
    skos:prefLabel "interiørdesigner"@nb ;
    skos:definition "Interiørdesigner designer eller renoverer rom innendørs, inkludert strukturelle endringer, inventar, belysning, fargevalg og møbler. De kombinerer effektiv og funksjonell bruk av rommet med en forståelse av estetikk."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C3432> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/773e5ea3-235b-4e72-afc5-290dd841eed8> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3432.1.1" ;
    skos:prefLabel "innredningskonsulent"@nb ;
    skos:definition "Innredningskonsulenter hjelper kunder med å planlegge interiøret sitt til kommersiell og privat bruk."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/73e776fb-4d99-4031-bad4-7716f121155d> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/f1fcad3b-fdf0-444a-81b0-e50e96f8966a> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3432.2" ;
    skos:prefLabel "salgsfremmer"@nb ;
    skos:definition "Salgsfremmere er ansvarlige for å plassere varer i henhold til standarder og prosedyrer."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C3432> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/88760821-9df4-47a6-a1c2-ac08b9759396> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3432.3" ;
    skos:prefLabel "konstruktør av miniatyrkulisser"@nb ;
    skos:definition "Konstruktør av miniatyrkulisser designer og bygger miniatyrrekvisitter og -kulisser til filmer. De bygger modeller som brukes til visuelle effekter, som oppfyller utseendet og kravene til produksjonen. Konstruktør av miniatyrkulisser tilpasser materialet ved hjelp av håndverktøy for å konstruere tredimensjonale rekvisitter og kulisser."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C3432> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/34e1c889-0fd1-4d1f-aba9-3b6263ae667a> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3432.4" ;
    skos:prefLabel "scenebygger"@nb ;
    skos:definition "Scenebyggere konstruerer, bygger, klargjør, tilpasser og vedlikeholder sceneelementer som brukes på teateret og til innspilling av filmer eller TV-programmer. De bruker et bredt utvalg av materialer, som tre, stål, aluminium og plast. Arbeidet deres er basert på kunstnerisk visjon, skalamodeller, skisser og planer. De samarbeider tett med designerne og kan bygge stands til messer, karneval og andre arrangementer."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C3432> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/4ed36f4c-9d5b-4a01-bf59-7f3c7844ce95> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3432.4.1" ;
    skos:prefLabel "scenemaler"@nb ;
    skos:definition "Scenemalere dekorerer scener for liveopptredener. De bruker et bredt utvalg av håndverks- og maleteknikker, som figurmaling, landskapsmaling og trompe-l'œil for å skape overbevisende scener. Arbeidet deres er basert på kunstnerisk visjon, skalamodeller, skisser og planer. De samarbeider tett med designerne."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/34e1c889-0fd1-4d1f-aba9-3b6263ae667a> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/874a2080-a9b6-46a9-8662-c9b7d4208f73> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3432.5" ;
    skos:prefLabel "scenograf"@nb ;
    skos:definition "Scenografer utvikler et scenekonsept for en forestilling og fører tilsyn med gjennomføringen av det. Arbeidet deres er basert på undersøkelser og kunstnerisk visjon. Designet deres er påvirket av og påvirker annen design, og må være i samsvar med disse designene og den overordnede kunstneriske visjonen. Derfor samarbeider designerne tett med kunstneriske ledere, operatører og det kunstneriske teamet. Under prøver og forestillinger veileder de operatørene for å oppnå optimal timing og manipulering. Scenografer utvikler skisser, designtegninger, modeller, planer eller annen dokumentasjon for å støtte verkstedet og forestillingspersonalet. De kan også designe stands til messer og andre arrangementer."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C3432> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/35eb0aa6-b40d-449d-9390-719be8912277> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3432.6" ;
    skos:prefLabel "butikkdekoratør"@nb ;
    skos:definition "Butikkdekoratører er spesialiserte innen markedsføring av varesalg, spesielt presentasjon av disse på utsalgssteder."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C3432> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/6040c941-ab83-44b2-84e7-5cbfa1eafcdc> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3433.1" ;
    skos:prefLabel "kunsthåndterer"@nb ;
    skos:definition "Kunsthåndterere er faglærte personer som jobber direkte med gjenstander i museer og kunstgallerier. De samarbeider blant annet med utstillingsregistratorer, samlingsansvarlige, konservatorer, restauratører og kuratorer, for å sikre at gjenstander håndteres og ivaretas på en trygg og forsvarlig måte. De har ofte ansvar for å pakke inn og ut kunst, montere og demontere kunst i utstillinger, og flytte kunst rundt på museet og lagringsplasser."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C3433> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/4e4a1aa1-ca53-406e-9ca6-889d4621a0ed> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3433.2" ;
    skos:prefLabel "bibliotekar, stort dataarkiv"@nb ;
    skos:definition "Bibliotekarer for store dataarkiver klassifiserer, katalogiserer og vedlikeholder biblioteker av digitale medier. De evaluerer og overholder også metadatastandarder for digitalt innhold og oppdaterer foreldede data og eldre systemer."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C3433> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/a78d8e2b-fe31-447f-8694-38ed7198d143> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3433.3" ;
    skos:prefLabel "taksidermist"@nb ;
    skos:definition "Taksidermister monterer og reproduserer avdøde dyr eller deler av dyr, som trofehoder, for offentlig visning og utdanning, for eksempel i et museum eller et monument, eller for andre kilder til vitenskapelig undersøkelse eller for en privat samling."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C3433> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/9729c0f3-c9bc-482e-ac59-a82ec3b67ba3> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3511.1" ;
    skos:prefLabel "datasenteroperatør"@nb ;
    skos:definition "Datasenteroperatører opprettholder driften av datamaskiner i datasenteret. De administrerer daglige aktiviteter i senteret for å løse problemer, opprettholde systemtilgjengeligheten og evaluere systemets ytelse."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C3511> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/aaeec9a7-dc57-4485-890c-86b3eef735f9> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3512.1" ;
    skos:prefLabel "IKT-brukerstøttemedarbeider"@nb ;
    skos:definition "IKT-brukerstøttemedarbeider gir teknisk hjelp til databrukere, svarer på spørsmål eller løser dataproblemer for klienter via telefon eller elektronisk. De gir hjelp til bruk av maskinvare og programvare for datamaskiner."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C3512> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/1242d99a-47f1-4a62-b884-33746db8a6ca> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3512.2" ;
    skos:prefLabel "sjef for IKT-brukerstøtte"@nb ;
    skos:definition "Sjef for IKT-brukerstøtte fører oppsyn med leveringen av tekniske støttetjenester til klienter i henhold til de forhåndsdefinerte fristene. De planlegger og organiserer brukerstøttehandlinger og feilsøker IKT-problemer og uregelmessigheter. Sjefer for IKT-brukerstøtte fører tilsyn med brukerstøtteteamet og sikrer at kundene får riktig tilbakemelding og støtte. De deltar også i utviklingen av retningslinjer for kundeservice og styrking av teamet."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C3512> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/a44a1dc5-be08-4840-8bd5-770c4ac1ca6d> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3512.3" ;
    skos:prefLabel "IKT-sikkerhetstekniker"@nb ;
    skos:definition "IKT-sikkerhetsteknikere foreslår og implementerer nødvendige sikkerhetsoppdateringer og tiltak når det er nødvendig. De gir råd, støtte, informasjon, opplæring og sikkerhetsbevissthet."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C3512> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/3e7bf729-4442-4b9f-ad5e-83111963795c> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3512.4" ;
    skos:prefLabel "IKT-tekniker"@nb ;
    skos:definition "IKT-teknikere installerer, vedlikeholder, reparerer og drifter informasjonssystemer og alt IKT-relatert utstyr (bærbare datamaskiner, stasjonære datamaskiner, servere, nettbrett, smarttelefoner, kommunikasjonsutstyr, skrivere og alle eksterne nettverk knyttet til datamaskiner), og alle typer programvare (drivere, operativsystemer, programmer, apper)."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C3512> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/dc8ef7da-d2c0-4474-96a0-6d0385eeec1e> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3514.1" ;
    skos:prefLabel "webmaster"@nb ;
    skos:definition "Webmastere distribuerer, vedlikeholder, overvåker og støtter en webserver slik at kravene til tjenesten oppfylles. De sikrer optimal systemintegritet, sikkerhet, sikkerhetskopiering og ytelse. De koordinerer innholdet, kvaliteten og stilen til nettsteder, gjennomfører nettstedsstrategien og oppdaterer og legger til nye funksjoner på nettsteder."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C3514> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/7642cbcc-9839-47fb-b2cf-d4bb831d6c93> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3521.1" ;
    skos:prefLabel "audiovisuell tekniker"@nb ;
    skos:definition "Audiovisuelle teknikere monterer, betjener og vedlikeholder utstyr for å spille inn og redigere bilder og lyd for radio- og TV-sendinger på livearrangementer og for telekommunikasjonssignaler."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C3521> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/2cbb23b0-0bf1-4871-9e6d-18f005987310> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3521.1.1" ;
    skos:prefLabel "lydtekniker"@nb ;
    skos:definition "Lydteknikere monterer, klargjør, kontrollerer og vedlikeholder utstyr for å gi optimal lydkvalitet for en liveopptreden. De samarbeider med turnemannskapet for å losse, montere og betjene lydutstyr og instrumenter."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/7642cbcc-9839-47fb-b2cf-d4bb831d6c93> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/36095ccd-c62d-4f1f-8af7-1fd10618b044> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3521.1.10" ;
    skos:prefLabel "lydredigerer"@nb ;
    skos:definition "Lydredigerere lager lydsporet og lydeffektene for filmer, TV-serier eller andre multimedieproduksjoner. De er ansvarlige for all musikken og lyden som brukes i filmen, seriene eller videospillene. Lydredigerer bruker utstyr for å redigere og mikse bilde- og lydopptak og sørge for at musikken, lyden og dialogen synkroniseres med og passer inn i scenen. De samarbeider tett med video- og filmregissøren."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/7642cbcc-9839-47fb-b2cf-d4bb831d6c93> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/0da2ee5c-b480-498f-97a8-a292a0f4c54c> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3521.1.11" ;
    skos:prefLabel "lydoperatør"@nb ;
    skos:definition "Lydoperatører styrer lyden under en forestilling basert på det kunstneriske eller kreative konseptet, i samspill med utøverne. Arbeidet deres er påvirket av og påvirker resultatene for andre operatører. Derfor samarbeider operatørene tett med designerne og utøverne. De klargjør lydfragmenter, fører tilsyn med monteringen, styrer det tekniske mannskapet, programmerer utstyret og håndterer lydsystemet. Arbeidet deres er basert på planer, instruksjoner og annen dokumentasjon."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/7642cbcc-9839-47fb-b2cf-d4bb831d6c93> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/061f56c6-36eb-4aa7-b5ef-98b7a569da1c> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3521.1.12" ;
    skos:prefLabel "videooperatør"@nb ;
    skos:definition "Videooperatører styrer bildene (projisert) under en forestilling basert på det kunstneriske eller kreative konseptet, i samspill med utøverne. Arbeidet deres er påvirket av og påvirker resultatene for andre operatører. Derfor samarbeider de tett med designerne, operatørene og utøverne. Videooperatører klargjør mediefragmenter, fører tilsyn med monteringen, styrer det tekniske mannskapet, programmerer utstyret og håndterer videosystemet. Arbeidet deres er basert på planer, instruksjoner og annen dokumentasjon."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/7642cbcc-9839-47fb-b2cf-d4bb831d6c93> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/a59feab2-9bc9-4b25-97cf-995998164502> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3521.1.13" ;
    skos:prefLabel "videotekniker"@nb ;
    skos:definition "Videoteknikere monterer, klargjør, kontrollerer og vedlikeholder utstyr for å gi optimal projisert bildekvalitet for en liveopptreden. De samarbeider med turnemannskapet for å losse, montere og betjene bildeutstyr og instrumenter."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/7642cbcc-9839-47fb-b2cf-d4bb831d6c93> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/4d102082-8d43-4c59-81ab-08a7509f3c40> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3521.1.2" ;
    skos:prefLabel "mikrofonbomoperatør"@nb ;
    skos:definition "Mikrofonbomoperatører monterer og betjener bommikrofonen, enten for hånd, på en arm eller på en bevegelig plattform. De sørger for at alle mikrofoner er riktig plassert på settet og er i den beste posisjonen for å registrere dialogene. Mikrofonbomoperatører er også ansvarlige for mikrofonene på skuespillernes klær."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/7642cbcc-9839-47fb-b2cf-d4bb831d6c93> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/6fed206a-ac4d-492b-a81a-5a3a0f2b67bc> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3521.1.3" ;
    skos:prefLabel "kamerafører"@nb ;
    skos:definition "Kamerafører monterer og betjener digitale filmkameraer for innspilling av film eller TV-programmer i hjemmet. De samarbeider med video- og filmregissøren, fotoregissøren eller den private klienten. Kameraførere gir råd om hvordan scenen skal spilles inn, til skuespillere, video- og filmregissøren og andre kameraførere."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/7642cbcc-9839-47fb-b2cf-d4bb831d6c93> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/239707a0-4754-4f4b-80b6-6b1ef5657aed> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3521.1.4" ;
    skos:prefLabel "masteringtekniker"@nb ;
    skos:definition "Masteringteknikere konverterer ferdige innspillinger til ønsket format, for eksempel CD, vinyl og digital. De sikrer kvaliteten på lyden for alle formater."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/7642cbcc-9839-47fb-b2cf-d4bb831d6c93> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/47e4135b-95d1-4462-920c-afcbd7c4d9be> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3521.1.5" ;
    skos:prefLabel "tekniker, arrangement"@nb ;
    skos:definition "Teknikere for arrangementer administrerer teknisk utstyr på konserter og andre store begivenheter."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/7642cbcc-9839-47fb-b2cf-d4bb831d6c93> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/dce6a68c-8a05-4c26-85d4-6fbc43e7d822> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3521.1.6" ;
    skos:prefLabel "kinomaskinist"@nb ;
    skos:definition "Kinomaskinister betjener og vedlikeholder visningsutstyr i kinosaler. De undersøker filmene før de laster dem inn i projektoren. Kinomaskinisten sørger for at alt går greit under visningen av filmen. De er også ansvarlige for forsvarlig oppbevaring av filmene."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/7642cbcc-9839-47fb-b2cf-d4bb831d6c93> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/aa50ae49-1e40-4ba9-959f-22a11ff172b4> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3521.1.7" ;
    skos:prefLabel "lydmikser"@nb ;
    skos:definition "Lydmiksere betjener og vedlikeholder mikrofoner og hodesett i innspillingsrom i innspillingsstudioer. De betjener miksebord. Lydmiksere håndterer alle krav til lydproduksjon. De gir råd til sangere om bruken av stemmen sin. Lydmiksere redigerer innspillinger til et ferdig produkt."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/7642cbcc-9839-47fb-b2cf-d4bb831d6c93> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/ce8145f5-d7ea-40ea-b12e-ef168f11184a> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3521.1.8" ;
    skos:prefLabel "lydkunstner"@nb ;
    skos:definition "Lydkunstnere bruker lyd som sitt viktigste kreative medium. De uttrykker sin intensjon og identitet gjennom å skape lyder. Lydkunst er tverrfaglig og sammensatt."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/7642cbcc-9839-47fb-b2cf-d4bb831d6c93> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/790c8dca-f624-4bdc-ac16-27bc13ead188> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3521.1.9" ;
    skos:prefLabel "lyddesigner"@nb ;
    skos:definition "Lyddesignere utvikler et lyddesign for en forestilling og fører tilsyn med gjennomføringen av det. Arbeidet deres er basert på undersøkelser og kunstnerisk visjon. Designet deres er påvirket av og påvirker annet design, og må være i samsvar med disse designene og den overordnede kunstneriske visjonen. Derfor samarbeider designerne tett med kunstneriske ledere, operatører og det kunstneriske teamet. Lyddesignere klargjør lydfragmenter som skal brukes i en forestilling, som kan innebære innspilling, komponering, manipulering og redigering. Under prøver og forestillinger veileder de operatørene for å oppnå optimal timing og manipulering. Lyddesignere utvikler planer, cuelister og annen dokumentasjon for å støtte operatørene og produksjonspersonalet. Lyddesignere jobber noen ganger også som selvstendige kunstnere, og skaper lydkunst utenfor en forestillingssammenheng."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/7642cbcc-9839-47fb-b2cf-d4bb831d6c93> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/fe4a72af-6206-4d86-90c1-b5fb4b5ba2b2> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "3521.2" ;
    skos:prefLabel "kringkastingstekniker"@nb ;
    skos:definition "Kringkastingsteknikere monterer, starter, vedlikeholder, overvåker og reparerer utstyr som brukes til overføring og mottak av signaler for TV- og radiosendinger. De sikrer at alt materiale er tilgjengelig i et passende format med overførbar kvalitet i henhold til tidsfristen for overføringen. Kringkastingsteknikere vedlikeholder og reparerer også dette utstyret."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C3521> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/6c999fc7-c6b7-4ef3-a4b9-af124a1783a2> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "4110.1" ;
    skos:prefLabel "kontormedarbeider"@nb ;
    skos:definition "Kontormedarbeidere er ansvarlig for å utføre sekretæroppgaver og administrative oppgaver på et kontor og støtte forretningsdrift i en avdeling. De hjelper administrativt personale, sekretærer og assistenter ved å sortere post, arkivere skjemaer og dokumenter, svare på telefoner, hilse på klienter, planlegge møter og servere drikke."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C4110> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/9581c837-fee7-4068-9618-1116fd93d723> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "4110.1.1" ;
    skos:prefLabel "ingeniørassistent"@nb ;
    skos:definition "Ingeniørassistenter sikrer administrasjon og overvåking av tekniske og tekniske dokumenter for prosjekter, oppgaver og kvalitetssaker. De hjelper ingeniører med deres eksperimenter, deltar på befaringer og administrerer innsamling av informasjon."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/6c999fc7-c6b7-4ef3-a4b9-af124a1783a2> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/0a3c2d5b-e1f9-4200-9288-62bf3fed3310> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "4110.1.2" ;
    skos:prefLabel "medlemsadministrator"@nb ;
    skos:definition "Medlemskapsadministratorer sikrer en effektiv medlemsadministrasjon, -dokumentasjon og -kommunikasjon. De arbeider med salg av medlemskap, tar seg av henvendelser fra medlemmer og tar seg av fornyelser av medlemskap."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/6c999fc7-c6b7-4ef3-a4b9-af124a1783a2> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/7153a12d-85e0-4123-87e9-46bb1a2dc929> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "4221.1" ;
    skos:prefLabel "kundeveileder"@nb ;
    skos:definition "Kundeveiledere hjelper togpassasjerer før de går om bord. De sjekker inn passasjerer og utfører også kundeserviceoppgaver, som å reservere togbilletter og hjelpe passasjerer med å søke om refusjon etter en forsinkelse eller kansellering."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C4221> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/bdf2dd9d-6c92-46f4-a8e7-76c12302d3e7> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "4221.2" ;
    skos:prefLabel "billettselger"@nb ;
    skos:definition "Billettselgere tilbyr den første servicen til kundene, selger reisebilletter og tilpasser reservasjonstilbudet til kundenes spørsmål og behov."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C4221> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/9a99a5fe-875d-49b2-9b53-cc1b73be1659> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "4221.2.1" ;
    skos:prefLabel "salgsmedarbeider på togstasjon"@nb ;
    skos:definition "Salgsmedarbeidere på togstasjon yter service til kunder som besøker billettluken. De gir informasjon og håndterer billettreservasjoner, salg og refusjon. De utfører også kontoroppgaver som føring av regnskap over det daglige billettsalget. De håndterer forespørsler om setereservasjoner og undersøker oversikter over vognene i toget for å bekrefte ledig plass på det spesifiserte toget."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/bdf2dd9d-6c92-46f4-a8e7-76c12302d3e7> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/9b35eab1-2adc-4057-a620-181862656a19> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "4221.3" ;
    skos:prefLabel "medarbeider på turistkontor"@nb ;
    skos:definition "Medarbeidere på turistkontor gir informasjon og råd til reisende om lokale attraksjoner, arrangementer, reiser og overnatting."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C4221> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/b5d76ddd-f59a-491a-9543-f6c0e2d8a950> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "4221.4" ;
    skos:prefLabel "turoperatørrepresentant"@nb ;
    skos:definition "Turoperatørrepresentanter opptrer på vegne av turoperatøren for å gi praktisk informasjon, gi hjelp, håndtere tjenester og selge utflukter til turister når de oppholder seg på reisemålet."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C4221> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/5b9a678a-7c35-4c50-a804-754b82652ee6> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "4221.5" ;
    skos:prefLabel "turarrangør"@nb ;
    skos:definition "Turarrangører har ansvar for å administrere og overvåke reiseruten for turistreiser og gi praktisk informasjon til turister."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C4221> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/79f8f68c-5509-4119-9373-8bef1c364d31> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "4221.6" ;
    skos:prefLabel "reisebyråmedarbeider"@nb ;
    skos:definition "Reisebyråmedarbeidere designer og markedsfører reiseruter for potensielle reisende eller besøkende."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C4221> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/291da1ab-1f90-426d-bbc5-60d0fa7d608b> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "4221.7" ;
    skos:prefLabel "reisekonsulent"@nb ;
    skos:definition "Reisekonsulenter tilbyr tilpasset informasjon og rådgivning om reisetilbud, foretar reservasjoner og selger reisetjenester sammen med andre tilknyttede tjenester."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C4221> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/82025c02-9082-416c-998b-f51eb0359ee6> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "4224.1" ;
    skos:prefLabel "resepsjonist på overnattingssted"@nb ;
    skos:definition "Resepsjonister på overnattingssted er første kontaktpunkt og hjelper gjestene på et overnattingssted. De er også ansvarlige for å ta imot bestillinger, behandle betalinger og gi informasjon."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C4224> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/92b7776f-5d90-413d-b05f-51e429e28346> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "4224.1.1" ;
    skos:prefLabel "campingplassmedarbeider"@nb ;
    skos:definition "Campingplassmedarbeidere er ansvarlig for kundebehandling på campingplassanlegg og andre driftsoppgaver."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/82025c02-9082-416c-998b-f51eb0359ee6> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/d7a9f9e0-e2f5-4804-a0e0-b21ebb1403ee> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "4321.1" ;
    skos:prefLabel "lagerkoordinator"@nb ;
    skos:definition "Lagerkoordinatorer holder oversikt over produkter som er lagret på lageret, for transport til butikker, grossister og enkeltkunder. De inspiserer varelageret og vedlikeholder papirer og dokumenter."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C4321> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/143e49fc-832f-477c-8cac-8eabe6fd7bc2> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "4321.1.1" ;
    skos:prefLabel "lagerarbeider, skofabrikk"@nb ;
    skos:definition "Lagerarbeidere, skofabrikk har ansvar for lagring av rå- og hjelpematerialer, arbeidsutstyr og komponenter til fottøyproduksjon. De sikrer at alle komponentene som er nødvendige for fottøyproduksjon, er klare til bruk i produksjonskjeden ved å klassifisere og registrere den kjøpte komponenten, utarbeide kjøpsprognoser og distribuere dem på tvers av forskjellige avdelinger."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/d7a9f9e0-e2f5-4804-a0e0-b21ebb1403ee> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/31db6bd9-ee84-4a57-ac9e-87e243ba1c69> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "4321.1.2" ;
    skos:prefLabel "lagerarbeider, lærvarer"@nb ;
    skos:definition "Lagerarbeidere, lærvarer har ansvaret for lageret av lær, komponenter, andre materialer og produksjonsutstyr. De klassifiserer og registrerer kjøpte råvarer og komponenter, utarbeider kjøpsprognoser og distribuerer dem på tvers av forskjellige avdelinger. De sikrer at alle nødvendige råvarer og komponenter for produksjonen er klare til å brukes og plasseres i produksjonskjeden."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/d7a9f9e0-e2f5-4804-a0e0-b21ebb1403ee> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/f84dbfe2-fa6b-43ef-97f5-54c3ad9c631f> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "4321.1.3" ;
    skos:prefLabel "råvaremottaksoperatør"@nb ;
    skos:definition "Råvaremottaksoperatører betjener og vedlikeholder verktøy og utstyr for å sikre at kvalitative og kvantitative krav til mottak av råvaren blir oppfylt. De bruker utstyr for å evaluere produkter som korn, poteter, kassavarot og så videre. De lagrer og distribuerer produkter til de forskjellige prosesseringsenhetene i fabrikken."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/d7a9f9e0-e2f5-4804-a0e0-b21ebb1403ee> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/30870ea4-5e8e-4b92-a9d5-65e3b97a9b30> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "4321.1.4" ;
    skos:prefLabel "lagersjef, råvarer"@nb ;
    skos:definition "Lagersjefer, råvarer organiserer og overvåker mottak og lagring av råvarer på lageret i henhold til de nødvendige forhold. De overvåker lagernivåene."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/d7a9f9e0-e2f5-4804-a0e0-b21ebb1403ee> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/040fcfa5-24be-43eb-afd5-828297175b16> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "4321.1.5" ;
    skos:prefLabel "lageroperatør, klær"@nb ;
    skos:definition "Lageroperatører, klær har ansvar for lagring av tekstilstoffer, tilbehør og komponenter til klesproduksjon. De sikrer at alle komponentene som er nødvendige for klesproduksjon, er klare til bruk i produksjonskjeden ved å klassifisere og registrere den kjøpte komponenten, utarbeide kjøpsprognoser og distribuere dem på tvers av forskjellige avdelinger."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/d7a9f9e0-e2f5-4804-a0e0-b21ebb1403ee> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/90f75f67-495d-49fa-ab57-2f320e251d7e> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5120.1" ;
    skos:prefLabel "kokk"@nb ;
    skos:definition "Kokker er matarbeidere som kan tilberede og presentere mat, vanligvis i hjemlige og institusjonelle miljøer."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C5120> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/9ab80ce6-504f-474f-bb91-98163e9d45fd> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5120.1.1" ;
    skos:prefLabel "kostholdskokk"@nb ;
    skos:definition "Kostholdskokker tilbereder og presenterer måltider i henhold til spesielle kostholds- eller ernæringsbehov."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/90f75f67-495d-49fa-ab57-2f320e251d7e> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/b9de6d8b-1cf6-4722-bf8c-d73aad03bf87> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5120.1.2" ;
    skos:prefLabel "fiskekokk"@nb ;
    skos:definition "Fiskekokker er ansvarlige for å tilberede og presentere fiskeretter ved hjelp av en rekke ulike teknikker. De kan også tilberede de medfølgende sausene og kjøpe fersk fisk til disse rettene."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/90f75f67-495d-49fa-ab57-2f320e251d7e> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/bbaa1444-2c0a-4f76-8375-d72e3ea968fd> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5120.1.3" ;
    skos:prefLabel "grillkokk"@nb ;
    skos:definition "Grillkokker tilbereder og presenterer kjøtt, grønnsaker og fisk ved hjelp av grillutstyr, som griller og rotisserier."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/90f75f67-495d-49fa-ab57-2f320e251d7e> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/11e6d39e-1295-40e7-8eea-3eb042bc7e34> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5120.1.4" ;
    skos:prefLabel "industrikokk"@nb ;
    skos:definition "Industrikokker lager nye matdesigner og oppskrifter. De tilbereder, måler og blander ingredienser for å tilberede matvarer. De kontrollerer og justerer temperaturer, overvåker tilberedningsprosessen, tildeler spesifikke bakeoppgaver og leder arbeidere i oppgaveutførelsen."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/90f75f67-495d-49fa-ab57-2f320e251d7e> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/a1b86a8b-ad91-4192-b386-bbf89bb11699> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5131.1" ;
    skos:prefLabel "restaurantvert"@nb ;
    skos:definition "Restaurantverter tar imot kunder på serveringssteder og yter den første servicen."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C5131> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/d5db9d5c-2ebf-4a54-a79a-1b7e7ff70471> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5131.2" ;
    skos:prefLabel "servitør"@nb ;
    skos:definition "Servitører serverer gjestene mat og drikke etter ønske. Servitører jobber vanligvis på restauranter, barer og hoteller. Dette innebærer klargjøring av bord, servering av mat eller drikke og å ta imot betaling."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C5131> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/53ed8787-3423-4843-8c63-7be1877d29e2> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5131.2.1" ;
    skos:prefLabel "hovedkelner"@nb ;
    skos:definition "Hovedkelnere håndterer mat- og drikkeservicen på et serveringssted. De er ansvarlige for kundens opplevelse. Hovedkelnere koordinerer alle handlinger som omfatter kunder, for eksempel å ta imot gjester, ta imot bestillinger, servere mat og drikke og føre tilsyn med økonomiske transaksjoner."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/d5db9d5c-2ebf-4a54-a79a-1b7e7ff70471> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/499f80e3-860c-48ef-8286-be929a93e254> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5131.2.2" ;
    skos:prefLabel "sommelier"@nb ;
    skos:definition "Sommelierer lagrer, tilbereder, gir råd om og server vin og andre alkoholholdige drikker."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/d5db9d5c-2ebf-4a54-a79a-1b7e7ff70471> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/985400a7-362f-4f91-941a-2e149d94ac2a> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5131.2.2.1" ;
    skos:prefLabel "ølsommelier"@nb ;
    skos:definition "Ølsommelierer forstår og gir råd om stiler, brygging og beste sammensetning av øl og mat på steder som restauranter, bryggerier og butikker. De har kunnskap om ingrediensene, ølets historie, ølglass og ølsystemer. De forbereder ølsmakinger, konsulterer selskaper og kunder, evaluerer ølprodukter og skriver om dette emnet."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/499f80e3-860c-48ef-8286-be929a93e254> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/a20e4b15-a128-49b9-a06a-e790e3bd5c68> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5131.2.2.2" ;
    skos:prefLabel "sjefsommelier"@nb ;
    skos:definition "Sjefsommelierer administrerer bestilling, klargjøring og servering av vin og andre relaterte drikker på serveringssteder."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/499f80e3-860c-48ef-8286-be929a93e254> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/2d92f7f5-d2b1-4223-92c4-23c33f8604fc> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5131.2.2.3" ;
    skos:prefLabel "vinsommelier"@nb ;
    skos:definition "Vinsommelierer har generell kunnskap om vin, produksjon av vin, og valg og servering av vin. Med denne kunnskapen kan de lede spesialiserte vinkjellere, publisere vinlister og bøker eller arbeide i restauranter."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/499f80e3-860c-48ef-8286-be929a93e254> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/099c6bb0-22d3-4c5d-8bf5-70910af381ef> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5141.1" ;
    skos:prefLabel "frisør"@nb ;
    skos:definition "Frisører tilbyr skjønnhetstjenester som klipping, farging, bleking, permanentkrøller og styling av klientens hår. De spør kundene sine om frisyrepreferanser for å tilby tilpassede tjenester. Frisører bruker klippemaskiner, sakser og barberkniver. De gir hår- og hodebunnsbehandlinger, og bruker sjampo og balsam under hårvask."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C5141> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/4e0c14d6-b170-40f1-bcdc-703c0b92109b> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5141.1.1" ;
    skos:prefLabel "barberer"@nb ;
    skos:definition "Barberere klipper, trimmer og styler menns hår. De fjerner også ansiktshår ved å barbere det spesifikke området. Barberer bruker verktøy som saks, klippemaskiner, barberkniver og kammer. De kan tilby tilleggstjenester som sjamponering, styling, farging og hodebunnsmassasje."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/099c6bb0-22d3-4c5d-8bf5-70910af381ef> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/55f6380c-7511-4c33-8fc4-c74f10f524fa> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5141.1.2" ;
    skos:prefLabel "frisørassistent"@nb ;
    skos:definition "Frisørassistenter skyller håret til klienter og påfører hårbalsam og fargerbehandling i skjønnhetssalonger. De påfører sjampo, gnir hodebunnen og skyller håret. De kan også utføre hodebunnsbehandling, bleking, farging og massering for sine klienter. Frisørassistenter bruker spesielle kremer, sjampoer, balsamer og annet hårpleieutstyr, i henhold til kundens behov og preferanser."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/099c6bb0-22d3-4c5d-8bf5-70910af381ef> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/82dea303-26e1-4bbc-a07c-cff3cac6b50e> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5141.1.3" ;
    skos:prefLabel "hårstylist"@nb ;
    skos:definition "Hårstylister vasker, tørker, klipper og styler håret til sangere, programledere og forskjellige typer skuespillere, inkludert teater-, film-, TV- og musikkvideoskuespillere. De samarbeider med art director for å designe utseendet til alle personer. Hårstylister klargjør også parykker og hårdeler. De er i beredskap under disse kunstneriske aktivitetene for å justere skuespillernes hår eller parykker."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/099c6bb0-22d3-4c5d-8bf5-70910af381ef> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/f60dc59b-7681-45d4-8114-b3a646e02ab2> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5141.1.4" ;
    skos:prefLabel "teaterfrisør"@nb ;
    skos:definition "Teaterfrisører støtter kunstnere før, under og etter forestillingen for å sikre at skuespillernes hår er i tråd med den kunstneriske visjonen til regissøren og det kunstneriske teamet. De vedlikeholder, kontrollerer og reparerer parykker og hjelper til med raske skifter."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/099c6bb0-22d3-4c5d-8bf5-70910af381ef> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/a1e1a788-2352-4172-8fcf-1f985a6968b0> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5142.1" ;
    skos:prefLabel "kosmetolog"@nb ;
    skos:definition "Kosmetologer tilbyr hudpleiebehandling. De påfører forskjellige ansiktsbehandlinger i henhold til kundenes behov og hudtype, for eksempel kremer, skrubber, peelinger og masker, for å holde huden sunn og attraktiv. Kosmetologer kan også gi nakkemassasje og kroppsbehandlinger, for eksempel omslag. Kosmetologer fjerner uønsket hår på forskjellige kroppsdeler, for eksempel øyenbryn, overleppe eller bikiniområdet. De utfører ansiktsmassasje og påfører sminke for forskjellige anledninger."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C5142> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/2d5a50c6-0bf4-45c3-805c-44d1bf1e3d12> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5142.10" ;
    skos:prefLabel "spamedarbeider"@nb ;
    skos:definition "Spamedarbeidere samhandler med gjester i resepsjonen for å gi veiledning og forklare de tilgjengelige tjenestene i spasenteret. De har også ansvaret for rengjøring av sparommene etter bruk, renholdet i oppbevaringsområdet og påfylling av rene håndklær. Spamedarbeidere fører tilsyn med sikkerheten på anlegget og er ansvarlige for å selge produktene og tjenestene som er tilgjengelige, for eksempel behandlingspakker."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C5142> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/be375e11-9a70-47cb-8091-711c94ed0c13> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5142.11" ;
    skos:prefLabel "solstudiovert"@nb ;
    skos:definition "Solstudioverter betjener kunder ved et solstudio. De tilbyr råd om kjøp og behandlinger i solarier og solstudioer."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C5142> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/763f82c2-81e3-48d2-9cdf-f532b5016a1f> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5142.12" ;
    skos:prefLabel "slankekonsulent"@nb ;
    skos:definition "Slankekonsulenter hjelper klienter med å få og opprettholde en sunn livsstil. De gir råd om hvordan man kan gå ned i vekt ved å finne en balanse mellom sunn mat og aktivitet. Slankekonsulenter setter mål sammen med sine klienter og holder oversikt over fremgangen under ukentlige møter."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C5142> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/d3fd0898-51f7-42a3-8f44-09408fc796f6> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5142.2" ;
    skos:prefLabel "medarbeider i skjønnhetssalong"@nb ;
    skos:definition "Medarbeidere i skjønnhetssalong planlegger kundenes avtaler, tar imot kunder i lokalene, gir detaljert informasjon om salongens tjenester og behandlinger og tar imot kundenes klager. De rengjør salongen regelmessig og sørger for at alle produktene er på lager og oppbevares riktig. Medarbeidere i skjønnhetssalong tar imot betaling fra kunder og kan selge forskjellige skjønnhetsprodukter."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C5142> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/72413d91-f212-4ad6-bf95-8b78a37c041a> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5142.3" ;
    skos:prefLabel "hårfjerningsspesialist"@nb ;
    skos:definition "Hårfjerningsspesialister utfører kosmetisk fjerning av uønsket hår på ulike deler av kroppen. De kan bruke forskjellige teknikker for midlertidig hårfjerning, for eksempel epilering- og depileringsteknikker, eller metoder for permanent hårfjerning, som elektrolyse eller IPL (Intense Pulsed Light)."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C5142> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/5dd01019-3999-4d90-bc8a-7a04b0b208b0> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5142.4" ;
    skos:prefLabel "sminke- og hårdesigner"@nb ;
    skos:definition "Sminke- og hårdesignere utvikler et designkonsept for sminke og hår til dem som skal opptre, og fører tilsyn med utførelsen av dette konseptet. Arbeidet deres er basert på undersøkelser og kunstnerisk visjon. Designet deres er påvirket av og påvirker annen design, og må være i samsvar med disse designene og den overordnede kunstneriske visjonen. Derfor samarbeider designerne tett med kunstneriske ledere, operatører og det kunstneriske teamet. Sminke- og hårdesignere utvikler skisser, designtegninger eller annen dokumentasjon for å støtte verkstedet og forestillingspersonalet. Sminkedesignere jobber noen ganger også som selvstendige kunstnere, og skaper sminkekunst utenfor en film-, tv- eller teaterkontekst."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C5142> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/49713da4-4e97-4f82-bd1c-16ce7f9179b7> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5142.5" ;
    skos:prefLabel "sminkør"@nb ;
    skos:definition "Sminkører hjelper og støtter kunstnere før, under og etter opptak av filmer eller TV-programmer for å sikre at sminken er i tråd med den kunstneriske visjonen til regissøren og det kunstneriske teamet. De skaper bilder og karakterer gjennom sminke og proteser. De vedlikeholder, kontrollerer og reparerer proteser og hjelper til med raske skifter."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C5142> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/bced9b86-d4e7-42f8-bb47-acb2001b9bd0> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5142.6" ;
    skos:prefLabel "manikyrist"@nb ;
    skos:definition "Manikyrister gir neglebehandling. De rengjør, klipper og former neglene, fjerner neglebånd og påfører neglelakk. Manikyrister setter på kunstige negler og andre dekorative ting på negler. De gir råd om negle- og håndpleie og selger spesialprodukter."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C5142> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/1978c6ff-37b4-48f1-9aa6-88b9c568f74f> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5142.7" ;
    skos:prefLabel "massør"@nb ;
    skos:definition "Massører utfører massasje for å hjelpe sine klienter å slappe av og stresse ned, avhengig av deres preferanser. De bruker passende massasjer, utstyr og oljer, og instruerer også kundene sine om teknikker for slappe mer av."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C5142> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/489b9a38-89a2-425c-95b9-79cec66379e1> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5142.8" ;
    skos:prefLabel "fotpleier"@nb ;
    skos:definition "Fotpleiere tilbyr kosmetisk behandling og håndtering av kundenes føtter og tånegler. De klipper og former tånegler, gir fotbad og peelingbehandling og påfører neglelakk."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C5142> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/d5ce0c23-6f8a-459f-9bf9-a7cb9768740a> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5142.9" ;
    skos:prefLabel "personlig stylist"@nb ;
    skos:definition "Personlige stylister hjelper sine kunder med motevalg. De gir råd om de nyeste motetrendene innen klær, smykker og tilbehør, og hjelper kundene sine med å velge riktig antrekk, avhengig av type sosial begivenhet, deres smak og kroppstyper. Personlige stylister lærer kundene sine hvordan de skal ta beslutninger angående generelt utseende og image."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C5142> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/1822bfc2-e735-449f-ba00-ca71eb5c062b> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5153.1" ;
    skos:prefLabel "vaktmester"@nb ;
    skos:definition "Vaktmestre vedlikeholder bygninger og overvåker tilstanden og sikkerheten til bygninger. De rengjør, hjelper til med mindre reparasjoner og sørger for at beboerne har tilgang til fasiliteter som oppvarming og varmt vann. Vaktmestre er ansvarlige for kvaliteten på bygningene og fungerer også som en kontaktperson for beboerne."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C5153> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/38eb308f-0075-451e-9c1a-c557fd173022> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5153.1.1" ;
    skos:prefLabel "rengjøringsassistent i fornøyelsespark"@nb ;
    skos:definition "Rengjøringsassistenter i fornøyelsespark jobber for å holde fornøyelsesparken ren og utfører små reparasjoner. Rengjøringsassistenter i fornøyelsespark jobber vanligvis om natten, når parken er stengt, men vedlikehold og rengjøring som haster, utføres på dagtid."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/1822bfc2-e735-449f-ba00-ca71eb5c062b> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/96430121-2757-4e96-9d6f-7517b25db4f7> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5153.1.2" ;
    skos:prefLabel "husvakt"@nb ;
    skos:definition "Husvakter flytter inn i huset til arbeidsgiverne sine for å sørge for sikkerheten på eiendommen under fraværet. De overvåker inngangspartier og forhindrer at uvedkommende kommer inn i huset, kontrollerer tilstanden på anlegget, for eksempel rør og oppvarming, og kontakter reparatører om nødvendig. Husvakter kan også utføre enkel rengjøring, videresende post og betale regninger."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/1822bfc2-e735-449f-ba00-ca71eb5c062b> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/589efb6c-9080-40b2-ab6a-144955675967> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5153.1.3" ;
    skos:prefLabel "kirketjener"@nb ;
    skos:definition "Kirketjenere utfører administrative oppgaver for kirker og menigheter, sørger for vedlikehold av utstyr og støtter soknepresten eller andre overordnede. De utfører også hjelpeoppgaver før og etter gudstjenester, for eksempel å rydde, klargjøre utstyr og støtte presten."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/1822bfc2-e735-449f-ba00-ca71eb5c062b> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/0b14d5d7-1bbe-4403-b9e6-7b0f37fc44fc> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5164.1" ;
    skos:prefLabel "dyrepassere"@nb ;
    skos:definition "Dyrepassere utfører rutinemessig pleie av kjæledyr. Dette kan omfatte fôring, vanning, rengjøring, mosjon og lek, pleie, trening og overvåking av helse og velferd, i samsvar med nasjonal lovgivning."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C5164> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/5a940ae0-3fa4-40f9-8ca4-17bf792da243> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5164.1.1" ;
    skos:prefLabel "dyrepleier"@nb ;
    skos:definition "Dyrepleiere har ansvar for å pleie en rekke dyr ved å bruke riktig utstyr, materialer og metoder. Det omfatter bruk av passende og sikre håndteringsteknikker og å fremme av god hygiene, helse og velferd for dyret."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/0b14d5d7-1bbe-4403-b9e6-7b0f37fc44fc> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/15dfabf5-71e0-400e-af48-4c6f92ef4392> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5164.1.2" ;
    skos:prefLabel "kennelmedarbeider"@nb ;
    skos:definition "Kennelmedarbeidere håndterer dyr på dyrepensjonat eller -hotell og pleier kjæledyr. De mater dyrene, rengjør burene, passer på syke eller gamle dyr, pleier dem og tar dem ut på tur."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/0b14d5d7-1bbe-4403-b9e6-7b0f37fc44fc> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/f7066fc0-5f2f-43a9-bd35-a99e6119490d> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5164.1.3" ;
    skos:prefLabel "dyrepasser i dyrehage"@nb ;
    skos:definition "Dyrepassere i dyrehage forvalter dyr som holdes i fangenskap for verne-, utdannings-, forsknings- og/eller utstillingsformål. De er vanligvis ansvarlige for fôring og dyrenes daglige pleie og velferd. Som en del av rutinen rengjør dyrepassere utstillingene og rapporterer om mulige helseproblemer. De kan også være involvert i særlig vitenskapelig forskning eller offentlig utdanning, for eksempel gjennomføre omvisninger og svare på spørsmål."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/0b14d5d7-1bbe-4403-b9e6-7b0f37fc44fc> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/62204bd8-98b5-418f-b189-7333904cbde7> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5164.10" ;
    skos:prefLabel "områdeleder i dyrepark"@nb ;
    skos:definition "Områdeledere i dyrepark er ansvarlige for å administrere og lede et team av dyrepassere. De skal utføre daglig pleie og forvaltning av dyr, samt i samarbeid med kolleger, drive langsiktig forvaltning og organisering av artene og utstillinger i deres seksjon. De er også ansvarlige for ulike aspekter ved personaladministrasjon for dyrepasserne i sin seksjon. Avhengig av størrelsen på dyrehagen og dyreseksjonen kan de i tillegg ha ansvar for ansettelser og budsjettering."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C5164> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/1ee1b792-4d5f-4555-be4e-ce7e4c05d1a9> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5164.2" ;
    skos:prefLabel "dyrepasser"@nb ;
    skos:definition "Dyrepassere har ansvar for å håndtere dyr i en arbeidsrolle og fortsette opplæringen av dyret i samsvar med nasjonal lovgivning."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C5164> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/fc1da244-880f-407d-bfa7-789a2f468ea0> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5164.2.1" ;
    skos:prefLabel "dyretrener"@nb ;
    skos:definition "Dyretrenere trener dyre- og/eller dyrefører for generelle og spesifikke formål, inkludert assistanse, sikkerhet, fritid, konkurranse, transport, lydighet og håndtering av rutiner, underholdning og utdanning, i samsvar med nasjonal lovgivning."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/1ee1b792-4d5f-4555-be4e-ce7e4c05d1a9> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/2662ed6c-a705-4895-8e9d-0a85c08ad908> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5164.2.1.1" ;
    skos:prefLabel "hundetrener"@nb ;
    skos:definition "Hundetrenere trener dyre- og/eller hundefører for generelle og spesifikke formål, inkludert assistanse, sikkerhet, fritid, konkurranse, transport, lydighet og håndtering av rutiner, underholdning og utdanning, i samsvar med nasjonal lovgivning."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/fc1da244-880f-407d-bfa7-789a2f468ea0> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/65a9366c-d4d3-484d-a577-c63d335987da> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5164.2.1.1.1" ;
    skos:prefLabel "førerhundinstruktør"@nb ;
    skos:definition "Førerhundinstruktører trener hunder til å være ansvarlige for veilede blinde til å reise effektivt. De planlegger treningsøktene, finner riktige førerhunder til sine klienter og sørger for generell regelmessig pleie av treningshundene. Førerhundinstruktører gir også råd til blinde om bruk av teknikker som letter hundens reiseferdigheter og bevegelighet."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/2662ed6c-a705-4895-8e9d-0a85c08ad908> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/4ac3c3a0-eb56-491f-8d21-1e5539a05b54> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5164.2.1.2" ;
    skos:prefLabel "hestetrener"@nb ;
    skos:definition "Hestetrenere trener dyre- og/eller ryttere for generelle og spesifikke formål, inkludert assistanse, sikkerhet, fritid, konkurranse, transport, lydighet og håndtering av rutiner, underholdning og utdanning, i samsvar med nasjonal lovgivning."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/fc1da244-880f-407d-bfa7-789a2f468ea0> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/7ceb2340-339c-4367-bc4e-e08f57c992f6> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5164.3" ;
    skos:prefLabel "medarbeider på dyremottak"@nb ;
    skos:definition "Medarbeider på dyremottak leverer rutinemessige pleietjenester for dyr på dyremottak. De mottar dyr brakt til dyremottaket, svarer på henvendelser om bortkomne eller skadede dyr, pleier dyr, rengjør bur, håndterer papirer for adopsjon av dyr, transporterer dyr til veterinær og fører registreringer i en database over dyrene som finnes på dyremottaket."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C5164> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/2de007c6-3223-4cd1-9561-e8a2e16e049d> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5164.4" ;
    skos:prefLabel "inspektør, dyrevelferd"@nb ;
    skos:definition "Inspektører, dyrevelferd undersøker påståtte rapporter om dyremishandling eller omsorgssvikt, redder eller henter dyr i umiddelbar eller potensiell fare, samarbeider med interne og eksterne etater og andre dyrevelferdsinstitusjoner, utdanner og gir råd til eiere og pleiere av dyr, søker å forbedre eller opprettholde dyrevelferden, og forhindrer eller lindrer lidelse."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C5164> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/701f9161-72e4-4ff3-a9e8-8e6352664ef0> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5164.5" ;
    skos:prefLabel "klovpleier"@nb ;
    skos:definition "Klovpleiere er spesialister på å ta vare på klovene til storfe, i samsvar med eventuelle lovpålagte krav fra nasjonale juridiske myndigheter."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C5164> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/2b292d4d-1905-45ec-a7c0-1ca7b45a4162> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5164.6" ;
    skos:prefLabel "hundeoppdretter"@nb ;
    skos:definition "Hundeoppdrettere fører tilsyn med produksjon og daglig pleie av hunder. De sørger for hundenes helse og velferd."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C5164> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/a491c5c1-e126-4414-9ac9-3625a4a79513> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5164.7" ;
    skos:prefLabel "viltforvalter"@nb ;
    skos:definition "Viltforvaltere administrerer leveområder og viltpopulasjon i et definert område."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C5164> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/bc1748c7-29d6-43d5-a304-6b74f317ac26> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5164.8" ;
    skos:prefLabel "leder av kennel"@nb ;
    skos:definition "Ledere av kenneler fører tilsyn med den daglige driften av kennelen de har ansvar for. De sørger for at kjæledyrene som er plassert i kennelene, blir riktig håndtert og ivaretatt. Ledere av kenneler fører tilsyn med det arbeidende personalet og opprettholder kontakten med eierne av kjæledyrene når leverer eller henter kjæledyrene."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C5164> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/84cdc2ef-ee7c-42b1-be19-5e1c6b537f8f> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5164.9" ;
    skos:prefLabel "kjæledyrpasser"@nb ;
    skos:definition "Kjæledyrpassere tilbyr kjæledyrtjenester, inkludert lufting av hund, hjemmepensjon, dyre-/hjemmepassing, dagpassing og dyretransport. De fører journaler, bruker passende og trygge håndteringsteknikker og utfører rutinemessig kontroll av dyrets helse og velferd."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C5164> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/38395ab3-766c-4c6c-8d96-430eff19ec8d> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5223.1" ;
    skos:prefLabel "leasingmedarbeider, bil"@nb ;
    skos:definition "Leasingmedarbeidere, bil representerer virksomheter som er involvert i finansiering av kjøretøyer, og tilbyr egnede leasingordninger og tilleggstjenester knyttet til kjøretøyet. De dokumenterer transaksjoner, forsikringer og avdrag."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C5223> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/099a901f-91a7-4d26-af2e-f385247dcf20> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5223.2" ;
    skos:prefLabel "reservedelskonsulent"@nb ;
    skos:definition "Reservedelskonsulenter selger bildeler, bestiller deler og identifiserer alternative deler."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C5223> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/f8da6546-0c8a-4bd0-a952-6f3c253c9aba> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5223.3" ;
    skos:prefLabel "personlig shopper"@nb ;
    skos:definition "Personlige shoppere hjelper sine personlige kunder med å velge og kjøpe klær og andre varer, for eksempel gaver, i henhold til deres personlige smak, ønsker og stil."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C5223> ;
    dcterms:source <https://esco.ec.europa.eu> .

