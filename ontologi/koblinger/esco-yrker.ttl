<http://data.europa.eu/esco/occupation/2e9c9404-0d86-453c-9001-3a0cd1d1323b> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5223.7.4" ;
    skos:prefLabel "spesialisert selger, bakeri"@nb ;
    skos:definition "Spesialiserte selgere, bakeri selger brød og kaker i spesialbutikker og etterbehandler produktene om nødvendig."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/547b304b-9a72-4717-9b24-b7046df5f64e> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/63d99701-1a6c-4c57-87c8-4b0d5c0b4408> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5223.7.5" ;
    skos:prefLabel "spesialisert selger, drikkevarer"@nb ;
    skos:definition "Spesialiserte selgere, drikkevarer selger drikkevarer i spesialbutikker."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/547b304b-9a72-4717-9b24-b7046df5f64e> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/1246764a-ce7c-45e8-9675-e445d145e818> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5223.7.6" ;
    skos:prefLabel "spesialisert selger, bokhandler"@nb ;
    skos:definition "Spesialiserte selgere, bokhandler selger bøker i spesialbutikker. De gir også forslag og råd om tilgjengelige bøker og andre, tilknyttede produkter som selges i slike spesialbutikker."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/547b304b-9a72-4717-9b24-b7046df5f64e> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/71bac871-7594-4d86-a19f-592079bd8154> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5223.7.7" ;
    skos:prefLabel "spesialisert selger, byggematerialer"@nb ;
    skos:definition "Spesialiserte selgere, byggematerialer selger byggevarer i spesialbutikker."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/547b304b-9a72-4717-9b24-b7046df5f64e> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/13da27aa-ca6a-476d-ab2c-efc9e5bd97b2> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5223.7.8" ;
    skos:prefLabel "spesialisert selger, klær"@nb ;
    skos:definition "Spesialiserte selgere, klær selger klær i spesialbutikker."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/547b304b-9a72-4717-9b24-b7046df5f64e> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/4dc6e03f-bfb0-4078-a453-01bd1cb735aa> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5223.7.9" ;
    skos:prefLabel "spesialisert selger, datamaskiner og datatilbehør"@nb ;
    skos:definition "Spesialiserte selgere, datamaskiner og datatilbehør selger datamaskiner og datatilbehør i spesialbutikker."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/547b304b-9a72-4717-9b24-b7046df5f64e> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/3413f234-6230-47a8-8cc7-2691fd54ce3a> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5311.1" ;
    skos:prefLabel "barnepasser"@nb ;
    skos:definition "Barnepassere tar seg av barn når foreldrene eller familiemedlemmene ikke er tilgjengelige. De passer på barnas grunnleggende behov og hjelper eller fører tilsyn med dem under lek. Barnepassere kan jobbe for barnehager, barnehagesentre, barnepassorganisasjoner eller enkeltfamilier."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C5311> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/f219f643-4df1-4a9a-b6c5-dc2f48c22806> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5311.1.1" ;
    skos:prefLabel "au pair"@nb ;
    skos:definition "Au pairer bor og jobber hos en vertsfamilie i et annet land og har vanligvis ansvaret for å ta vare på familiens barn. De er unge personer som vil utforske en annen kultur mens de tilbyr barnepass og andre lette husholdningsaktiviteter, for eksempel rengjøring, hagearbeid og handling."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/3413f234-6230-47a8-8cc7-2691fd54ce3a> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/c4a81f47-6ed8-4a17-ab4a-21a2e67fa1d9> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5311.1.2" ;
    skos:prefLabel "barnevakt"@nb ;
    skos:definition "Barnevakter tilbyr omsorgstjenester i korte tidsperioder til barn i hos arbeidsgiveren, avhengig av arbeidsgivers behov. De organiserer lekeaktiviteter og underholder barn med spill og andre kulturelle og pedagogiske aktiviteter i henhold til deres respektive alder, tilbereder måltider, bader dem, transporterer dem fra og til skolen og hjelper dem med lekser til avtalte tider."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/3413f234-6230-47a8-8cc7-2691fd54ce3a> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/3f74aad8-2d60-4be2-b059-8dba5568d530> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5311.1.3" ;
    skos:prefLabel "barnepasser, dagtid"@nb ;
    skos:definition "Barnepassere, dagtid tilbyr sosiale tjenester til barn og deres familier for å forbedre deres sosiale og psykologiske funksjon. De har som mål å gi familien best mulig velvære ved å ta vare på barn på dagtid."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/3413f234-6230-47a8-8cc7-2691fd54ce3a> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/0a5356bc-7f81-4e40-971d-c1dc789c5fb4> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5311.1.4" ;
    skos:prefLabel "barnepike"@nb ;
    skos:definition "Barnepiker tilbyr kvalifiserte omsorgstjenester til barn i arbeidsgiverens lokaler. De organiserer lekeaktiviteter og underholder barn med spill og andre kulturelle og pedagogiske aktiviteter i henhold til deres respektive alder, tilbereder måltider, bader dem, transporterer dem fra og til skolen og hjelper dem med lekser til avtalte tider."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/3413f234-6230-47a8-8cc7-2691fd54ce3a> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/78eacaf8-06d6-4b78-920f-edece2e41464> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5311.2" ;
    skos:prefLabel "skolebussassistent"@nb ;
    skos:definition "Skolebussassistenter overvåker aktivitetene på skolebusser for å sikre og overvåke elevenes sikkerhet og gode oppførsel. De hjelper barn av og på bussen, støtter sjåføren og gir hjelp i nødstilfeller."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C5311> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/d38c2107-98f2-47b7-8bb4-f69750d51082> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5321.1" ;
    skos:prefLabel "hjelpepleier"@nb ;
    skos:definition "Hjelpepleiere samarbeider i et team med registrerte sykepleiere innen yrkesområdene sykepleie, pleie og omsorg for mennesker i alle aldersgrupper i alle forskjellige akutte omsorgssituasjoner og i primæromsorgsmiljøer."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C5321> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/87d0795a-d41f-47ee-979f-0ab7d73836e7> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5321.1.1" ;
    skos:prefLabel "pleiemedhjelper"@nb ;
    skos:definition "Pleiemedhjelpere jobber i team med sykepleiere innen yrkesområdene sykepleie, sosialomsorg, klinisk pleie og omsorg for mennesker i alle aldersgrupper. Pleiemedhjelpere hjelper til med å fremme og restituere pasientenes helse ved å gi fysisk og psykologisk støtte til pasienter, venner og familier."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/d38c2107-98f2-47b7-8bb4-f69750d51082> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/a30734bb-2f10-4747-a94c-75f5ec3c63a4> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5329.1" ;
    skos:prefLabel "Portør"@nb ;
    skos:definition "Portører er profesjonelle pleieassistenter som transporterer mennesker på bårer / i seng rundt på sykehusområdet, i tillegg til varer."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C5329> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/5ee264b2-9bc5-40f6-9db3-c87143af6b2d> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5329.2" ;
    skos:prefLabel "laborant/blodprøvetaker"@nb ;
    skos:definition "Laboranter/blodprøvetaker tar blodprøver fra pasienter for laboratorieanalyse, og sørger for pasientsikkerheten under blodprøven. De transporterer prøven til laboratoriet etter strenge instrukser fra legen."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C5329> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/7005c266-d1a9-42ac-8c36-b42d5d755463> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5329.3" ;
    skos:prefLabel "steriltekniker"@nb ;
    skos:definition "Sterilteknikere sørger for dekontaminering av medisinsk utstyr i samsvar med strenge hygieniske prosedyrer. De demonterer, steriliserer, rengjør, pakker ned og setter sammen igjen sofistikert medisinsk utstyr, under tilsyn, etter instruks fra legen eller annet kvalifisert medisinsk personell."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C5329> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/31808988-fc0a-4bc3-9e47-27216d6759f5> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5414.1" ;
    skos:prefLabel "sikkerhetsvakt"@nb ;
    skos:definition "Sikkerhetsvakter observerer, oppdager uregelmessigheter og beskytter mennesker, bygninger og eiendeler. De sørger for sikkerhet til enhver tid ved å patruljere utpekte eiendomsområder, kontrollere tilgang ved innganger, følge med på alarm- og videoopptakssystemer, be mistenkelige personer om identifikasjon og rapportere overtredelser og lovbrudd."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C5414> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/b00e9e89-fd8d-4655-b6a2-f58b17629473> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5414.1.1" ;
    skos:prefLabel "sikkerhetsvakt på flyplass"@nb ;
    skos:definition "Sikkerhetsvakter på flyplass samhandler med passasjerer for å sikre problemfri forflytning mellom områdene på flyplassen, i samsvar med sikkerhetsbestemmelsene. De undersøker passasjerer, deres ID og bagasje for å sørge for sikkerheten og for å forhindre ulovlig aktivitet."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/31808988-fc0a-4bc3-9e47-27216d6759f5> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/37442765-f7bb-4ccd-9de1-4790296f3d37> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5414.1.10" ;
    skos:prefLabel "sikkerhetsvaktsjef"@nb ;
    skos:definition "Sikkerhetsvaktsjefer overvåker og har tilsyn med oppgavene til vakter som beskytter eiendommer mot hærverk og tyveri. De tildeler områder som skal patruljeres regelmessig av vakter, overlater dem som blir anholdt for ulovlig ferdsel på andres eiendom, til politiet og utarbeider sikkerhetsplaner og øvelser for bygningene og de ansatte de har ansvaret for."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/31808988-fc0a-4bc3-9e47-27216d6759f5> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/ffa4dd5d-702b-4828-ad85-17ec50db6656> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5414.1.2" ;
    skos:prefLabel "verditransportør"@nb ;
    skos:definition "Verditransportør sørger for sikker transport av verdifulle gjenstander mellom forskjellige steder, for eksempel transport av penger mellom butikker og banker. De laster og losser kjøretøyet, håndterer dokumentasjonen for overføringen, leverer gjenstandene til riktig sted og reagerer raskt på ran, i henhold til gjeldende sikkerhetsprotokoll. De kan også håndtere våpen og kjøre den pansrede bilen."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/31808988-fc0a-4bc3-9e47-27216d6759f5> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/f8e435dd-7aa9-4d7a-97c3-b3b5789b6b25> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5414.1.3" ;
    skos:prefLabel "livvakt"@nb ;
    skos:definition "Livvakter tilbyr beskyttelse til sine klienter mot personskade, angrep og trakassering. De ledsager enkeltpersoner, for eksempel politikere og skuespillere, til forskjellige arrangementer og samlinger. Livvakter observerer det omkringliggende miljøet, forutser trusler og reagerer på trusler mot sikkerheten. De kan bære og bruke våpen."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/31808988-fc0a-4bc3-9e47-27216d6759f5> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/8fc3d559-d61c-418c-ad4a-bf4c6b2909e3> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5414.1.4" ;
    skos:prefLabel "ordensvakt"@nb ;
    skos:definition "Ordensvakter holder konstant øye med folkemengden under spesifikke arrangementer, for eksempel taler, sportsbegivenheter eller konserter, for å forhindre og reagere raskt på hendelser. De kontrollerer inngangen til lokalet, overvåker folkemengdens oppførsel, håndterer aggressiv atferd og utfører nødevakueringer."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/31808988-fc0a-4bc3-9e47-27216d6759f5> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/7e17f4ea-9565-41e0-b408-b52b5c9492a3> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5414.1.5" ;
    skos:prefLabel "sjefsdørvakt"@nb ;
    skos:definition "Sjefsdørvakter sørger for at personer som kommer inn på offentlige steder, for eksempel barer, restauranter og konsertsteder, er ønsket, og at de ikke kan føre til potensielle problemer. De håndhever lovbestemmelser ved å kontrollere enkeltpersoners lovlige alder for å komme inn på utesteder, håndterer folkemengder og nødstilfeller, følger med på overholdelse av krav til antrekk og håndterer aggressiv og voldelig atferd."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/31808988-fc0a-4bc3-9e47-27216d6759f5> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/842d4d83-7e18-493a-a4a6-3f2a36504b18> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5414.1.6" ;
    skos:prefLabel "portvakt"@nb ;
    skos:definition "Portvakter kontrollerer innganger og utgangen i bygninger, lagre eller annen type eiendom, for å hindre uautorisert tilstedeværelse og uønskede hendelser. De forhindrer og identifiserer tyveri av selskapseiendom, undersøker mistenkelige aktiviteter og skriver rapporter. Portvakter kan hjelpe ansatte eller besøkende med forespørsler eller anvisninger. De bruker håndholdte radiostasjoner for å kommunisere og betjener alarmsystemer og datamaskiner."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/31808988-fc0a-4bc3-9e47-27216d6759f5> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/ebb4061a-906f-45fe-b4c0-a871c11f6fab> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5414.1.7" ;
    skos:prefLabel "sikkerhetsansvarlig på overnattingssted"@nb ;
    skos:definition "Sikkerhetsansvarlige på overnattingssted har ansvaret for å styre den overordnede prosessen og implementeringen av sikkerhetstjenesten for overnattingsstedet både når det gjelder sikkerhet for eiendeler, personlig sikkerhet og bygningssikkerhet."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/31808988-fc0a-4bc3-9e47-27216d6759f5> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/9c61bba4-56b7-4846-9f4e-b1f2decf3e7e> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5414.1.8" ;
    skos:prefLabel "utrykningsvakt"@nb ;
    skos:definition "Utrykningsvakter reagerer på innbruddsalarmer og undersøker forstyrrelser identifisert av alarmsystemet på klientenes eiendommer. De overvåker sikkerhetsalarmer og andre overvåkningsapparater og kontakter politiet når det oppdages ulovlig ferdsel på andres eiendom."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/31808988-fc0a-4bc3-9e47-27216d6759f5> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/c66b4569-09aa-4d8d-93d9-ac9b9176655d> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "5414.1.9" ;
    skos:prefLabel "sikkerhetskonsulent"@nb ;
    skos:definition "Sikkerhetskonsulenter tilbyr sikkerhetstjenester til klienter og enkeltpersoner som hjelper dem med å forhindre, planlegge og begrense trusler, for eksempel terrorisme, spionasje, tyveri og vold mot organisasjonen deres, inkludert bygninger, virksomhet og ansatte. Tjenestene de leverer, avhenger av kundenes sikkerhetsbehov og krav og kan omfatte tjenester som trusselanalyse, styring av sikkerhetsrisiko og utarbeiding av sikkerhetsprogrammer."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/31808988-fc0a-4bc3-9e47-27216d6759f5> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/a48b9a5a-5ded-482d-8cda-7fd097a32c16> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "6113.1" ;
    skos:prefLabel "parkarbeider"@nb ;
    skos:definition "Parkarbeidere tilbyr landskaps- og plentjenester og vedlikeholder hager for private husholdninger, kommersielle og offentlige anlegg, skoler, hoteller, botaniske hager, golfbaner, parker og friidrettsbaner."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C6113> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/d36b66f8-c08a-4416-953b-62c271ca7509> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "6113.2" ;
    skos:prefLabel "driftssjef for hagebruk"@nb ;
    skos:definition "Driftssjefer for hagebruk planlegger produksjonen, administrerer virksomheten og deltar i produksjonen."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C6113> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/8e24c53a-9dc6-46d1-986b-48a93f20df2a> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "6113.3" ;
    skos:prefLabel "arbeidsleder ved hagebruk"@nb ;
    skos:definition "Arbeidsledere ved hagebruk er ansvarlige for å lede og samarbeide med et team. De organiserer daglige arbeidsplaner for produksjon av hagebruksvekster og deltar i produksjonen."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C6113> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/1a9d99ba-4c08-4864-8f6a-1b0f2b4cf883> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "6113.4" ;
    skos:prefLabel "hagebruksarbeider"@nb ;
    skos:definition "Hagebruksarbeidere utfører praktiske aktiviteter og bistår i gartnerier eller drivhus ved produksjon av hagebruksvekster."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C6113> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/98af7387-3974-457a-aa57-5397d1ea3949> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "6113.5" ;
    skos:prefLabel "innendørsgartner"@nb ;
    skos:definition "Interiørgartnere utformer, installerer, administrerer og vedlikeholder grøntområder innendørs etter kundenes behov."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C6113> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/e7970c7a-7769-4002-87d3-0a8ea94fdd6f> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "6113.6" ;
    skos:prefLabel "landskapsgartner"@nb ;
    skos:definition "Landskapsgartnere planlegger, konstruerer, renoverer og vedlikeholder parker, hager og offentlige grøntområder."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C6113> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/fa30c1cb-dbc5-409c-8124-7284592b123c> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "6113.7" ;
    skos:prefLabel "trebeskjærer"@nb ;
    skos:definition "Trebeskjærere vedlikeholder trær. De bruker tunge maskiner for å beskjære og hugge trær. Trebeskjærere må ofte klatre opp i trærne for å utføre vedlikehold."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C6113> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/b4ff30f8-073b-4dd8-9128-ecf9d0ff87ba> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "6121.1" ;
    skos:prefLabel "kvegoppdretter"@nb ;
    skos:definition "Kvegoppdrettere fører tilsyn med produksjon og daglig pleie av kveg. De sørger for kvegets helse og velferd."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C6121> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/5734feab-60be-4f11-8e3f-e983ca6fb07a> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "6121.2" ;
    skos:prefLabel "stallsjef"@nb ;
    skos:definition "Stallsjefer er ansvarlige for den daglige driften av området, inkludert administrasjon av ansatte, stell av hestene, alle aspekter av HMS og kontakt med klienter og eiere."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C6121> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/15151ba4-fbf2-4fd9-8dde-2abbc6ec362c> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "6121.3" ;
    skos:prefLabel "hesteoppdretter"@nb ;
    skos:definition "Hesteoppdrettere fører tilsyn med produksjon og daglig pleie av hester. De sørger for hestenes helse og velferd."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C6121> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/ea3db1b3-7c03-4306-9e3d-7e20eb7f1826> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "6121.4" ;
    skos:prefLabel "griseoppdretter"@nb ;
    skos:definition "Griseoppdrettere fører tilsyn med produksjon og daglig pleie av griser. De sørger for grisene helse og velferd."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C6121> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/b2678105-9d5c-403f-b822-274aff706309> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "6121.5" ;
    skos:prefLabel "saueoppdretter"@nb ;
    skos:definition "Saueoppdrettere fører tilsyn med produksjon og daglig pleie av sauer. De sørger for sauenes helse og velferd."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C6121> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/2a1190f0-14d5-4ce4-ade0-ef726a1887a0> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "6121.6" ;
    skos:prefLabel "gjeter"@nb ;
    skos:definition "Gjetere håndterer velferd og bevegelse av husdyr, spesielt sauer, geiter og andre beitedyr, i en rekke omgivelser."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C6121> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/f489b1ec-3d6c-44b1-b1d7-c6c97db7df30> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "6210.1" ;
    skos:prefLabel "skogvokter"@nb ;
    skos:definition "Skogvoktere er ansvarlige for beskyttelse og vern av naturressurser, spesielt med hensyn til skog og skogsområder."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C6210> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/3206f826-7d53-4180-9797-e94ad9eaf841> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "6221.1" ;
    skos:prefLabel "akvakulturtekniker, spesialist på merder"@nb ;
    skos:definition "Akvakulturteknikere, spesialist på merder driver med produksjon av akvatiske organismer (i fersk-, brakk- eller saltvann), nærmere bestemt den delen av prosessen som finner sted i merder."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C6221> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/eaba592d-f3f0-4c7d-b7c0-302b7d0212ce> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "6221.10" ;
    skos:prefLabel "resirkuleringstekniker ved akvakulturbruk"@nb ;
    skos:definition "Resirkuleringsteknikere ved akvakulturbruk håndterer og kontrollerer produksjonsprosessene for akvatiske organismer i landbaserte resirkuleringssystemer, som bruker prosesser for gjenbruk av vann, og drift av pumpe, oksygentilførsel, varme, belysning og biofilterutstyr samt reservekraftsystemer."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C6221> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/0d6bb2cc-06b0-481c-b553-2a973be03254> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "6221.11" ;
    skos:prefLabel "akvakulturtekniker – produksjon på åpent vann"@nb ;
    skos:definition "Akvakulturteknikere, produksjon på åpent vann koordinerer og overvåker aktiviteter for oppfôring av akvakulturorganismer i flytende eller nedsenkede anlegg i sjø. De deltar i uthentingsoperasjoner og håndtering av organismer for kommersialisering. Akvakulturteknikere for produksjon på åpent vann fører tilsyn med vedlikehold av utstyr og anlegg (nett, forankringstau, merder osv.)."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C6221> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/d85e041f-8306-476e-a2cd-59baa1e61992> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "6221.2" ;
    skos:prefLabel "akvakulturtekniker, innhøsting"@nb ;
    skos:definition "Akvakulturteknikere, innhøsting driver innhøstingsprosessen for produksjon av akvatiske organismer, og administrerer det komplekse utstyret og maskineriet som brukes til innhøsting av spesifikke kultiverte arter."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C6221> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/02bd7cac-8263-4425-b03d-19001ffe8787> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "6221.3" ;
    skos:prefLabel "klekkeriansvarlig ved akvakulturbruk"@nb ;
    skos:definition "Klekkeriansvarlige ved akvakulturbruk planlegger, organiserer og koordinerer produksjonen i storskala akvakulturvirksomhet for å avle fisk og skalldyr og utvikler oppdrettsstrategier for akvakultur ved bruk av forskjellige typer gyteteknikker. De kontrollerer reproduksjonen og de tidlige livssyklusstadiene for kultiverte arter. De fører tilsyn med inkubasjon, tidlig fôring og oppdrettsteknikk av de kultiverte artene."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C6221> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/e93d5c8d-1219-4c11-91d7-9d0ab8d9c08e> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "6221.4" ;
    skos:prefLabel "klekkeritekniker ved akvakulturbruk"@nb ;
    skos:definition "Klekkeriteknikere ved akvakulturbruk håndterer og kontrollerer alle aspekter av prosessen for settefiskproduksjon, fra stamfiskforvaltning til yngling av yngel."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C6221> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/a8c7004a-e59c-4a4d-9092-2cb4533ffe58> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "6221.5" ;
    skos:prefLabel "klekkerimedarbeider ved akvakulturbruk"@nb ;
    skos:definition "Klekkerimedarbeidere ved akvakulturbruk deltar i produksjonen av akvatiske organismer i landbaserte settefiskprosesser. De bistår i prosessen med å få organismer til å vokse gjennom de tidlige stadiene av livssyklusen og setter ut organismer når det er nødvendig."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C6221> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/e0628770-57f0-4cf2-952e-5b16547db8c1> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "6221.6" ;
    skos:prefLabel "akvakulturtekniker med spesialfelt innen oppdrett"@nb ;
    skos:definition "Akvakulturteknikere med spesialfelt innen oppdrett spesialiserer seg på tilvekstfasen i oppdrett av akvatiske organismer, og har spesielt ansvar for fôring og bestandsforvaltning."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C6221> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/c0a15ec7-10e6-45e7-b69c-b85ff6f4f87f> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "6221.7" ;
    skos:prefLabel "oppdrettsarbeider ved akvakulturbruk"@nb ;
    skos:definition "Oppdrettsarbeidere ved akvakulturbruk deltar i produksjonen av akvatiske organismer i landbaserte tilvekstprosesser. De hjelper til med å få organismer til å vokse gjennom alle faser av livssyklusen."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C6221> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/d4709722-6f17-4bec-a5f4-1b660e6b28b1> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "6221.8" ;
    skos:prefLabel "forankringsleder ved akvakulturbruk"@nb ;
    skos:definition "Forankringsledere ved akvakulturbruk utfører og fører tilsyn med fortøyningen av merder i faste stasjoner, drivende merder eller til og med selvdrevne og halvt nedsenkede merder. De sørger for sikker betjening og fortøyning av en rekke forskjellige typer storskalabur, og administrerer forhold som strømmer, bølgeklima og havbunnsprofil, i åpne eller halvåpne vannområder."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C6221> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/802d3a2f-b966-42e3-94df-683adfcff20c> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "6221.9" ;
    skos:prefLabel "akvakulturtekniker med spesialfelt innen akvakulturoppdrett"@nb ;
    skos:definition "Akvakulturteknikere med spesialfelt innen akvakulturoppdrett driver med produksjon av akvatiske organismer. De er spesialister på oppdrett, avvenning og produksjon av yngel."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C6221> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/270528cf-2bf9-463d-aeaa-d169b1f767c1> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "6222.1" ;
    skos:prefLabel "kystfisker"@nb ;
    skos:definition "Kystfiskere driver småbåter innenskjærs og nær kysten. De organiserer, håndterer og utfører fraktaktiviteter på dekk og med motorer. Kystfiskere fanger og konserverer fisk eller driver med akvakulturdrift. De respekterer retningslinjer for sikkerhet og overholder nasjonal og internasjonal lovgivning."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C6222> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/05f321f8-055b-407d-bf19-e0ddabda56b7> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7112.1" ;
    skos:prefLabel "murer"@nb ;
    skos:definition "Murere monterer murvegger og -konstruksjoner ved å legge mursteinene i et fastsatt mønster og bruke et bindemiddel, for eksempel sement, for å binde mursteinene sammen. De fyller deretter skjøtene med mørtel eller andre egnede materialer."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7112> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/f3fc11ca-9a72-40da-bf0f-b2aab7e33079> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7113.1" ;
    skos:prefLabel "steinhogger"@nb ;
    skos:definition "Steinhoggere skjærer og monterer stein manuelt til byggeformål. Selv om CNC-betjent utskjæringsutstyr er bransjestandarden, utføres fortsatt kunsthåndverk med prydstein manuelt."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7113> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/565987b2-b980-4881-891c-cc4d5ab61d07> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7113.1.1" ;
    skos:prefLabel "steingravør"@nb ;
    skos:definition "Steingravører bruker håndverktøy, maskiner og kjemiske produkter for å etse og skjære mønstre og inskripsjoner på steinoverflater."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/f3fc11ca-9a72-40da-bf0f-b2aab7e33079> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/a9068f84-cecd-4cbb-9acb-e20c714435ec> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7114.1" ;
    skos:prefLabel "betongarbeider"@nb ;
    skos:definition "Betongarbeidere jobber med bindemidler som sement og betong. De monterer eventuelle flyttbare former og heller betong i formene. De utfører deretter én eller flere handlinger for å ferdigstille betongen: kutting, avretting eller jevning, komprimering, glatting og avfasing for å forhindre oppflising."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7114> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/a50d64e7-2dba-4418-81a7-92b2ba2e508f> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7114.2" ;
    skos:prefLabel "terrassolegger"@nb ;
    skos:definition "Terrassoleggere lager terrassooverflater. De klargjør overflaten og monterer strimler for å dele inn i seksjoner. Deretter heller de i løsningen, som inneholder sement og marmorbiter. Terrassoleggere ferdigstiller gulvet ved å polere overflaten, slik at det er glatt og blankt."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7114> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/2a22ff9e-de3b-408d-b312-5034896cc4f4> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7115.1" ;
    skos:prefLabel "tømrer"@nb ;
    skos:definition "Tømrere kapper, former og monterer treelementer for bygging av bygninger og andre konstruksjoner. De bruker også materialer som plast og metall under byggingen. Tømrere lager trerammene for å støtte bygninger med trerammer."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7115> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/0b5e4142-90ad-48a6-8407-ed47b2664954> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7115.2" ;
    skos:prefLabel "dørmontør"@nb ;
    skos:definition "Dørmontører setter på plass dører. De fjerner eventuelt den gamle døren, klargjør rammeåpningen og monterer den nye døren slik at den er innrettet, vannrett, loddrett og vanntett, hvis det er påkrevd. Dørmontører kontrollerer og utfører service også på eksisterende dører."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7115> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/bc61af54-0c3b-411c-a434-4b0d23c6fcce> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7115.3" ;
    skos:prefLabel "kjøkkenmontør"@nb ;
    skos:definition "Kjøkkenmontører monterer kjøkkenelementer i hjem. De tar de nødvendige målene, klargjør rommet, fjerner om nødvendig gamle elementer og monterer det nye kjøkkenutstyret, inkludert tilkobling av vann, gass og avløpsrør og strømledninger."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7115> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/246e7d87-756e-4db2-97e8-11ef63b864f0> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7115.4" ;
    skos:prefLabel "trappemontør"@nb ;
    skos:definition "Trappemontører monterer standardtrapper eller spesialdesignede trapper mellom de forskjellige etasjene i bygninger. De tar de nødvendige målene, klargjør området og monterer trappen på en trygg måte."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7115> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/353a22a7-1c55-410c-a7a7-c531692b5e50> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7115.5" ;
    skos:prefLabel "vindusmontør"@nb ;
    skos:definition "Vindusmontører monterer vinduer i konstruksjoner og utfører service på dem. De demonterer eventuelt gamle vinduer, klargjør åpningen, monterer vinduet og fester det slik at det er innrettet, vannrett loddrett og vanntett."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7115> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/18fa8080-3156-429a-bbd7-b3ef559b6721> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7119.1" ;
    skos:prefLabel "stillasarbeider"@nb ;
    skos:definition "Stillasarbeidere monterer stillaser og plattformer, slik at byggearbeid i høyden kan utføres så sikkert som mulig."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7119> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/dd89e26f-bb5c-45cb-91c6-8b4d5d82a31f> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7119.2" ;
    skos:prefLabel "rivningsarbeider"@nb ;
    skos:definition "Rivningsarbeidere bruker utstyr for å rive konstruksjoner. De ødelegger bygninger og fjerner skrapet på en trygg måte, slik at området kan brukes til andre formål."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7119> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/95da5e1b-cc1e-46bd-96c4-81d4f7003080> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7119.3" ;
    skos:prefLabel "montør av prefabrikkerte trebygninger"@nb ;
    skos:definition "Montører av prefabrikkerte trebygninger setter sammen treelementer til bruk i konstruksjoner. Elementene, eller modulene, kan bestå av vegger med innebygde vinduer og dører, eller de kan være like store som hele rom. Montørene setter sammen bærekonstruksjonen, isolasjonsmaterialene og overflatene, og fester det sammen for å få moduler som kan brukes."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7119> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/ac7c07d1-bc11-4f19-bca5-e468e9b1a53c> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7119.4" ;
    skos:prefLabel "tårnarbeider"@nb ;
    skos:definition "Tårnarbeidere er spesialiserte høydearbeidere som forflytter seg trygt på utsiden av bygninger og konstruksjoner for å utføre kritisk arbeid."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7119> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/b4c6d1b0-929e-48be-9f67-47bd8c30658b> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7121.1" ;
    skos:prefLabel "taktekker"@nb ;
    skos:definition "Taktekkere legger tak på konstruksjoner. De monterer de vektbærende elementene på et tak, enten flatt eller skrått, og dekker det deretter med et værbestandig lag."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7121> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/41a8e7c8-e1d8-4984-9b3c-dbbad1699f83> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7123.1" ;
    skos:prefLabel "takmontør"@nb ;
    skos:definition "Takmontører monterer tak i bygninger. De bruker forskjellige teknikker avhengig av situasjonen, for eksempel når brannmotstand er spesielt viktig, eller når det trengs plass mellom det senkede taket og neste etasje, eller spesialiserer seg på én."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7123> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/f4a22809-c00c-4dd0-8b09-c7251f8dcd1c> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7123.2" ;
    skos:prefLabel "gipsarbeider"@nb ;
    skos:definition "Gipsarbeidere påfører sparkel laget av gips, sement eller andre midler, på vegger som en jevn finish. De blander tørt sparkelpulver med vann, og smører deretter den ferdige mørtelen på en vegg. Sparkelen blir deretter jevnet ut før den herder og danner et solid belegg på veggen."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7123> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/b2dab4fb-b7f7-4f57-94b2-9c0f0848564a> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7124.1" ;
    skos:prefLabel "isolasjonsarbeider"@nb ;
    skos:definition "Isolasjonsarbeidere monterer en rekke isolasjonsmaterialer for å beskytte en konstruksjon eller materialer mot varme, kulde og støy fra omgivelsene."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7124> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/5f9e0588-e819-42f7-9975-f53198666c07> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7125.1" ;
    skos:prefLabel "glassmontør"@nb ;
    skos:definition "Glassmontører monterer glassruter i vinduer og andre konstruksjonselementer, for eksempel glassdører, vegger, fasader og andre konstruksjoner."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7125> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/211716b7-2857-40c8-a078-da983c78c70a> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7125.2" ;
    skos:prefLabel "bilrutemontør"@nb ;
    skos:definition "Bilrutemontører monterer glass i motorkjøretøyer i henhold til bilprodusentens spesifikasjoner, for eksempel glasstype, tykkelse, størrelse og form. De bestiller og kontrollerer vinduer for spesifikke bilmodeller, og klargjør de skadede områdene for å montere nytt glass."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7125> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/3df28a39-9bfe-4e36-b394-a189ef967a74> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7126.1" ;
    skos:prefLabel "baderomsinstallatør"@nb ;
    skos:definition "Baderomsinstallatører monterer baderomselementer. De tar de nødvendige målene, klargjør rommet, fjerner om nødvendig gamle elementer og monterer det nye baderomsutstyret, inkludert tilkobling av vann, gass og avløpsrør og strømledninger."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7126> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/6f74ebc4-ab7e-42a8-ad94-921f3d0ef0c6> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7126.10" ;
    skos:prefLabel "avløpstekniker"@nb ;
    skos:definition "Avløpsteknikere vedlikeholder avløpssystemer som fjerner og transporterer avløpsvann og kloakk. De kontrollerer rør, pumpestasjoner og hovedledninger, leter etter lekkasjer eller andre feil og reparerer eventuelle feil. De fjerner blokkeringer og utfører vedlikeholdsoppgaver ved å bruke nettverkskart og spesialprogramvare."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7126> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/73d77554-2016-46fa-ac3d-44a02e8d1a89> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7126.11" ;
    skos:prefLabel "kloakkledningsarbeider"@nb ;
    skos:definition "Kloakkledningsarbeidere monterer kloakkrør for å transportere avløpsvann ut av konstruksjoner og til en vannmasse eller renseanlegg. De graver grøfter, legger i rørene og sørger for at rørene har riktig helling, og at tilkoblingene er vanntette. Kloakkledningsarbeidere konstruerer også andre elementer i kloakkinfrastruktur, for eksempel kummer, og vedlikeholder og reparerer eksisterende systemer."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7126> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/02ff199e-38b3-45fd-b659-68846cfeeb92> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7126.12" ;
    skos:prefLabel "montør av sprinkleranlegg"@nb ;
    skos:definition "Montører av sprinkleranlegg er ansvarlige for montering av brannsikringssystemer som sprer vann. De kobler sammen rør, slanger og nødvendig tilbehør. Montører av sprinkleranlegg kontrollerer også systemene for lekkasjer."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7126> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/0f898624-9b89-41ba-adcf-9360ade85a62> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7126.13" ;
    skos:prefLabel "vannforsyningstekniker"@nb ;
    skos:definition "Vannforsyningsteknikere monterer systemer for å gjenvinne, filtrere, lagre og distribuere vann fra forskjellige kilder, for eksempel regnvann og gråvann fra husholdninger."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7126> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/094b9f9b-7e89-4f34-adbb-fbaf7246f7a4> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7126.14" ;
    skos:prefLabel "vann- og avløpstekniker"@nb ;
    skos:definition "Vann- og avløpsteknikere vedlikeholder rør og pumpestasjoner som brukes til vannforsyning, fjerning av avløpsvann og kloakk. De utfører planlagte vedlikeholds- og reparasjonsoppgaver og fjerner blokkeringer i rør og avløp."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7126> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/461959ed-6a80-4c33-a75e-26aaeb52a5a7> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7126.2" ;
    skos:prefLabel "VVS-tekniker"@nb ;
    skos:definition "VVS-teknikere monterer og vedlikeholder dreneringsutstyr som brukes i kloakksystemer, for eksempel rør og ventiler. De analyserer designet, sørger for riktig montering av dreneringssystemet og utfører vedlikeholds- og reparasjonsoppgaver."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7126> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/97b3cab1-f4f0-41ed-8c80-e65e6c067e95> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7126.3" ;
    skos:prefLabel "gasstekniker"@nb ;
    skos:definition "Gassteknikere monterer og vedlikeholder apparater og systemer for gasstjenester i anlegg eller bygninger. De monterer utstyret i samsvar med lover og forskrifter, reparerer feil og undersøker lekkasjer og andre problemer. De tester utstyret og gir råd om bruk og vedlikehold av apparater og systemer som bruker gassenergi."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7126> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/7259dc48-004a-4ceb-aa4e-5bbd548c2397> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7126.4" ;
    skos:prefLabel "varmetekniker"@nb ;
    skos:definition "Varmeteknikere monterer og vedlikeholder varme- og ventilasjonsutstyr basert på gass, elektrisitet, olje, fast brensel og annet drivstoff, som frittstående varme- og ventilasjonssystemer eller innebygd i maskiner og transportutstyr. De følger instruksjoner og plantegninger, utfører vedlikehold på systemer, gjennomfører sikkerhetskontroller og reparerer systemene."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7126> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/ef53663e-c295-43a4-a48e-84254270b138> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7126.5" ;
    skos:prefLabel "montør av vanningssystem"@nb ;
    skos:definition "Montører av vanningssystem bygger den nødvendige infrastrukturen for vanning av jord, vanligvis til landbruksformål. De kan være spesialiserte på ett eller flere av de forskjellige typene stasjonære vanningsanlegg."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7126> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/534d18fe-eae4-4a02-af4d-f78e92faa5d5> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7126.6" ;
    skos:prefLabel "tekniker for vanningssystem"@nb ;
    skos:definition "Teknikere for vanningssystem er spesialister på montering, vedlikehold og reparasjon av sprinklere, rør og andre vanningsanlegg. De betjener maskiner som brukes til håndtering av vanningssystemer, og sikrer overholdelse av miljøstandarder."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7126> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/75f4c7aa-019f-4545-9ce1-2d163fe78580> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7126.7" ;
    skos:prefLabel "vedlikeholdsarbeider, rørledning"@nb ;
    skos:definition "Vedlikeholdsarbeidere, rørledning bruker forskjellig utstyr for å holde rørledningene i god stand. De utfører kontroller av avvik og administrerer kjemikalier i henhold til behov og rengjøringsmål (for eksempel for å unngå korrosjon)."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7126> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/ed3cf43d-c2c1-4c46-82fc-1375e27e0290> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7126.8" ;
    skos:prefLabel "rørlegger"@nb ;
    skos:definition "Rørleggere vedlikeholder og monterer vann-, gass- og avløpsanlegg. De kontrollerer rør og installasjoner regelmessig eller utfører reparasjoner etter behov. De bøyer, kapper og monterer rør. De tester systemer og utfører justeringer på en trygg måte og i henhold til lover og forskrifter. De monterer sanitærutstyr."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7126> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/89a6d6e5-8362-4b99-b745-1c68bffbda77> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7126.9" ;
    skos:prefLabel "servicemedarbeider, septiktank"@nb ;
    skos:definition "Servicemedarbeidere, septiktank rengjør og vedlikeholder septiktanksystemer. De reparerer skader og feil, sørger for at tankene blir rengjort og vedlikeholdt, og bruker rengjørings- og vedlikeholdsmaskiner i samsvar med sikkerhetsprosedyrene."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7126> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/79f435d0-9bc6-4d25-a26a-acbe16569ebb> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7127.1" ;
    skos:prefLabel "servicetekniker, VVS-anlegg"@nb ;
    skos:definition "Serviceteknikere, VVS-anlegg monterer og vedlikeholder industrielle systemer for oppvarming, luftkondisjonering og, eventuelt, kjøling. De monterer ovner, termostater, kanaler, ventiler og annet utstyr som er nødvendig for å sørge for kontrollert passasje og behandling av luft. De utfører også reparasjoner."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7127> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/15620506-fb5d-49cd-87a2-1c9047fb406a> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7131.1" ;
    skos:prefLabel "husmaler"@nb ;
    skos:definition "Husmalere maler innsiden og utsiden av bygninger og andre konstruksjoner. De kan bruke standard lateksbaserte malinger eller spesialmalinger for dekorasjon eller beskyttelse. Husmalere er faglært innen bruk av pensler, maleruller og malesprøyter til forskjellig påføring."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7131> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/a2abd144-2a36-45ea-919c-1fcc6ebc5d45> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7131.2" ;
    skos:prefLabel "tapetserer"@nb ;
    skos:definition "Tapetserere spesialiserer seg på tapetsering. De påfører lim på papiret eller, ved bruk av forsterket tapet, på veggen, setter tapetet på veggen og sørger for at tapetet henger rett, og at det ikke er luftbobler under."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7131> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/7443811e-6760-44a2-af95-1b9c791733a8> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7132.1" ;
    skos:prefLabel "sprøytelakkerer"@nb ;
    skos:definition "Sprøytelakkerere bruker sprøytepistoler for lakk som er konstruert for å gi ellers ferdige metall-, tre- eller plastarbeidsstykker, et hardt og holdbart toppstrøk, med lakk eller maling som enten er matt, glanset eller svært blank, men som alltid er beregnet på harde overflater."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7132> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/fb4819db-03fa-4dc1-a471-2cdc24dcbe6f> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7132.2" ;
    skos:prefLabel "overflatebehandler"@nb ;
    skos:definition "Overflatebehandlere påfører kjemikalier og maling på overflaten på et materiale for å beskytte materialet mot korrosjon. De beregner materialmengden som kreves for overflatebeskyttelse."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7132> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/a784b063-89cf-441b-9624-deed9dbdeae6> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7132.3" ;
    skos:prefLabel "lakkerer, kjøretøy"@nb ;
    skos:definition "Lakkerere, kjøretøy bruker malingsmaskiner og håndverktøy for å påføre belegg på enkeltdeler og male overflaten på alle typer transportutstyr, for eksempel biler, busser, båter, fly, motorsykler og togvogner. De klargjør overflaten av delene for lakkering og påfører lakken. Lakkerere, kjøretøy kan utføre industrimaling eller individuell tilpassing. De kan også fjerne eller reparere malingsfeil, for eksempel riper."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7132> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/990bfa45-5001-4365-93b6-daf01a03b4cd> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7133.1" ;
    skos:prefLabel "asbestsanerer"@nb ;
    skos:definition "Asbestsanerere fjerner asbest fra bygninger og andre konstruksjoner i samsvar med HMS-bestemmelser for håndtering av farlige materialer. De undersøker intensiteten av asbestforurensningen, klargjør konstruksjonen for fjerning og forhindrer forurensning av andre områder."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7133> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/a632fb74-ef49-4f4a-9777-b7df54a0f897> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7133.2" ;
    skos:prefLabel "fasaderenholder"@nb ;
    skos:definition "Fasaderenholdere fjerner skitt og søppel fra bygningens utvendige fasade, samt utfører restaureringsoppgaver. De sørger for at rengjøringsmetodene er i samsvar med sikkerhetsforskriftene, og overvåker fasaden på utsiden for å sikre at den er i god stand."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7133> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/a2dee758-72f5-4f1c-b760-f2b8e9d81911> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7133.3" ;
    skos:prefLabel "skorsteinsfeier"@nb ;
    skos:definition "Skorsteinsfeiere utfører rengjøring av skorsteiner for alle typer bygninger. De fjerner aske og sot og utfører vedlikehold regelmessig i henhold til HMS-bestemmelsene. Skorsteinsfeiere kan utføre sikkerhetskontroller og mindre reparasjoner."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7133> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/4305327d-3537-4dfb-a913-bce6614362f1> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7133.4" ;
    skos:prefLabel "feiermester"@nb ;
    skos:definition "Feiermestere fører tilsyn med og koordinerer oppgavene til skorsteinsfeiere. De utfører kvalitetskontroller og sikrer overholdelse av sikkerhetsforskrifter."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7133> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/c0ec3a06-1dac-4c21-9f08-4c9dfbc9d6cf> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7133.5" ;
    skos:prefLabel "dekontamineringsarbeider"@nb ;
    skos:definition "Dekontamineringsarbeidere fjerner og avhender farlige stoffer, for eksempel radioaktivt materiale eller forurenset jord. De håndterer farlige stoffer i samsvar med sikkerhetsforskriftene, undersøker årsaker til forurensning og fjerner forurensningen fra konstruksjonen eller området."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7133> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/dc14bed4-87ca-4e6c-9f69-458e2689d2d6> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7211.1" ;
    skos:prefLabel "støperiarbeider"@nb ;
    skos:definition "Støperiarbeidere produserer støpegods som rør og hulprofiler av den første prosesseringen av stål, ved å betjene håndkontrollert utstyr i et støperi. De fører strømmen av smeltede jernholdige og ikke-jernholdige metaller til støpeformene, og passer på å skape nøyaktig riktige forhold for å produsere metall av høyeste mulig kvalitet. De observerer strømmen av metall for å identifisere feil. Hvis det oppstår feil, varsler de autorisert personell og deltar under fjerningen av feilen."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7211> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/123a195c-103a-4b84-b3fd-6d40dbc15c54> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7211.1.1" ;
    skos:prefLabel "kokillestøpearbeider"@nb ;
    skos:definition "Kokillestøpearbeidere produserer støpegods som rør og hulprofiler av den første prosesseringen av stål, ved å betjene håndkontrollert utstyr i et støperi. De fører strømmen av smeltede jernholdige og ikke-jernholdige metaller til kokillene, og passer på å skape nøyaktig riktige forhold for å produsere metall av høyeste mulig kvalitet. De observerer strømmen av metall for å identifisere feil. Hvis det oppstår feil, varsler de autorisert personell og deltar under fjerningen av feilen."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/dc14bed4-87ca-4e6c-9f69-458e2689d2d6> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/c5902c47-0c2e-45aa-94dd-951ad641449c> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7211.1.2" ;
    skos:prefLabel "kjernemaker"@nb ;
    skos:definition "Kjernemakere produserer kjerner for metallstøpeformer, som brukes til å fylle et rom i støpeformen som må forbli tomt under støpingen. De bruker tre, plast eller andre materialer for å lage kjernen; materialene er valgt for å motstå det ekstreme miljøet i en metallstøpeform."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/dc14bed4-87ca-4e6c-9f69-458e2689d2d6> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/5318abf2-2e7b-4d09-ae57-6bd500689ebc> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7211.1.3" ;
    skos:prefLabel "modellsnekker"@nb ;
    skos:definition "Modellsnekkere lager støpeformer manuelt for produksjon av metallprodukter. De blander sand og herdende materialer for å lage en spesialblanding. De bruker deretter et mønster og én eller flere kjerner for å avsette riktig formavtrykk i dette materialet. Det formede materialet blir deretter satt til herding, og brukes senere som støpeform ved fremstilling av støpegods av jernholdige og ikke-jernholdige metaller."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/dc14bed4-87ca-4e6c-9f69-458e2689d2d6> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/6d72138d-2ebb-4a89-b2b2-8c22365b89bf> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7212.1" ;
    skos:prefLabel "hardloddere"@nb ;
    skos:definition "Hardloddere bruker utstyr og maskiner av forskjellige slag, som brennere, loddebolter, flussmidler og sveisemaskiner, for å feste to metallstykker sammen ved å varme opp, smelte og danne en metallfylling mellom dem, ofte messing eller kobber. Ved hardlodding føyer man sammen metaller som aluminium, sølv, kobber, gull og nikkel. Hardlodding ligner lodding, men krever høyere temperatur."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7212> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/17b29190-6746-4b81-a1d1-8053a5bbc0e9> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7212.2" ;
    skos:prefLabel "lodder"@nb ;
    skos:definition "Loddere bruker utstyr og maskiner av forskjellige slag, for eksempel gassbrennere, loddebolter, sveisemaskiner eller elektrisk-ultrasonisk utstyr, for å lodde sammen to eller flere gjenstander (vanligvis metaller) ved å smelte og danne en metallfylling mellom skjøtene. Metallfyllingen har et lavere smeltepunkt enn det tilstøtende metallet."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7212> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/7aedaa07-3884-4c5b-88f9-80997b2aa54b> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7212.3" ;
    skos:prefLabel "sveiser"@nb ;
    skos:definition "Sveisere bruker sveiseutstyr for å sammenføye metallarbeidsstykker. De kan bruke smeltesveiseprosesser basert på forskjellige teknikker og materialer. De utfører også enkel visuell inspeksjon av sveisesømmer."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7212> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/e9a65aca-64f6-450d-a637-1ecf86ba2a53> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7212.3.1" ;
    skos:prefLabel "elektronstrålesveiser"@nb ;
    skos:definition "Elektronstrålesveisere setter opp og betjener maskiner konstruert for å sammenføye separate metallstykker ved bruk av en elektronstråle med høy hastighet. De overvåker maskinprosessene og styrer den kinetiske energien til, og dermed varmeavgivelsen fra, elektronstrømmen slik at man får en sveiseprosess med presis smelting og sammenføyning."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/7aedaa07-3884-4c5b-88f9-80997b2aa54b> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/c81af273-1112-4b3f-a2a5-b85b1290ae22> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7212.3.2" ;
    skos:prefLabel "lasersveiser"@nb ;
    skos:definition "Lasersveisere setter opp og betjener lasersveisemaskiner, som føyer sammen metalliske arbeidsstykker med en laserstråle som varmekilde og muliggjør presis sveising."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/7aedaa07-3884-4c5b-88f9-80997b2aa54b> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/2ff73126-7aff-4233-9d9c-d8725e1c6822> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7212.3.3" ;
    skos:prefLabel "rørsveiser"@nb ;
    skos:definition "Rørsveisere setter sammen og monterer deler og komponenter for rørledninger for transport av medier som vann, damp og kjemikalier. De tolker spesifikasjoner, for eksempel pneumatikk og hydraulikk, for installasjon på stedet i henhold til sikkerhets- og produksjonskrav."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/7aedaa07-3884-4c5b-88f9-80997b2aa54b> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/97dadd59-d1cb-4fef-81a7-d92eb15572e2> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7212.3.4" ;
    skos:prefLabel "punktsveiser"@nb ;
    skos:definition "Punktsveisere setter opp og betjener punktsveisemaskiner, som trykker sammen arbeidsstykker og fester dem til hverandre. Metallets motstand mot elektrisk strøm og varmen som oppstår i prosessen, muliggjør lokal smelting og sammenføyning av delene."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/7aedaa07-3884-4c5b-88f9-80997b2aa54b> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/cdef4961-fcc2-4e00-bfe8-4480b33aa6f3> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7212.4" ;
    skos:prefLabel "sveisekoordinator"@nb ;
    skos:definition "Sveisekoordinatorer overvåker arbeidsflyten for sveiseoperasjoner. De overvåker sveiseprosesser som utføres av andre sveisere, fører tilsyn med personalet, og er noen ganger ansvarlige for yrkesopplæringen. De sveiser også spesielt krevende deler. Sveisekoordinatorer sørger for at nødvendig sveiseutstyr er klart til bruk. De koordinerer stort sett sveiseoperasjoner og tilknyttede faglige aktiviteter."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7212> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/5ed024ab-3b6a-4e06-a7fe-8a29f8469a64> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7213.1" ;
    skos:prefLabel "kobber- og blikkenslager"@nb ;
    skos:definition "Kobber- og blikkenslagere bruker et utvalg av utstyr og maskiner for å lage og reparere rør og tilførsler for varmtvanns- og dampbeholdere, og produsere dem i alle trinn i produksjonsprosessen. De kapper, måler og former metallplater og rør for kjeler i riktig størrelse ved hjelp av skjærebrenneree, monterer dem med dekket elektrode-sveising, MIG-sveising eller TIG-sveising, og utfører sluttbehandling med egnede maskinverktøy, kraftdrevne verktøy og belegg."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7213> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/1a1ea837-0103-4230-8756-533a77c5f9f4> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7213.2" ;
    skos:prefLabel "platearbeider"@nb ;
    skos:definition "Platearbeidere produserer beholdere, for eksempel kjeler eller trykkbeholdere. De leser plantegninger og tekniske tegninger for å montere deler, lage rør og beslag."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7213> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/2d6d4cb2-5d46-4d1f-939b-7f55c02c64cb> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7213.3" ;
    skos:prefLabel "kobbersmed"@nb ;
    skos:definition "Kobbersmeder lager og reparerer gjenstander som er laget av ikke-jernholdige metaller, for eksempel kobber, messing og lignende materialer. De omdanner råvarene til gjenstander med praktisk eller kunstnerisk formål ved hjelp av smiverktøy. Profesjonelle kobbersmeder lager detaljerte og svært tekniske enheter ved bruk av egnede smiteknikker."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7213> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/572c9810-e1ee-4f7a-a71f-820f17c0c25b> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7213.4" ;
    skos:prefLabel "tynnplatearbeider"@nb ;
    skos:definition "Tynnplatearbeidere innen bygg bruker plater til å konstruere tak, kanaler for oppvarming, ventilasjon og klimaanlegg, takrenner og andre metallkonstruksjoner. De leser planer og bestemmer materialtype og -mengde som skal brukes, og måler, bøyer, kapper, former og fester metalldeler til hverandre for å lage den nødvendige konstruksjonen."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7213> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/ea6cd713-94ca-4292-9ba9-ca8a4ec3ed5f> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7214.1" ;
    skos:prefLabel "demonteringsarbeider"@nb ;
    skos:definition "Demonteringsarbeidere utfører demontering av industrielt utstyr, maskiner og bygninger, som instruert av teamleder. De bruker tunge maskiner og forskjellige elektroverktøy avhengig av oppgaven. Det tas hensyn til gjeldende sikkerhetsforskrifter."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7214> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/8afab6c4-6145-4ea1-a0ae-d2c3438bda7e> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7214.2" ;
    skos:prefLabel "skipsbygger"@nb ;
    skos:definition "Skipsbyggere bygger og reparerer små fartøy, fra lystfartøy til marinefartøy. De utarbeider foreløpige skisser og lager maler. De bruker hånd- og elektroverktøy for å konstruere mindre båter selv eller fører tilsyn med et team av skipsbyggere. De konstruerer også sleder og slipper til bygging, transport, sjøsetting og landsetting. Avhengig av fartøyet kan de arbeide med forskjellige materialer, for eksempel metall, tre, glassfiber, aluminium og så videre."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7214> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/691ec040-f5ad-47ef-8698-03212d66dbbf> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7214.3" ;
    skos:prefLabel "stålkonstruksjonsarbeider"@nb ;
    skos:definition "Stålkonstruksjonsarbeidere monterer jernelementer i konstruksjoner. De reiser stålrammeverket til bygninger, broer og andre byggeprosjekter. De lager armert betong ved å sette inn metallstenger, eller armeringsjern."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7214> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/0a7e24a8-19bd-4b45-83f0-f05d8fedf62d> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7214.3.1" ;
    skos:prefLabel "klinker"@nb ;
    skos:definition "Klinkere setter sammen metalldeler med nagletang eller med koppsetter og hammer, eller med klinkemaskiner, som lager naglehullet, setter inn naglen og tilformer hodet i én operasjon."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/691ec040-f5ad-47ef-8698-03212d66dbbf> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/fccecd5d-ad90-41a8-bb89-96d7595abca3> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7221.1" ;
    skos:prefLabel "smed"@nb ;
    skos:definition "Smeder varmer metall, vanligvis stål, i en smie og former det med hammer, meisel og ambolt. I dag lager smeder vanligvis hovedsakelig kunsthåndverkprodukter av metall, inkludert dekorativt arbeid og hestesko, en av de få metallfabrikkeringsprosessene som ikke er blitt industrialisert."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7221> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/bcffa133-c499-4db4-8e4f-b2d95da3b0fc> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7221.1.1" ;
    skos:prefLabel "hovslager"@nb ;
    skos:definition "Hovslagere kontrollerer, trimmer og former hovene til hester og lager og tilpasser hestesko i samsvar nasjonale lover og forskrifter."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/fccecd5d-ad90-41a8-bb89-96d7595abca3> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/93a8bd5f-c268-46f5-8461-1138a9a96189> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7221.2" ;
    skos:prefLabel "operatør av senkesmier"@nb ;
    skos:definition "Operatører av senkesmier bruker smimaskiner og -utstyr, spesifikt maskinerte hammere, for å forme jern- og ikke-jernholdige metallstykker til ønsket form. De betjener smihammerne som slippes ned på arbeidsstykket for å omforme det etter formen, som kan være lukket eller åpen og omslutte arbeidsstykket helt eller delvis."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7221> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/0ab64770-9fd7-4baf-8abf-b1ac0e1538ba> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7221.3" ;
    skos:prefLabel "operatør av hydraulisk presse"@nb ;
    skos:definition "Operatører av hydraulisk presse monterer og betjener hydrauliske smipresser, som er konstruert for å forme jern- og ikke-jernholdige metallstykker, inkludert rør, hulprofiler og andre produkter fra den første bearbeidingen av stål, til deres ønskede form ved bruk av trykkrefter som genereres av et stempel og væsketrykk."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7221> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/bc61e0de-2d72-471c-90c1-a9fe371020f9> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7221.4" ;
    skos:prefLabel "operatør av mekanisk smipresse"@nb ;
    skos:definition "Operatører av mekanisk smipresse monterer og betjener mekaniske smipresser, som er konstruert for å forme jern- og ikke-jernholdige metallstykker, inkludert rør, hulprofiler og andre produkter fra den første bearbeidingen av stål, til deres ønskede form ved bruk av forhåndsinnstilte slagkrefter levert av veiv-, kam- og kneleddmekanismer."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7221> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/2a8d6b4c-661d-4620-8f68-2c99e78f512e> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7222.1" ;
    skos:prefLabel "støpeformmaker"@nb ;
    skos:definition "støpeformmaker lager metall-, tre- eller plastmodeller av det ferdige produktet som skal støpes. Deretter brukes mønstrene til å lage støpeformer, som deretter brukes til støping av produktet med samme form som mønsteret."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7222> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/12dc4509-7d36-46d8-aca0-c147c7ecd806> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7222.2" ;
    skos:prefLabel "børsemaker"@nb ;
    skos:definition "Børsemakere modifiserer og reparerer metallproduserte skytevåpen i henhold til spesielle kundespesifikasjoner. De bruker maskiner og håndverktøy, for eksempel høvler, vinkelslipere og fresemaskiner, for å endre og restaurere skytevåpen, og de kan også utføre graveringer, utskjæringer og annen dekorativ finpuss på det ellers ferdige produktet."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7222> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/aaa485d0-6787-45c0-8596-b266c0b687fd> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7222.3" ;
    skos:prefLabel "låsesmed"@nb ;
    skos:definition "Låsesmeder monterer og reparerer mekaniske og elektroniske låsesystemer ved hjelp av spesialverktøy. De skjærer ut og kopierer nøkler for kunder og åpner låste dører i nødssituasjoner. Låsesmeder kan også gi råd om sikkerhetstiltak."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7222> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/d1974e0c-8f92-473b-a32d-f0616c08b1ff> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7222.4" ;
    skos:prefLabel "finmekaniker"@nb ;
    skos:definition "Finmekanikere produserer presisjonskomponenter av metall til maskiner og monterer dem i funksjonelle enheter. De bygger også elektroniske måle- og kontrollkomponenter. Finmekanikere bruker frese-, bore-, slipe- og honemaskiner."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7222> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/ecac98ea-9fc3-4475-9b23-8af94f41603d> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7222.5" ;
    skos:prefLabel "verktøymaker"@nb ;
    skos:definition "Verktøymakere bruker en rekke utstyr og maskiner konstruert for å lage metallverktøy og -former til bruk i produksjonsprosesser av mange slag, og produserer disse verktøyene i alle trinn i produksjonsprosessen. De designer verktøyene og formene, kapper og former dem til riktig størrelse og ferdigstiller dem med manuelt betjente maskinverktøy, elektroverktøy og håndverktøy, eller ved å programmere og betjene CNC-maskiner."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7222> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/b8db7ef4-4057-4e88-8e2a-105b4b59fb67> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7231.1" ;
    skos:prefLabel "tekniker, bilbremser"@nb ;
    skos:definition "Teknikere, bilbremser kontrollerer, vedlikeholder, diagnostiserer og reparerer bremse-, styre- og opphengssystemer, i tillegg til hjul og dekk."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7231> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/4ad4024e-d1d3-4dea-b6d1-2c7948111dce> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7231.10" ;
    skos:prefLabel "kjøretøytekniker"@nb ;
    skos:definition "Kjøretøyteknikere kontrollerer, tester og vedlikeholder kjøretøyer og motorsykler, utfører motorjusteringer og skifter dekk. De reparerer motorfeil og skifter smøring. Kjøretøyteknikere skifter ut kjøretøykomponenter og vurderer garantialternativer."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7231> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/5ab842f6-1f75-4d84-bf41-b8a9799347df> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7231.2" ;
    skos:prefLabel "karosseriarbeider"@nb ;
    skos:definition "karosseriarbeider utfører arbeid på karosserier og kan lage karosserideler av plater og produsere og montere rammer og deler til kjøretøy."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7231> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/24d378d8-1e16-4667-bdb4-1f4a0f2c6379> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7231.3" ;
    skos:prefLabel "dieselmotormekaniker"@nb ;
    skos:definition "Dieselmotormekanikere reparerer og vedlikeholder alle typer dieselmotorer. De bruker håndverktøy, presisjonsmåleinstrumenter og maskinverktøy til å diagnostisere problemer, demontere motorer og undersøke og bytte deler med feil eller stor slitasje."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7231> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/0ec62c2e-30c9-434e-bf36-5277a0840450> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7231.4" ;
    skos:prefLabel "reparatør, motorkjøretøy"@nb ;
    skos:definition "Reparatører, motorkjøretøy overhaler og renoverer innvendige deler av kjøretøy, for eksempel motordeler og dieselpumper."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7231> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/158965f1-bd83-441c-bca8-1975b74dedc5> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7231.5" ;
    skos:prefLabel "bilrestaurerer"@nb ;
    skos:definition "Bilrestaurerere overhaler gamle og klassiske biler."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7231> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/c0749528-ee2a-41bd-a1f6-c13825b5e569> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7231.6" ;
    skos:prefLabel "mekaniker, reparasjon på stedet"@nb ;
    skos:definition "Mekanikere, reparasjon på stedet utfører reparasjoner, tester og vedlikehold på kjøretøy på stedet. De finner og reiser til kundenes kjøretøy for å utføre service, for eksempel dekkskift og reparasjoner av motorer."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7231> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/98c429ad-128e-467e-803a-9a6dc1ceed72> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7231.7" ;
    skos:prefLabel "dekkmontør"@nb ;
    skos:definition "Dekkmontører kontrollerer, vedlikeholder, reparerer og monterer dekk på kjøretøy. De gir kunder råd om forskjellige dekk- og hjultyper. I tillegg balanserer de dekkene og kontrollerer at hjulene er riktig justert og overholder standarder og forskrifter for sikkerhet."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7231> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/3b4eb248-6b40-42fe-9d10-cba8ccfe6613> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7231.8" ;
    skos:prefLabel "servicetekniker, bil"@nb ;
    skos:definition "Serviceteknikere, bil utfører grunnleggende oppgaver, for eksempel å skifte olje, filter og tennplugger, på et serviceverksted for kjøretøy."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7231> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/264b00c9-84d0-4dc9-b590-aed2cea2b904> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7231.9" ;
    skos:prefLabel "leder av serviceverksted"@nb ;
    skos:definition "Ledere av serviceverksted har ansvaret for den daglige driften av et serviceverksted."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7231> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/a429e4fe-22c6-4cb5-89ef-ca4d5b4d0363> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7232.1" ;
    skos:prefLabel "montør av avisingsutstyr på fly"@nb ;
    skos:definition "Montører av avisingsutstyr på fly setter sammen, monterer, tester, vedlikeholder og reparerer mekaniske avisings- og antiisingssystemer som hindrer oppsamling eller danning av is på fly og romfartøy."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7232> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/0ac8fe65-32e6-4c25-8345-2b87bc7b2698> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7232.2" ;
    skos:prefLabel "flymotorspesialist"@nb ;
    skos:definition "Flymotorspesialister gir råd om vedlikeholdsprosedyrer for motorer for fly og helikoptre. De utfører funksjonstester for komponenter og deler av fly for å diagnostisere egnethet for bruk og mulige justeringer som kan utføres for å forbedre ytelsen. De tolker og hjelper til med å forstå produsenters tekniske spesifikasjoner for bruk ved flyplassen."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7232> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/7d599049-d15a-4fda-afe9-b334b0614ec7> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7232.3" ;
    skos:prefLabel "flymekaniker, ettersyn av gassturbinmotorer"@nb ;
    skos:definition "Flymekanikere, ettersyn av gassturbinmotorer utfører overhalings-, vedlikeholds- og reparasjonsarbeid på gassturbinmotorer. De demonterer, kontrollerer, rengjør, reparerer og monterer motorene ved hjelp av motorspesifikk verktøy."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7232> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/b27854dd-3fbe-406e-a750-54f677d55936> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7232.4" ;
    skos:prefLabel "flyvedlikeholdskoordinator"@nb ;
    skos:definition "Flyvedlikeholdskoordinatorer planlegger og administrerer klargjørings- og vedlikeholdsarbeidene i hangarene og verkstedene. De kommuniserer med ledere på høyere nivå for å klargjøre de nødvendige ressursene for problemfri og effektiv drift på flyplasser."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7232> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/91373a70-79b6-47a2-aa50-07dfe20dd258> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7232.5" ;
    skos:prefLabel "flyvedlikeholdstekniker"@nb ;
    skos:definition "Flyvedlikeholdsteknikere utfører forebyggende vedlikehold på fly, flykomponenter, motorer og komponentgrupper som flyskrog og hydrauliske og pneumatiske systemer. De utfører inspeksjoner i henhold til strenge retningslinjer og luftfartslover."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7232> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/b0480558-269d-4903-9bc7-f390cd6a6964> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7233.1" ;
    skos:prefLabel "anleggsmaskinmekaniker"@nb ;
    skos:definition "Anleggsmaskinmekanikere kontrollerer, vedlikeholder og reparerer tunge kjøretøyer som brukes i bygg- og anlegg, skogbruk og jordarbeid, for eksempel bulldosere, gravemaskiner og hogstmaskiner. De kontrollerer utstyret, og sørger for at maskinene er trygge og fungerer effektivt og optimalt."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7233> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/955ae83a-4d91-4db8-a5d6-bd489e5058df> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7233.10" ;
    skos:prefLabel "mekaniker, gruveutstyr"@nb ;
    skos:definition "Mekanikere, gruveutstyr monterer, fjerner, vedlikeholder og reparerer gruveutstyr."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7233> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/5aff8b2a-298a-456d-957a-274c774e8523> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7233.11" ;
    skos:prefLabel "støpemaskintekniker"@nb ;
    skos:definition "Støpemaskinteknikere betjener maskiner som brukes til støping og forming av plast og andre materialer. De kalibrerer utstyret, utfører vedlikeholdsoppgaver, kontrollerer ferdige produkter og reparerer feil."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7233> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/53c7756d-4114-4c7f-90b0-26717f458ac5> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7233.12" ;
    skos:prefLabel "tekniker, trykkluftsystem"@nb ;
    skos:definition "Teknikere, trykkluftsystem bruker plantegninger og teknisk dokumentasjon for å sette sammen og montere utstyr som drives av gass eller luft under trykk. De klargjør systemene i henhold til tekniske spesifikasjoner og tester dem for å sikre at de fungerer slik de skal. De kan også utføre vedlikeholds- og reparasjonsarbeid på montert pneumatisk utstyr."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7233> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/24119471-6ca1-465b-8f48-b2aec5c60869> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7233.13" ;
    skos:prefLabel "mekaniker, roterende utstyr"@nb ;
    skos:definition "Mekanikere, roterende utstyr er ansvarlige for forebyggende og korrigerende vedlikeholdsoppgaver for roterende utstyr, for eksempel turbiner, kompressorer, motorer og pumper. De sørger for tilgjengeligheten og integriteten til installerte systemer og utstyr med hensyn til sikkerhet og pålitelighet."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7233> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/2aa7fbbb-f06e-4454-8ff8-2d799e86ba51> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7233.14" ;
    skos:prefLabel "tekstilmaskintekniker"@nb ;
    skos:definition "Tekstilmaskinteknikere klargjør, vedlikeholder, kontrollerer og reparerer mekaniske og datastyrte maskiner som brukes i tekstilproduksjon, for eksempel veve-, farge- og appreturmaskiner."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7233> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/d051a141-92cd-4800-b0ee-6c8c31ea5838> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7233.2" ;
    skos:prefLabel "kranmontør"@nb ;
    skos:definition "Kranmontører monterer komponenter for industri- og havnekraner. De monterer belter og kontrollenheter. Kranmontører utfører sluttmonteringen på stedet, og vedlikeholder og reparerer kraner."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7233> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/6b46ea2f-403a-473c-b2e5-9fcf0c2bd634> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7233.3" ;
    skos:prefLabel "maskinassistent innen fiskeri"@nb ;
    skos:definition "Maskinassistenter innen fiskeri hjelper førstemaskinisten med å kontrollere driften og vedlikeholdet av skipets fremdriftsanlegg, maskineri og hjelpeutstyr. De samarbeider om sikkerhet, overlevelse og helsehjelp om bord, og overholder gjeldende nasjonale og internasjonale standarder."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7233> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/0b6e1a0d-63fe-42d4-8dff-2ff187a9fea9> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7233.4" ;
    skos:prefLabel "tekniker, hydraulikk"@nb ;
    skos:definition "Teknikere, hydraulikk monterer og setter sammen utstyr som bruker væske- eller gasstrykk for å overføre eller regulere kraft. De utfører også tester på og vedlikeholder dette utstyret."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7233> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/599c2ce9-0e1b-4f63-9d65-1f19b3847efb> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7233.5" ;
    skos:prefLabel "tekniker, smimaskiner"@nb ;
    skos:definition "Teknikere, smimaskiner vedlikeholder og reparerer smimaskiner, for eksempel presser og materialhåndteringsutstyr. De kontrollerer utstyret, utfører forebyggende vedlikeholdsoppgaver og reparerer feil. De hjelper også med å montere utstyret og sørger for at det fungerer slik det skal."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7233> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/23eddde2-5e8b-4953-b275-cdc864e6d976> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7233.6" ;
    skos:prefLabel "maskinsmører"@nb ;
    skos:definition "Maskinsmørere sørger for at industrimaskiner er riktig smurt for å opprettholde driften. De bruker fettpistoler for å smøre maskiner. Maskinsmørere utfører også grunnleggende vedlikeholds- og reparasjonsoppgaver."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7233> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/269c47e7-9017-4aa6-bce8-49e89a696a64> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7233.7" ;
    skos:prefLabel "industrimekaniker"@nb ;
    skos:definition "Industrimekanikere jobber med nye maskiner og utstyr i drift. De klargjør for den spesifikke bruken, lager tilbehør ved behov, utfører vedlikehold og reparasjon og diagnostiserer for å finne feil i systemer eller deler som må skiftes ut."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7233> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/00c8d1cf-24f2-47d1-9f10-765e1c102811> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7233.8" ;
    skos:prefLabel "tekniker, landbruksmaskiner"@nb ;
    skos:definition "tekniker, landbruksmaskiner vedlikeholder, overhaler og reparerer landbruksutstyr og -maskiner."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7233> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/f7145f87-5940-43f5-bc98-aa1a2b872b47> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7233.8.1" ;
    skos:prefLabel "tekniker, landbruksutstyr"@nb ;
    skos:definition "Teknikere, landbruksutstyr reparerer, overhaler og vedlikeholder landbruksutstyr, inkludert traktorer, utstyr for jordbearbeiding, såmaskiner og innhøstingsutstyr. De kontrollerer utstyret, utfører forebyggende vedlikeholdsoppgaver og reparerer feil."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/00c8d1cf-24f2-47d1-9f10-765e1c102811> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/f49d893a-ac89-4f3b-b547-1cbdf4d69fde> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7233.8.2" ;
    skos:prefLabel "tekniker for skogbruksmaskiner"@nb ;
    skos:definition "Teknikere for skogbruksmaskiner vedlikeholder og transporterer skogsmaskiner. Som en del av vedlikeholdet av skogsmaskiner bruker de spesialprogramvare og dataregistreringssystemer og -instrumenter."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/00c8d1cf-24f2-47d1-9f10-765e1c102811> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/88589d68-b870-440e-8444-32e9935cbbbc> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7233.9" ;
    skos:prefLabel "skipsmekaniker"@nb ;
    skos:definition "Skipsmekanikere har ansvaret for motorene og mekaniske deler på fartøyet og skifter ut defekt utstyr og deler. De kommuniserer med andre besetningsmedlemmer på driftsnivå. Skipsmekanikere vedlikeholder og reparerer motorer og annet maskineri på fartøyer, for eksempel kjeler, generatorer og elektrisk utstyr."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7233> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/336cf331-8082-4a0c-bf5f-e7c54706211c> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7234.1" ;
    skos:prefLabel "sykkelreparatør"@nb ;
    skos:definition "Sykkelreparatører vedlikeholder og reparerer en rekke sykkelmodeller og -komponenter. De kan utføre tilpassede endringer i henhold til kundens preferanser."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7234> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/11eb55d3-4dbe-45c5-a6ce-f04ae843c938> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7311.1" ;
    skos:prefLabel "urmaker"@nb ;
    skos:definition "Urmakere lager mekaniske eller elektroniske klokker ved hjelp av presisjonshåndverktøy eller automatiserte maskiner. Urmakere kan også reparere klokker. De kan jobbe i verksteder eller fabrikker."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7311> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/15d5636f-7714-4697-850a-67b7f7cb3837> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7311.2" ;
    skos:prefLabel "montør av optiske instrumenter"@nb ;
    skos:definition "Montører av optiske instrumenter leser plantegninger og monteringstegninger for å montere linser og optiske instrumenter, for eksempel mikroskoper, teleskoper, projeksjonsutstyr og medisinsk diagnostikkutstyr. De behandler, sliper, polerer og påfører belegg på glassmaterialer, og sentrerer linser i henhold til den optiske aksen, og fester dem til det optiske rammeverket. De kan teste instrumentene etter montering."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7311> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/2ada3e89-9159-49e7-88f7-4dd435fd95ac> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7311.3" ;
    skos:prefLabel "reparatør av optiske instrumenter"@nb ;
    skos:definition "Reparatører av optiske instrumenter reparerer optiske instrumenter, for eksempel mikroskoper, teleskoper, kameraoptikk og kompasser. De tester instrumentene for å sikre at de fungerer slik de skal. I militær sammenheng leser de også plantegninger for å kunne reparere instrumentene."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7311> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/dec7ed73-8688-4328-bc50-c72d31b25956> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7311.4" ;
    skos:prefLabel "montør av presisjonsinstrumenter"@nb ;
    skos:definition "Montører av presisjonsinstrumenter leser plantegninger og monteringstegninger for å sette sammen presisjonsinstrumenter, for eksempel mikrometere, målere, termostater og bruksmålere. De samler de forskjellige komponentene og setter dem sammen ved hjelp av håndverktøy eller maskiner. I tillegg kalibrerer de instrumentene og tester presisjonen."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7311> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/bca063d2-a904-45db-b3f4-0fd7e681753e> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7311.5" ;
    skos:prefLabel "mekaniker, kirurgiske instrumenter"@nb ;
    skos:definition "Mekanikere, kirurgiske instrumenter lager, reparerer og designer kirurgiske instrumenter, for eksempel klemmer, tenger, mekaniske kniver, skop, sonder og andre kirurgiske instrumenter."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7311> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/1a953e5a-f53f-461d-818b-6b2e655a751f> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7311.6" ;
    skos:prefLabel "klokkereparatør"@nb ;
    skos:definition "Klokkereparatører vedlikeholder og reparerer armbåndsur og klokker. De identifiserer feil, skifter batterier, monterer nye remmer, smører og skifter ut skadede deler. De kan også restaurere antikke klokker."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7311> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/f569145d-8f87-4f80-b861-45583430d9f4> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7312.1" ;
    skos:prefLabel "musikkinstrumentmaker, idiofoninstrumenter"@nb ;
    skos:definition "Musikkinstrumentmakere, idiofoninstrumenter lager og setter sammen deler for å lage idiofoninstrumenter i henhold til spesifiserte instruksjoner eller diagrammer. De former, borer, sliper og strenger delene, som stort sett er laget av glass, metall, keramikk eller tre, rengjør, tester kvaliteten og kontrollerer det ferdige instrumentet."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7312> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/72f4abfe-5337-49be-b9b8-32096fc2ca1f> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7312.2" ;
    skos:prefLabel "intrumenttekniker"@nb ;
    skos:definition "Instrumentteknikere hjelper og støtter musikere før, under og etter forestillingen for å sikre at instrumentene og det tilkoblede utstyret, backline, er riktig klargjort. De vedlikeholder, kontrollerer, stemmer og reparerer instrumenter og hjelper til med raske skifter."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7312> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/c644e6f6-dffc-4d7a-bf36-a384e465937b> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7312.3" ;
    skos:prefLabel "musikkinstrumentmaker, tangentinstrumenter"@nb ;
    skos:definition "Musikkinstrumentmakere, tangentinstrumenter lager og setter sammen deler for å lage tangentinstrumenter i henhold til spesifiserte instruksjoner eller diagrammer. De sliper tre, finstemmer, tester og kontrollerer det ferdige instrumentet."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7312> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/19c2d8bc-aa3d-4b72-b55a-50bf751873fe> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7312.3.1" ;
    skos:prefLabel "chembalobygger"@nb ;
    skos:definition "Cembalobyggere lager og setter sammen deler for å lage cembaloer i henhold til spesifiserte instruksjoner eller diagrammer. De sliper tre, finstemmer, tester og kontrollerer det ferdige instrumentet."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/c644e6f6-dffc-4d7a-bf36-a384e465937b> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/c7b31477-88e3-400f-988f-3baa090de173> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7312.3.2" ;
    skos:prefLabel "orgelbygger"@nb ;
    skos:definition "Orgelbyggere lager og setter sammen deler for å lage orgler i henhold til spesifiserte instruksjoner eller diagrammer. De sliper tre, finstemmer, tester og kontrollerer det ferdige instrumentet."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/c644e6f6-dffc-4d7a-bf36-a384e465937b> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/97dd9a0c-dd6b-416d-9537-655a08dd2895> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7312.3.3" ;
    skos:prefLabel "pianobygger"@nb ;
    skos:definition "Pianobyggere lager og setter sammen deler for å lage pianoer i henhold til spesifiserte instruksjoner eller diagrammer. De sliper tre, finstemmer, tester og kontrollerer det ferdige instrumentet."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/c644e6f6-dffc-4d7a-bf36-a384e465937b> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/b558a934-9308-48fc-b03b-bea8e23ab085> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7312.4" ;
    skos:prefLabel "musikkinstrumentmaker, membranofoninstrumenter"@nb ;
    skos:definition "Musikkinstrumentmakere, membranofoninstrumenter lager og setter sammen deler for å lage membranofoninstrumenter i henhold til spesifiserte instruksjoner eller diagrammer. De strekker og fester membranen til instrumentrammen, tester kvaliteten og kontrollerer det ferdige instrumentet."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7312> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/3c1b7871-87f9-427b-adcb-fe16be8f9f24> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7312.5" ;
    skos:prefLabel "musikkinstrumenttekniker"@nb ;
    skos:definition "Musikinstrumentteknikere vedlikeholder, stemmer og reparerer musikkinstrumenter, for eksempel pianoer, orgler, orkesterinstrumenter, fioliner og andre instrumenter."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7312> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/0a94df75-6e31-4277-a326-1b01e56b6cb3> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7312.6" ;
    skos:prefLabel "musikkinstrumentmaker, strengeinstrumenter"@nb ;
    skos:definition "Musikkinstrumentmakere, strengeinstrumenter lager og setter sammen deler for å lage strengeinstrumenter i henhold til spesifiserte instruksjoner eller diagrammer. De sliper tre, måler og fester strenger, tester kvaliteten på strengene og kontrollerer det ferdige instrumentet."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7312> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/82ea66b0-0f9c-44ed-94bc-0c5b829531b3> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7312.6.1" ;
    skos:prefLabel "gitarbygger"@nb ;
    skos:definition "Gitarbyggere lager og setter sammen deler for å lage gitarer i henhold til spesifiserte instruksjoner eller diagrammer. De bearbeider tre, måler og fester strenger, tester kvaliteten på strengene og kontrollerer det ferdige instrumentet."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/0a94df75-6e31-4277-a326-1b01e56b6cb3> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/bd55e8d7-8bdf-4179-a84b-ed43073f05a1> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7312.6.2" ;
    skos:prefLabel "harpebygger"@nb ;
    skos:definition "Harpebyggere lager og setter sammen deler for å lage harper i henhold til spesifiserte instruksjoner eller diagrammer. De sliper tre, måler og fester strenger, tester kvaliteten på strengene og kontrollerer det ferdige instrumentet."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/0a94df75-6e31-4277-a326-1b01e56b6cb3> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/d0c923f1-e32b-4838-a109-eac58945dab1> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7312.6.3" ;
    skos:prefLabel "fiolinbygger"@nb ;
    skos:definition "Fiolinbyggere lager og setter sammen deler for å lage fioliner i henhold til spesifiserte instruksjoner eller diagrammer. De sliper tre, måler og fester strenger, tester kvaliteten på strengene og kontrollerer det ferdige instrumentet."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/0a94df75-6e31-4277-a326-1b01e56b6cb3> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/f96e3735-405c-4ca9-8a86-d37f64ea7164> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7312.7" ;
    skos:prefLabel "musikkinstrumentmaker, blåseinstrumenter"@nb ;
    skos:definition "Musikkinstrumentmakere, blåseinstrumenter lager og setter sammen deler for å lage blåseinstrumenter i henhold til spesifiserte instruksjoner eller diagrammer. De måler og skjærer til rørene til resonatoren, setter sammen deler som støtter, sleider, ventiler, klokker og munnstykker, og tester og kontrollerer det ferdige instrumentet."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7312> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/618a854a-4ecd-4535-84e6-350e1fe0aa0f> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7313.1" ;
    skos:prefLabel "juveler"@nb ;
    skos:definition "Juvelerer lager og reparerer forskjellige smykkegjenstander. De lager modeller av voks eller metall til voksutsmeltningsprosessen. De kan utføre støpeprosessen (der man plasserer voksmodellen i støperingen, lager støpeformer og heller smeltet metall i støpeformen, eller støper artikkelen ved hjelp av en sentrifugalstøpemaskin). Juvelerer skjærer også til, sager og filer smykkedeler med ulike verktøy og lodder dem sammen med loddelampe, før de polerer artikkelen."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7313> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/103aaf7a-48da-4e25-99fc-5cf1ee1388b1> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7313.1.1" ;
    skos:prefLabel "filigranssølvsmed"@nb ;
    skos:definition "Filigransarbeidere lager filigran, dvs. fine gull- og sølvarbeider. De lodder sammen små perler eller tvunne tråder, eller begge deler, på overflaten av en gjenstand i samme metall, arrangert i et kunstnerisk motiv."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/618a854a-4ecd-4535-84e6-350e1fe0aa0f> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/8a007cd3-ba40-4c55-b238-587bd59e74b2> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7313.1.2" ;
    skos:prefLabel "gullsmed"@nb ;
    skos:definition "Gullsmeder designer, lager og selger smykker. De justerer, reparerer og gir prisvurdering av perler og smykker for kunder ved hjelp av sin erfaring med bearbeiding av gull og andre edle metaller."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/618a854a-4ecd-4535-84e6-350e1fe0aa0f> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/375137f7-5fc2-424e-9f63-d7ff4441c11e> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7313.1.3" ;
    skos:prefLabel "smykkegravør"@nb ;
    skos:definition "Smykkegravører graverer bokstaver og pryddesign på smykkegjenstander ved hjelp av håndverktøy for gravering. De tegner og plasserer bokstaver og design på gjenstanden, risser inn designen i artikkelen og fjerner overflødig materiale."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/618a854a-4ecd-4535-84e6-350e1fe0aa0f> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/7706342e-c07b-41d3-bc2e-e5c6e96f016f> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7313.1.4" ;
    skos:prefLabel "fremstiller av smykkeinnfatninger"@nb ;
    skos:definition "Fremstillere av smykkeinnfatninger lager smykkeinnfatninger, som edelstenene monteres på senere."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/618a854a-4ecd-4535-84e6-350e1fe0aa0f> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/e44d2570-10cc-4984-9692-63ece1b6dce8> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7313.1.5" ;
    skos:prefLabel "smykkepolerer"@nb ;
    skos:definition "Smykkepolerere sørger for at ferdige smykker rengjøres i henhold til kundens behov, eller klargjøres for salg. De kan også utføre mindre reparasjoner. De bruker håndverktøy, for eksempel filer og poleringspinner med smergelpapir og/eller håndholdte poleringsmaskiner. De bruker også trommelpolerere og andre mekaniserte poleringsmaskiner."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/618a854a-4ecd-4535-84e6-350e1fe0aa0f> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/dc52966e-72db-4ad0-b3a9-5e17f1311ab8> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7313.1.6" ;
    skos:prefLabel "smykkereparatør"@nb ;
    skos:definition "Smykkereparatører bruker spesialhåndverktøy for å utføre justeringer og reparasjoner av alle typer smykker. De endrer størrelse på ringer eller halskjeder, remonterer perler og reparerer ødelagte smykkedeler. Smykkereparatører finner ut hvilke edelmetaller som er egnet som erstatning, lodder og glatter ut sammenføyninger. De rengjør og polerer de reparerte smykkene som skal returneres til kunden."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/618a854a-4ecd-4535-84e6-350e1fe0aa0f> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/6729aa5a-285f-4baf-a466-c2ccd2f2d96f> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7313.1.7" ;
    skos:prefLabel "edelstenmontør"@nb ;
    skos:definition "Edelstenmontører bruker verktøy for å montere diamanter og andre edelstener på smykker, i henhold til spesifikasjoner. Hvordan edelstenen settes inn, avhenger av stenens størrelse og form."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/618a854a-4ecd-4535-84e6-350e1fe0aa0f> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/eb64b583-20fe-467f-8e44-8aae263a0139> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7313.1.8" ;
    skos:prefLabel "sølvsmed"@nb ;
    skos:definition "Sølvsmeder designer, lager og selger smykker. De justerer, reparerer og gir prisvurdering av edelstener og smykker. Sølvsmeder er spesialister på å jobbe med sølv og andre edle metaller."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/618a854a-4ecd-4535-84e6-350e1fe0aa0f> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/73bcde7c-bc34-485d-a7af-7b94fc43f61b> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7313.2" ;
    skos:prefLabel "edelstensliper"@nb ;
    skos:definition "Edelstenslipere skjærer til eller sliper diamanter og andre edelstener med skjæremaskiner og -verktøy i henhold til diagrammer, mønstre og spesifikasjoner. De er eksperter på å produsere smykker som ringer, brosjer, kjeder og armbånd av edelstener."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7313> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/149062d6-6496-4004-9c23-93c78b29b5db> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7314.1" ;
    skos:prefLabel "håndformer, murstein"@nb ;
    skos:definition "håndformer, murstein lager unike murstein, rør og andre varmebestandige produkter ved hjelp av håndformingsverktøy. De lager støpeformer i henhold til spesifikasjoner, rengjør og smører dem, setter inn og fjerner blandingen fra støpeformen. Deretter lar de mursteinene tørke i ovn før de ferdigstiller og jevner sluttproduktene."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7314> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/97896345-d102-4549-97a5-8851979e6938> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7314.2" ;
    skos:prefLabel "keramiker"@nb ;
    skos:definition "Keramikere lager keramiske produkter av forskjellige slag ved å behandle og forme leire, for hånd eller med dreieskive, og deretter brenne leiren i ovn for å fjerne alt vannet i leiren."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7314> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/64a68a43-24be-4929-95ce-5b14617199d1> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7315.1" ;
    skos:prefLabel "glassblåser"@nb ;
    skos:definition "Glassblåsere designer, produserer og dekorerer glassgjenstander, for eksempel glassmalerier, speil og arkitektonisk glass. Noen glassblåsere er spesialister på restaurering, renovering og reparasjon av originalgjenstander. De kan også arbeide som vitenskapelige glassblåsere som designer og reparere laboratorieglass."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7315> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/c9f6c245-8c66-4b13-9253-9835194abb23> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7315.2" ;
    skos:prefLabel "glassarbeider"@nb ;
    skos:definition "Glassarbeidere måler, skjærer til, setter sammen og monterer flatt glass og speil. De laster og losser også glass, speil og utstyr, kjører til monteringssteder, monterer rammer av metall eller tre som skal utstyres med glass, og arbeider i henhold til kundens spesifikasjoner."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7315> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/41a51397-089d-459d-9b7e-f1cdee5ad6bb> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7316.1" ;
    skos:prefLabel "dekormaler"@nb ;
    skos:definition "Dekormalere designer og lager visuell kunst på forskjellige typer overflater, for eksempel keramikk, kabinetter, glass og stoff. De bruker diverse materialer og en rekke teknikker for å lage dekorative illustrasjoner, fra sjablongtrykk til frihåndstegning."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7316> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/02e94cd6-8e6d-4e9b-b695-edb460c70528> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7316.1.1" ;
    skos:prefLabel "keramikkmaler"@nb ;
    skos:definition "Keramikkmalere designer og lager visuell kunst på keramikkoverflater og -gjenstander, for eksempel fliser, skulpturer, servise og keramikk. De bruker en rekke teknikker for å lage dekorative illustrasjoner, fra sjablongtrykk til frihåndstegning."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/41a51397-089d-459d-9b7e-f1cdee5ad6bb> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/6d16c41d-81a7-44a9-836d-7aed46ccb955> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7316.1.2" ;
    skos:prefLabel "glassmaler"@nb ;
    skos:definition "Glassmalere designer og lager visuell kunst på glass- eller krystalloverflater og -gjenstander, for eksempel vinduer, drikkeglass og flasker. De bruker en rekke teknikker for å lage dekorative illustrasjoner, fra sjablongtrykk til frihåndstegning."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/41a51397-089d-459d-9b7e-f1cdee5ad6bb> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/db3b1cb9-8460-4de0-8fc7-aff7a9a74b7e> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7316.1.3" ;
    skos:prefLabel "porselensmaler"@nb ;
    skos:definition "Porselensmalere designer og lager visuell kunst på porselensoverflater og -gjenstander, for eksempel fliser og keramikk. De bruker en rekke teknikker for å lage dekorative illustrasjoner, fra sjablongtrykk til frihåndstegning."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/41a51397-089d-459d-9b7e-f1cdee5ad6bb> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/96186698-f79d-423a-9652-a2a58085d5f1> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7316.1.4" ;
    skos:prefLabel "tremaler"@nb ;
    skos:definition "Tremalere designer og lager visuell kunst på treoverflater og -gjenstander, for eksempel møbler, figurer og leker. De bruker en rekke teknikker for å lage dekorative illustrasjoner, fra sjablongtrykk til frihåndstegning."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/41a51397-089d-459d-9b7e-f1cdee5ad6bb> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/3a55bf97-a0d2-47a0-a8b3-b248d32c7969> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7316.2" ;
    skos:prefLabel "glassgravør"@nb ;
    skos:definition "Glassgravører graverer bokstaver og pryddesign på glassartikler ved hjelp av håndverktøy for gravering. De tegner og plasserer bokstaver og design på gjenstanden, skjærer ut designet i gjenstanden og ferdigstiller gjenstanden."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7316> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/8b2d562c-8407-49cd-9843-636c352b8c82> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7316.3" ;
    skos:prefLabel "metallgravør"@nb ;
    skos:definition "Metallgravører graverer et design på en metalloverflate ved å skjære ut spor i den, vanligvis til dekorative formål. Dette kan også utføres på våpen av metall. For å skjære ut designet i overflaten bruker de gravstikker og andre verktøy."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7316> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/a1b4eb5e-45d4-441b-a7e8-795ac5cf6fbf> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7316.4" ;
    skos:prefLabel "skiltmaker"@nb ;
    skos:definition "Skiltmakere designer og lager skilt for en rekke bruksområder, for eksempel bannere, trafikkskilt, reklametavler og skilt for virksomheter. De bruker forskjellige materialer og teknikker, og om nødvendig monterer de skiltet på stedet. I tillegg utfører de også vedlikehold og reparasjoner."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7316> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/9efbe0de-37c0-4cc2-a1e6-a916eb4ecaa2> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7317.1" ;
    skos:prefLabel "papirmaker"@nb ;
    skos:definition "Papirmakere lager en papirmasse, frasiler vannet på en duk, og tørker massen manuelt eller med småskalautstyr."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7317> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/b07e291d-1ea0-44d6-861c-e2c36861f9e3> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7317.2" ;
    skos:prefLabel "kurvmaker"@nb ;
    skos:definition "Kurvmakere bruker stive fibre for manuelt å veve gjenstander, for eksempel beholdere, kurver, matter og møbler. De bruker forskjellige tradisjonelle teknikker og materialer i henhold til regionen og tiltenkt bruk av gjenstanden."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7317> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/9c57263e-a38f-4c45-9265-a3c3e7cc2c5c> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7317.3" ;
    skos:prefLabel "børstemaker"@nb ;
    skos:definition "Børstebindere lager børster ved å sette materialer av ulike slag, som hestehår, vegetabilske fibre, nylon og grisebust inn i en hylse av metall. De former børstehodet ved å sette en plugg av tre eller aluminium inn i busten og fester skaftet til den andre siden av hylsen. De dypper børstehodet i et beskyttelsesmiddel slik at det beholder formen, utfører sluttbehandling på produktet, og kontrollerer det endelige produktet."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7317> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/5e29c263-a3ca-4220-b67e-ee65205db294> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7317.4" ;
    skos:prefLabel "leketøymaker"@nb ;
    skos:definition "Leketøymakere lager eller reproduserer håndlagde gjenstander for salg og utstilling, som er laget av forskjellige materialer, for eksempel plast, tre og tekstil. De utvikler, designer og skisserer gjenstanden, velger materialene og skjærer ut, former og bearbeider materialene etter behov, og påfører finish. I tillegg vedlikeholder og reparerer leketøymakere alle typer leker, inkludert mekaniske. De identifiserer feil i leker, skifter skadede deler og får dem til å fungere igjen."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7317> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/949bccd9-e1d2-4c57-b787-53b451aa1354> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7317.5" ;
    skos:prefLabel "kurvmøbelmaker"@nb ;
    skos:definition "Kurvmøbelmakere velger og klargjør materialer, for eksempel mykgjort rotting eller pilgrener, for å lage kurvmøbler, for eksempel stoler, bord og sofaer. De bruker hånd-, kraft- eller maskinverktøy for å skjære, bøye og veve materialer for å lage de ønskede objektene. Til slutt behandler de overflaten for å få et ferdig utseende, og beskytter den mot korrosjon og brann ved bruk av voks, lakk og andre belegg."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7317> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/b9d03330-c71c-4827-8797-3e96249d54db> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7317.6" ;
    skos:prefLabel "treskjærer"@nb ;
    skos:definition "Treskjærere former trevirke manuelt til ønsket form ved hjelp av utstyr som kniver, huljern og meisler. Treskjærere lager treprodukter som skal fungere som dekorasjon, som skal integreres i et sammensatt produkt, for eksempel redskaper eller leker."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7317> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/8b97d85f-4a7a-4908-aa72-9c947c0cb0cd> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7318.1" ;
    skos:prefLabel "teppemaker"@nb ;
    skos:definition "Teppemakere bruker håndverksteknikker for å lage tekstilgulvbelegg. De lager tepper og matter av ull eller andre tekstiler, ved bruk av tradisjonelle håndverksteknikker. De kan bruke forskjellige metoder, for eksempel veving, knytting eller tufting for å lage tepper i forskjellige stiler."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7318> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/b3cd0522-14a9-4e21-a7ee-c9a1f9c0de51> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7318.2" ;
    skos:prefLabel "teppevever"@nb ;
    skos:definition "Teppevevere bruker maskiner for å lage tekstilgulvbelegg. De lager tepper og matter av ull eller syntetiske tekstiler, ved bruk av spesialutstyr. Teppevevere bruker forskjellige metoder, for eksempel veving, knytting eller tufting for å lage tepper i forskjellige stiler."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7318> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/ebff4fcf-6b69-4290-a55c-9bfe4cc7a1ef> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7318.3" ;
    skos:prefLabel "garnbinder"@nb ;
    skos:definition "Garnbindere lager og setter sammen fiskenettutstyr og utfører reparasjon og vedlikehold, som anvist av tegningene og/eller tradisjonelle metoder."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7318> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/3562e70c-016c-455c-b949-521a367418a5> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7318.4" ;
    skos:prefLabel "strikker"@nb ;
    skos:definition "Strikkere lager tekstiler eller stoff ved å strikke garnbiter. De bruker tradisjonelle teknikker for å lage sammenhengende løkker av garn som danner et ensartet stykke stoff. Strikkere bruker forskjellige teknikker, nåler og garnmaterialer for å lage strikkede materialer med forskjellige proporsjoner."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7318> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/72d03aad-2003-404e-ae71-a37206e3566b> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7318.5" ;
    skos:prefLabel "skinnbereder"@nb ;
    skos:definition "Skinnberedere produserer lærvarer eller deler av lærvarer for hånd i henhold til spesifikasjonene til kunden eller eget design. De reparerer lærvarer, for eksempel sko, vesker og hansker."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7318> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/02375132-3290-4221-bf55-d93ec61a3bf3> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7318.6" ;
    skos:prefLabel "vever"@nb ;
    skos:definition "Vevere utfører vevingsprosessen på tradisjonelle hånddrevne vevemaskiner (fra silke til teppe, fra flat til jacquard). De fører oppsyn med stoffkvalitet og tilstanden til maskiner, for eksempel vevde stoffer til klær, tekstiler til hjemmebruk eller teknisk bruk. De utfører mekanisk arbeid på maskiner som omdanner garn til stoffer, for eksempel pledd, tepper, håndklær og klær. De reparerer vevstolfeil som veveren rapporterer, og fyller ut kontrollskjemaer for vevstoler."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7318> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/e148e1ed-4f46-40a7-95c9-d6914f664f17> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7319.1" ;
    skos:prefLabel "lysstøper"@nb ;
    skos:definition "Lysstøpere lager stearinlys ved å plassere veken midt i formen og fylle formen med voks for hånd eller med maskin. De fjerner stearinlyset fra formen, skraper bort overflødig voks og kontrollerer lyset for eventuelle ujevnheter."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7319> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/1d70e660-1114-41c6-926a-053541460d88> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7319.2" ;
    skos:prefLabel "reparatør av sportsutstyr"@nb ;
    skos:definition "Reparatører av sportsutstyr vedlikeholder og reparerer fritidsutstyr, for eksempel tennisracketer, bueskytingsverktøy og campingutstyr. De bruker spesialhåndverktøy eller mekaniske verktøy for å reparere skadede deler."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7319> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/54ffd31f-ed90-4af4-b877-cd246351ad39> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7321.1" ;
    skos:prefLabel "førtrykkstekniker"@nb ;
    skos:definition "Førtrykksteknikere klargjør trykkeprosesser ved å formatere, sette og komponere tekst og grafikk til en passende form. Prosessen omfatter kopiering og elektronisk behandling av tekst og bilde. De klargjør, vedlikeholder og feilsøker også trykkpresser."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7321> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/23e3a8a0-905a-45be-983f-4cf32e133e09> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7321.1.1" ;
    skos:prefLabel "fotosetter"@nb ;
    skos:definition "Fotosettere behandler bilder og grafiske maler ved å bruke fotosettemaskiner. De optimaliserer malene for best mulig resultat ved å bestemme riktig plassering av tekst og bilde på trykkearket. Produktet settes deretter på fotopapir eller film."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/54ffd31f-ed90-4af4-b877-cd246351ad39> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/ab4086a0-0e2f-436e-80f8-a3291e594bd1> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7321.1.2" ;
    skos:prefLabel "litograf"@nb ;
    skos:definition "Litografer lager og klargjør metallplater som skal brukes som original i forskjellige trykkeprosesser og -medier. Platene etses vanligvis med laser fra digitale kilder med datamaskin-til-plate-teknologi, men kan også lages ved å påføre forskjellige emulsjoner på trykkplaten."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/54ffd31f-ed90-4af4-b877-cd246351ad39> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/cf578f1d-1832-4a4d-a3b2-e0a00517b51d> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7321.1.3" ;
    skos:prefLabel "førtrykksoperatør"@nb ;
    skos:definition "Førtrykksoperatører lager et korrekturavtrykk, eller en prøve på hvordan det ferdige produktet vil se ut. I mange trykkekontrakter bestemmer klienten på dette stadiet om trykkingen kan utføres som planlagt. Siden trykkeprosessene for korrekturavtrykk er forskjellige fra dem som brukes i den endelige prosessen, er korrekturavtrykket alltid en tilnærming."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/54ffd31f-ed90-4af4-b877-cd246351ad39> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/cea4d5c9-7805-434a-8e6b-af5e9fa54c9e> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7321.1.4" ;
    skos:prefLabel "skanneroperatør"@nb ;
    skos:definition "Skanneoperatører betjener skannere. De mater utskriftsmateriale inn i maskinen og utfører innstillinger på maskinen eller på en kontrollerende datamaskin, for å få skanninger med høy oppløsning."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/54ffd31f-ed90-4af4-b877-cd246351ad39> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/f5596182-70b2-4c18-97ab-f9405bae0385> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7321.1.5" ;
    skos:prefLabel "tekniker, serigrafi"@nb ;
    skos:definition "Teknikere, serigrafi graverer eller etser sjablongene som brukes ved silketrykk."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/54ffd31f-ed90-4af4-b877-cd246351ad39> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/b09ffdec-b04c-41a8-bacc-2c71d7a3e5ac> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7321.1.6" ;
    skos:prefLabel "setter"@nb ;
    skos:definition "Settere sikrer at trykt tekst er riktig satt og visuelt behagelig. Mens typesetting opprinnelig ble utført manuelt og senere ble utført med teknikker som linotype og fotosetting, gjøres nesten all typesetting nå digitalt ved hjelp av designprogrammer eller spesialprogrammer for typesetting."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/54ffd31f-ed90-4af4-b877-cd246351ad39> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/6175b828-026d-4fb4-8be7-418394e1add0> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7322.1" ;
    skos:prefLabel "digitaltrykker"@nb ;
    skos:definition "Digitaltrykkere jobber med maskiner som skriver ut direkte til mediet uten en mellomliggende plate. Digitaltrykkere bruker vanligvis laser- eller blekkskriverteknologi for å skrive ut enkeltsider uten lange eller arbeidsintensive tekniske trinn mellom det ferdige digitale produktet og trykket."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7322> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/5b942a51-c9a2-4dc7-82cc-57451426cf4d> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7322.10" ;
    skos:prefLabel "tekstiltrykker"@nb ;
    skos:definition "Tekstiltrykkere utfører tekstiltrykkoperasjoner."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7322> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/07d4a2fa-e278-4f32-8cf9-9c01fc660369> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7322.2" ;
    skos:prefLabel "operatør, fleksotrykker"@nb ;
    skos:definition "Operatører, fleksotrykker bruker fleksografisk relieffplate for å trykke på nesten alle typer materiale. Relieffplaten påføres blekk og presses på materialet som skal trykkes."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7322> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/7fbe45c6-1914-43ba-9cfb-e0a4e051da92> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7322.3" ;
    skos:prefLabel "operatør av dyptrykker"@nb ;
    skos:definition "Operatører av dyptrykker arbeider med dyptrykkspresser, der bildet er gravert direkte på en rull. De klargjør pressen og fører tilsyn med den under driften, tar seg av sikkerheten og løser problemer."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7322> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/ad6589cb-ef1e-482d-863d-d80b2eb6b070> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7322.4" ;
    skos:prefLabel "operatør av varmfolietrykker"@nb ;
    skos:definition "Operatører av varmfolietrykker betjener maskiner som påfører en metallfolie på andre materialer ved bruk av trykksylindere og oppvarming. De blander også farger, klargjør riktig maskinutstyr og fører tilsyn med trykkingen."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7322> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/ea4aff10-4d20-4a2b-886b-299c2bd349f1> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7322.5" ;
    skos:prefLabel "offsettrykker"@nb ;
    skos:definition "Offsettrykkere trykker bilder ved hjelp av offsetmaskiner. Offsetmaskinen overfører et innfarget bilde fra trykkplaten til en gummiduk og deretter til overflaten som skal ha trykket."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7322> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/4f7e7482-39e7-4f3a-bf11-763620f4b8e0> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7322.6" ;
    skos:prefLabel "operatør av pregepresse"@nb ;
    skos:definition "Operatører av pregepresse bruker en presse for å heve eller fordype bestemte områder av mediet for å skape relieff på trykken. To matchende graverte former plasseres rundt papiret, og trykk påføres for å endre overflaten på materialet."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7322> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/32fcdc6f-1c8a-44e9-99b8-5519e4db4414> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7322.7" ;
    skos:prefLabel "prosesstekniker, tekstiltrykking"@nb ;
    skos:definition "Prosessteknikere, tekstiltrykking utfører operasjoner knyttet til klargjøring av trykkeprosessene."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7322> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/77de6c7d-27bf-4bc2-8c80-5d6f6d9811f4> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7322.8" ;
    skos:prefLabel "reprotekniker"@nb ;
    skos:definition "Reproteknikere er ansvarlige for hele eller deler av prosessen for reproduksjon av grafiske dokumenter ved hjelp av mekanisk drevne eller digitale verktøy, for eksempel fotografering, skanning eller digital utskrift. Disse aktivitetene utføres ofte for å holde arkiver eller andre strukturerte kataloger oppdaterte."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7322> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/a98f93a6-b1df-4759-88a9-3234f334afad> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7322.9" ;
    skos:prefLabel "serigraf"@nb ;
    skos:definition "Serigrafer betjener en presse som trykker blekk gjennom en duk. Industriell silketrykk brukes ofte til å trykke på materialer som det er vanskelige å bruke med andre prosesser, for eksempel stive plastflater."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7322> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/49b21ca8-04be-4912-a2f7-0170550e18fa> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7323.1" ;
    skos:prefLabel "operatører, bindemaskin"@nb ;
    skos:definition "operatører, bindemaskin betjener maskiner som binder inn papir med eller uten trykk ved hjelp av stifter, hyssing, lim eller andre bindemidler."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7323> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/7f35043b-ebb5-40bf-9974-46a29915f6bf> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7323.2" ;
    skos:prefLabel "maskinoperatør, symaskin for trådhefting"@nb ;
    skos:definition "Maskinoperatører, symaskin for trådhefting betjener en maskin som stifter papir sammen til en bokblokk. De kontrollerer at signaturer er satt inn på riktig måte, og at maskinen ikke kjører seg fast."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7323> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/2f1380b4-b76b-489c-a3a8-cd05ed6ad392> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7323.3" ;
    skos:prefLabel "bokbinder"@nb ;
    skos:definition "Bokbindere arbeider for å reparere og behandle bøker basert på en evaluering av deres estetiske, historiske og vitenskapelige egenskaper. De fastslår stabiliteten til boken og løser problemene med kjemisk og fysisk forringelse av den."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7323> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/c11e2b53-06f7-465f-9b5c-708016bc96f4> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7323.4" ;
    skos:prefLabel "papirfalser"@nb ;
    skos:definition "Papirfalsere betjener en maskin som bretter papir og papirbunter."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7323> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/4910419f-b4af-4f59-b544-9dbebc8a74f0> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7411.1" ;
    skos:prefLabel "elektriker"@nb ;
    skos:definition "Elektrikere monterer og reparerer elektriske kretser og ledningsanlegg. De installerer og vedlikeholder også elektrisk utstyr og maskiner. Dette arbeidet kan utføres både innendørs og utendørs, i nesten alle typer anlegg."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7411> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/33960bab-4423-4808-af6c-ec2b485dba41> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7411.1.1" ;
    skos:prefLabel "installasjonselektriker"@nb ;
    skos:definition "Installasjonselektrikere installerer og vedlikeholder strømkabler og annen elektrisk infrastruktur i bygninger. De sørger for at installert elektrisk utstyr er isolert og ikke utgjør noen brannfare. De forstår eksisterende situasjoner og gjør forbedringer hvis det er nødvendig."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/4910419f-b4af-4f59-b544-9dbebc8a74f0> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/5dbb9cf0-b226-402c-a295-2f42ef05ff8b> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7411.1.1.1" ;
    skos:prefLabel "elektriker, husholdningsinstallajoner og -apparater"@nb ;
    skos:definition "Elektrikere, husholdningsinstallasjoner og -apparater installerer og vedlikeholder elektrisk infrastruktur og husholdningsmaskiner i hjem og andre boligbygg. De utfører kontroller og reparerer defekte deler for å sikre effektiv drift."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/33960bab-4423-4808-af6c-ec2b485dba41> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/5df63943-f1bc-4438-90f1-92768a7a23c8> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7411.1.1.2" ;
    skos:prefLabel "industrielektriker"@nb ;
    skos:definition "Industrielektrikere installerer og vedlikeholder strømkabler og annen elektrisk infrastruktur i store industrielle og kommersielle bygninger. De kontrollerer og reparerer defekte deler av elektriske anlegg for å sikre effektiv drift."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/33960bab-4423-4808-af6c-ec2b485dba41> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/fddb7bd8-f176-4dc8-9d12-32b6072452c9> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7411.1.2" ;
    skos:prefLabel "installasjonstekniker, elektrisitetsmåler"@nb ;
    skos:definition "Installasjonsteknikere, elektrisitetsmåler installerer og vedlikeholder elektriske målesystemer i anlegg eller bygninger. De monterer utstyret i samsvar med lover og forskrifter og reparerer feil og andre problemer. De tester utstyret og gir råd om bruk og vedlikehold."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/4910419f-b4af-4f59-b544-9dbebc8a74f0> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/e859428d-6dbd-406b-bb2e-d5a0ae21df29> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7411.1.3" ;
    skos:prefLabel "installasjonstekniker, arrangement"@nb ;
    skos:definition "Installasjonsteknikere, arrangement monterer og demonterer midlertidige pålitelige elektriske anlegg for arrangementer. De jobber på steder uten tilgang til strømnettet og på steder med midlertidig tilgang til strøm. Arbeidet deres er basert på instruksjoner, planer og beregninger. De jobber både innendørs og utendørs. De samarbeider tett med teknisk mannskap og operatører."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/4910419f-b4af-4f59-b544-9dbebc8a74f0> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/75b63949-1b93-4bf2-a777-ccf978dc3e8a> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7411.1.4" ;
    skos:prefLabel "solenergitekniker"@nb ;
    skos:definition "Solenergiteknikere installerer og vedlikeholder anlegg som samler solenergi. De klargjør nødvendige fester, ofte på tak, installerer solcellepaneler og kobler dem til et elektronisk anlegg, inkludert en inverter for å koble solenergisystemene til strømnettet."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/4910419f-b4af-4f59-b544-9dbebc8a74f0> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/06bd6285-13ed-4ea7-90cc-e9638a0600a9> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7412.1" ;
    skos:prefLabel "tekniker, bilbatteri"@nb ;
    skos:definition "Teknikere, bilbatteri setter sammen, monterer, kontrollerer, vedlikeholder og reparerer batterier i motorkjøretøyer. De bruker elektrisk testutstyr for å kontrollere at det fungerer, etter monteringen. De evaluerer batterier for å fastslå type strømproblemer. De klargjør også gamle batterier for avhending."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7412> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/6188bf20-5cdb-4702-af72-2cb67ec39810> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7412.10" ;
    skos:prefLabel "vedlikeholdstekniker, fornøyelsespark"@nb ;
    skos:definition "Vedlikeholdsteknikere, fornøyelsespark jobber for å vedlikeholde og reparere attraksjoner i fornøyelsesparker. De må ha en omfattende teknisk kunnskap og har spesialkunnskap om attraksjonen de skal vedlikeholde. Vedlikeholdstekniker, fornøyelsespark fører vanligvis oversikt over vedlikehold og reparasjoner som er utført, i tillegg til oppetid og nedetid for hver enkelt attraksjon. Fokus på sikkerhet er svært viktig under vedlikehold og reparasjon av attraksjoner i fornøyelsesparker."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7412> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/fd86ebe1-bad4-4486-9b76-01a48030e49a> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7412.11" ;
    skos:prefLabel "elektriker, rullende materiell"@nb ;
    skos:definition "Elektrikere, rullende materiell installerer, vedlikeholder og reparerer elektriske og elektroniske anlegg i skinnekjøretøyer, for eksempel klimaanlegg, pærer, varmesystemer og elektrisk kabling. De bruker diagnostisk testutstyr for å kontrollere kjøretøy og finne feil. For å utføre reparasjonsarbeid bruker de håndverktøy og elektriske spesialinstrumenter og spesialmaskiner."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7412> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/98562ce3-9632-4226-b129-c67eb9c54f0f> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7412.12" ;
    skos:prefLabel "vindturbintekniker"@nb ;
    skos:definition "Vindturbinteknikere vedlikeholder og reparerer vindturbiner ved å utføre diagnostiske inspeksjoner, analysere feil og utføre reparasjonsoppgaver. De sikrer at vindturbinene fungerer i samsvar med lover og forskrifter, og hjelper vindingeniørene med bygging av vindturbiner. Vindturbinteknikere kan også teste og montere maskinvare- og programvarekomponenter for vindturbiner."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7412> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/6656337f-67eb-4f48-b1e4-ecccdfa44dd2> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7412.2" ;
    skos:prefLabel "bilelektriker"@nb ;
    skos:definition "Bilelektrikere installerer, vedlikeholder og reparerer elektriske og elektroniske anlegg i motorvogner, for eksempel klimaanlegg, pærer, radioer, varmesystemer, batterier, elektriske ledninger og alternatorer. De bruker diagnostisk testutstyr for å kontrollere kjøretøy og finne feil. For å utføre reparasjonsarbeid bruker de håndverktøy og elektriske spesialinstrumenter og spesialmaskiner."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7412> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/5d009d45-3bb9-4e33-8760-294f59adec8c> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7412.3" ;
    skos:prefLabel "elektromekaniker"@nb ;
    skos:definition "Elektromekanikere monterer, reparerer og vedlikeholder mekaniske og elektriske komponenter i maskiner, verktøy og utstyr. De tester elektriske deler for å sikre effektiv drift og utfører forbedringer i henhold til dette."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7412> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/8cf68522-dfc9-43c0-9f65-892703f4705e> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7412.4" ;
    skos:prefLabel "tekniker, lufthavnbelysning"@nb ;
    skos:definition "Teknikere, lufthavnbelysning kontrollerer og vedlikeholder flyplassenes lyssystemer. De registrerer funnene sine og utarbeider handlingene som skal utføres."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7412> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/f4eaff3d-f8d0-4a6a-aa90-76827c0fbada> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7412.5" ;
    skos:prefLabel "elektriker med spesialfelt innen reparasjon av husholdningsapparater"@nb ;
    skos:definition "Elektrikere med spesialfelt innen reparasjon av husholdningsapparater bruker elektrisk utstyr for å teste motstand eller spenning og for å identifisere feil på apparatene. De reparerer små og store elektriske eller gassdrevne husholdningsapparater som støvsugere, vaskemaskiner, oppvaskmaskiner, klimaanlegg og kjøleskap."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7412> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/f8d1bcf9-9ca1-408f-a713-7bdf28c400fd> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7412.6" ;
    skos:prefLabel "heisingeniør"@nb ;
    skos:definition "Heisingeniører monterer heiser i en klargjort heissjakt. De monterer støtteenhet, heisepumpe eller -motor, stempel eller kabel og mekanisme. Heisingeniører kobler til nødvendige elektroniske elementer for å fullføre installasjonen og tilkoblingen av heisstolen. De utfører også de nødvendige trinnene for å kontrollere og reparere heiser, sjakten og all tilhørende elektronikk. Heisingeniører sørger for at all kontroll og rapportering blir notert i en loggbok, og rapporterer til kunden om tilstanden til heisen det ble utført service på."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7412> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/9422c30d-c5ef-4fcc-a493-d67ee42189c0> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7412.7" ;
    skos:prefLabel "skipselektriker"@nb ;
    skos:definition "Skipselektrikere installerer, vedlikeholder og reparerer elektriske og elektroniske anlegg i fartøy, for eksempel klimaanlegg, pærer, radioer, varmesystemer, batterier, elektriske ledninger og alternatorer. De bruker diagnostisk testutstyr for å kontrollere fartøy og finne feil. For å utføre reparasjonsarbeid bruker de håndverktøy og elektriske spesialinstrumenter og spesialmaskiner."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7412> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/c07ab008-79c1-4516-8dcc-8289f797dc34> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7412.8" ;
    skos:prefLabel "gruveelektriker"@nb ;
    skos:definition "Gruveelektrikere installerer, vedlikeholder og reparerer elektrisk spesialutstyr for gruver ved å bruke sin kunnskap innen elektrisitet. De overvåker også strømforsyningen til gruven."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7412> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/8b8ae0a5-342c-43ae-b856-e1fea6fd6d1c> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7412.9" ;
    skos:prefLabel "reparatør av motordrevne verktøy"@nb ;
    skos:definition "Reparatører av motordrevne verktøy identifiserer feil og reparerer elektrisk drevet verktøy, for eksempel driller, motorsager, gressklippere og slipemaskiner. De demonterer, tester og skifter defekte deler i verktøy. Reparatør av motordrevne verktøy gir kunder råd om vedlikeholdsprodukter og -metoder for utstyret deres. De kan også selge slike produkter."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7412> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/c89afd9a-7dad-4bae-9315-5fcadd9ad8b6> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7413.1" ;
    skos:prefLabel "elinstallationstekniker"@nb ;
    skos:definition "Elinstallationsteknikere bygger og vedlikeholder systemer for overføring og fordeling av strøm. De vedlikeholder og reparerer kraftledninger i samsvar med sikkerhetsforskrifter."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7413> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/0c328e98-6e4e-4e96-b99c-56851e666ad0> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7413.1.1" ;
    skos:prefLabel "spleiser"@nb ;
    skos:definition "Spleisere bygger og vedlikeholder strømforsynings- og styrekabler i underjordiske rør og spor. De lager og reparerer også elektriske kabler som kobler kunder til strømnettet."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/c89afd9a-7dad-4bae-9315-5fcadd9ad8b6> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/7052fd94-f563-46a9-8e2d-cba6c20f3e71> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7413.1.2" ;
    skos:prefLabel "luftledningsmontør"@nb ;
    skos:definition "Luftledningsmontører bygger og vedlikeholder strømforsynings- og styrekabler i luftledninger. De lager og reparerer også elektriske kabler som kobler kunder til strømnettet."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/c89afd9a-7dad-4bae-9315-5fcadd9ad8b6> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/f2ee2cda-9d02-49c3-8280-da5892d0055b> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7413.1.3" ;
    skos:prefLabel "elektriker, gatelys"@nb ;
    skos:definition "Elektrikere, gatelys bygger og vedlikeholder systemer for overføring og fordeling av strøm til gatelys. De vedlikeholder, tester og reparerer gatelys i samsvar med sikkerhetsforskrifter."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/c89afd9a-7dad-4bae-9315-5fcadd9ad8b6> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/490d0c6f-0dc8-4825-9f17-207749fb1785> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7421.1" ;
    skos:prefLabel "servicetekniker for pengeautomater"@nb ;
    skos:definition "Serviceteknikere for pengeautomater monterer, diagnostiserer, vedlikeholder og reparerer pengeautomater. De drar til kundene sine og utfører tjenestene sine der. Serviceteknikere for pengeautomater bruker håndverktøy og programvare for å reparere feil på pengeautomater."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7421> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/d9ab0f3d-078d-42a7-a502-3e739e0aeff6> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7421.2" ;
    skos:prefLabel "flytekniker"@nb ;
    skos:definition "Flyteknikere installerer, tester, inspiserer og justerer elektrisk og elektronisk utstyr, for eksempel navigasjons-, kommunikasjons- og flykontrollsystemer i fly og romfartøy. De utfører vedlikeholds- og reparasjonsarbeid. De utfører funksjonelle tester, diagnostiserer problemer og retter feil."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7421> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/f8ab2e08-d14e-4938-a2cd-c04821556db7> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7421.3" ;
    skos:prefLabel "reparatør av forbrukerelektronikk"@nb ;
    skos:definition "Reparatører av forbrukerelektronikk bruker elektrisk utstyr til å diagnostisere feil og teste funksjonalitet til forbrukerelektronikk, for eksempel TV-er, video- og lydanlegg og digitale kameraer. De leser produsentens instruksjoner og utfører nødvendige reparasjoner eller utskiftninger."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7421> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/1d196f32-05ca-4ea5-a347-4fccbb3da863> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7421.4" ;
    skos:prefLabel "elektrotekniker, marinteknikk"@nb ;
    skos:definition "Elektroteknikere, marinteknikk legger, installerer og reparerer elektronisk anlegg og utstyr i fartøyer. De monterer elektroniske komponenter og ledninger i henhold til plantegninger og monteringstegninger."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7421> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/b493b10d-7131-4814-93bb-a2c1be4a095f> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7421.5" ;
    skos:prefLabel "servicetekniker, kontorutstyr"@nb ;
    skos:definition "Serviceteknikere, kontorutstyr tilbyr tjenester til virksomheter knyttet til installasjon, vedlikehold og reparasjon av nytt eller eksisterende utstyr, for eksempel som skrivere, skannere og modemer, i kundenes lokaler. De fører oversikt over utførte tjenester og returnerer utstyr til et reparasjonssenter om nødvendig."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7421> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/75c5bab4-2546-4ba3-996d-42a9a1bab55d> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7421.6" ;
    skos:prefLabel "elektrotekniker, jernbanesektoren"@nb ;
    skos:definition "Elektroteknikere, jernbanesektoren er ansvarlig for å installere, inspisere, teste og vedlikeholde togkontrollsystemer, radioanlegg, radarsystemer og elektroniske og elektromagnetiske komponenter."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7421> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/ecdc43f5-3b32-4f94-abf8-cd46480c8cb8> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7421.7" ;
    skos:prefLabel "elektronikkinstallatør, kjøretøy"@nb ;
    skos:definition "Elektronikkinstallatører, kjøretøy monterer utstyr og tilbehør i motorvogner, for eksempel CD-spillere og GPS-enheter. De bruker elektriske verktøy til å montere og undersøke defekte elektroniske anlegg."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7421> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/2ef000b1-8058-4e5a-9646-c5d4e7dbfdae> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7422.1" ;
    skos:prefLabel "ansvarlig for kommunikasjonsinfrastruktur"@nb ;
    skos:definition "Ansvarlige for kommunikasjonsinfrastruktur monterer, reparerer, drifter og vedlikeholder infrastruktur for kommunikasjonssystemer."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7422> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/b7aa4b4e-dbb6-4f58-b36c-35b9a7267972> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7422.2" ;
    skos:prefLabel "reparatør av maskinvare"@nb ;
    skos:definition "Reparatører av maskinvare installerer, undersøker, tester og reparerer maskinvare og eksterne komponenter. De tester datamaskinens funksjonalitet, identifiserer problemer og skifter skadede komponenter og deler."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7422> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/b37d15b3-402e-4792-8292-f18c0de7aca6> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7422.3" ;
    skos:prefLabel "tekniker for mobile enheter"@nb ;
    skos:definition "Teknikere for mobile enheter utfører riktig feildiagnose for å forbedre kvaliteten på mobile enheter og reparere dem. De gir informasjon knyttet til en rekke tjenester, inkludert garantier og ettersalgstjenester."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7422> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/f0f6d531-eb96-4bad-84ff-8e2999ea68e6> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7422.3.1" ;
    skos:prefLabel "mobiltelefonreparatør"@nb ;
    skos:definition "Mobiltelefonreparatører kjører tester for å vurdere mobiltelefonenes funksjonalitet, installerer og oppdaterer telefonprogramvare, feilsøker kablingsproblemer og skifter skadede deler og komponenter, for eksempel batterier, LCD-skjermer, tastaturer og knapper. De gir også kundene råd om garantispørsmål og anbefaler produkter basert på sin ekspertise."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/b37d15b3-402e-4792-8292-f18c0de7aca6> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/35efc04c-429a-407e-a00a-f07fd03c2743> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7422.4" ;
    skos:prefLabel "radiotekniker"@nb ;
    skos:definition "Radioteknikere monterer, justerer, tester, vedlikeholder og reparerer mobilt eller stasjonært radiosendings- og -mottaksutstyr og toveis radiokommunikasjonssystemer. De overvåker også ytelsen og fastslå årsaker til feil."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7422> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/c0c1364d-f784-4e76-8d3f-1e998dc6545d> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7422.5" ;
    skos:prefLabel "alarmtekniker"@nb ;
    skos:definition "Alarmteknikere monterer og vedlikeholder alarmanlegg som beskytter mot farer, for eksempel brann og innbrudd. De monterer sensorer og kontrollsystemer, og kobler dem til strøm og telekommunikasjonslinjer om nødvendig. Alarmteknikere forklarer bruken av de monterte systemene til brukere."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7422> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/d07e6a57-a339-4cfd-bf22-a951713148a3> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7422.6" ;
    skos:prefLabel "operatør av telekommunikasjonsutstyr"@nb ;
    skos:definition "Operatører av telekommunikasjonsutstyr reparerer, monterer eller vedlikeholder mobilt eller stasjonært utstyr for kringkasting og toveis radiokommunikasjon (herunder utstyr til mobiltelefoni, mobilt bredbånd, sjø-til-land-radio og fly-til-bakke-kommunikasjon og radioutstyr i service- utrykningskjøretøy). De arbeider også med kommunikasjonsmaster, -antenner, -forsterkere og -kontakter. De kan teste og analysere nettverksdekning."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7422> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/056bef79-c125-47ab-b6b9-8eed05c9458c> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7422.7" ;
    skos:prefLabel "telekommunikasjonstekniker"@nb ;
    skos:definition "Telekommunikasjonsteknikere monterer, tester, vedlikeholder og feilsøker telekommunikasjonssystemer. De reparerer eller skifter ut defekte enheter og utstyr og opprettholder et trygt arbeidsmiljø og en komplett beholdning av deler. De gir også bruker- eller kundestøtte."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7422> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/37c7880e-cfee-4c41-a41b-061682fefde3> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7511.1" ;
    skos:prefLabel "slakter, slakterbutikk"@nb ;
    skos:definition "slakter, slakterbutikk bestiller, kontrollerer og kjøper kjøtt for å tilberede det og selge det som kjøttprodukter til forbrukere. De skjærer, trimmer, utbeiner, binder og kverner kjøtt av okse, svin og fjærkre. De klargjør de nevnte kjøttypene for konsum."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7511> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/48b336d2-7ffb-49a3-a010-444b68ddd12d> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7511.1.1" ;
    skos:prefLabel "halalslakter"@nb ;
    skos:definition "Halalslaktere bestiller, kontrollerer og kjøper kjøtt for å tilberede det og selge det som kjøttprodukter til forbrukere i henhold til islamsk praksis. De skjærer, trimmer, utbeiner, binder og kverner kjøtt av okse og fjærkre. De klargjør halalkjøtt for konsum."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/37c7880e-cfee-4c41-a41b-061682fefde3> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/d4cbc865-ad88-4b07-9525-2af3dd31cf0d> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7511.1.2" ;
    skos:prefLabel "kosherslakter"@nb ;
    skos:definition "Kosherslaktere bestiller, kontrollerer og kjøper kjøtt for å tilberede det og selge det som kjøttprodukter til forbrukere i henhold til jødisk praksis. De skjærer, trimmer, utbeiner, binder og kverner kjøtt fra kosherdyr, for eksempel kuer, sauer og geiter. De klargjør kosherkjøtt for konsum."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/37c7880e-cfee-4c41-a41b-061682fefde3> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/c0386702-0699-4550-920b-1f7027c9a3d9> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7511.2" ;
    skos:prefLabel "fiskeforarbeider"@nb ;
    skos:definition "Fiskeforarbeidere klargjør fisk og skalldyr i henhold til forskrifter for hygiene, matsikkerhet og handel. De bearbeider fisk og håndterer også detaljhandelsvirksomhet."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7511> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/6c39cf1c-7332-41c1-86c3-6ed3daf3c479> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7511.3" ;
    skos:prefLabel "fiskesløyer"@nb ;
    skos:definition "Fiskesløyere skjærer av fiskehoder og fjerner organer fra kroppen for produksjon av fiske- og sjømat. De fjerner organer ved å skrape og vaske, skjærer av defekte områder og pakker den bearbeidede fisken i egnede beholdere."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7511> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/05f6eaeb-b285-46bd-a44a-225bd429e329> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7511.4" ;
    skos:prefLabel "kjøttskjærer"@nb ;
    skos:definition "Kjøttskjærere skjærer dyreskrotter i store og små deler for videre bearbeiding. De fjerner bein fra forbehandlede dyreskrotter, enten manuelt eller ved bruk av maskiner."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7511> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/7e33b166-4a6d-40f3-8048-83b3a9d3ef49> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7511.5" ;
    skos:prefLabel "kjøttbearbeider"@nb ;
    skos:definition "Kjøttbearbeidere klargjør ferskt kjøtt med ingredienser, for eksempel krydder, urter eller tilsetningsstoffer, og lager salgsklare kjøttprodukter."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7511> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/34ec79d0-85fb-445a-a5f2-df51b70c6375> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7511.6" ;
    skos:prefLabel "slakter"@nb ;
    skos:definition "Slaktere slakter dyr og bearbeider skrotter for videre bearbeiding og distribusjon."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7511> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/f1783e61-38b7-468e-b495-9c3c92f5ab0d> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7511.6.1" ;
    skos:prefLabel "halalslakteriarbeider"@nb ;
    skos:definition "Halalslakteriarbeidere slakter dyr og bearbeider skrotter for halalkjøtt fra kuer og kyllinger for videre bearbeiding og distribusjon. De slakter dyr som angitt i islamsk lov og sørger for at dyrene blir fôret, slaktet og hengt opp i henhold til dette."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/34ec79d0-85fb-445a-a5f2-df51b70c6375> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/d47d495f-159b-40c9-b3d2-6b651c903e28> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7511.6.2" ;
    skos:prefLabel "kosherslakteriarbeider"@nb ;
    skos:definition "Kosherslakteriarbeidere slakter dyr og bearbeider skrotter for kosherkjøtt for videre bearbeiding og distribusjon. De slakter dyr som angitt i jødisk lov og i henhold til ritualer."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/34ec79d0-85fb-445a-a5f2-df51b70c6375> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/1aadb308-432a-4d01-b54b-b4f7f76dd419> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7512.1" ;
    skos:prefLabel "baker"@nb ;
    skos:definition "Bakere lager et bredt spekter av brød, bakverk og andre bakevarer. De følger alle prosessene fra mottak og lagring av råvarer, klargjøring av råvarer til brødproduksjon, oppmåling og blanding av ingredienser til deig og heving. De betjener ovner for å bake produkter med riktig temperatur og tid."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7512> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/35f62568-eb4e-4a09-9d83-ecc73116f94c> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7512.2" ;
    skos:prefLabel "sjololademester"@nb ;
    skos:definition "Sjokolademestre lager konfektprodukter med sjokolade. De gjennomfører visuell, taktil og smaksmessig prøving av kakaomassen og finner ut om kakaomassens farge, tekstur og smak er i samsvar med spesifikasjonene."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7512> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/e00c46c4-bd3c-4d88-8d30-fc6f951554bd> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7512.3" ;
    skos:prefLabel "konfektmaker"@nb ;
    skos:definition "Konfektmakere lager et variert utvalg av kaker, sukkertøy og andre sukkervarer til industrielle formål eller til direkte salg."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7512> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/26852256-d423-41bb-8178-4d37ff2528b9> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7512.4" ;
    skos:prefLabel "pastatilvirker"@nb ;
    skos:definition "Pastatilvirkere tilbereder ulike typer pasta etter bestemte oppskrifter og prosesser."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7512> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/ff42d44c-34f8-46be-ad3a-2aad9a5e43f0> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7512.5" ;
    skos:prefLabel "konditormedarbeider"@nb ;
    skos:definition "Konditormedarbeidere tilbereder og baker kaker, kjeks, croissanter, paier og lignende produkter i henhold til oppskrifter."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7512> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/59088d93-bd71-4fd7-a39e-8cc9dd37dfae> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7522.1" ;
    skos:prefLabel "produsent av antikke møbler"@nb ;
    skos:definition "Produsenter av antikke møbler dupliserer og gjenskaper antikke møbler. De utarbeider tegninger og maler av artikkelen, lager, tilpasser og monterer deler og klargjør artikkelen i henhold til originale spesifikasjoner."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7522> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/e1416610-ad08-4f37-8b46-9f99632a5c0f> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7522.2" ;
    skos:prefLabel "møbelsnekker"@nb ;
    skos:definition "Møbelsnekkere bygger skap eller andre møbler ved å sage, forme og montere deler av tre. De bruker forskjellige typer automatiske verktøy og håndverktøy, for eksempel dreiebenker, høvler og sager."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7522> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/501a3798-08bf-4475-88d2-0e8c9befb101> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7522.3" ;
    skos:prefLabel "bøkker"@nb ;
    skos:definition "Bøkkere lager tønner og kar og lignende produkter av trestaver. De former trestavene, setter dem sammen med tønnebånd, og former tønnen slik at den kan holde på produktet den skal inneholde, i dag vanligvis alkoholholdige drikkevarer av førsteklasses kvalitet."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7522> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/2dc86f3d-a90e-4e7a-8a94-0bd728f22d7b> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7522.4" ;
    skos:prefLabel "rammemaker"@nb ;
    skos:definition "Rammemakere bygger rammer, mest av tre, til bilder og speil. De diskuterer spesifikasjonene med kundene og bygger eller justerer rammen deretter. De skjærer til, former og monterer treelementene og behandler dem for å oppnå ønsket farge og beskytte dem mot slitasje og brann. De skjærer til glasset og monterer det i rammen. I noen tilfeller skjærer de ut og pynter rammene. De kan også reparere, restaurere eller reprodusere eldre eller antikke rammer."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7522> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/fb6df00f-4810-442b-8f93-89b9580c7c9f> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7522.5" ;
    skos:prefLabel "overflatebehandler, møbelproduksjon"@nb ;
    skos:definition "Overflatebehandlere, møbelproduksjon pusser, rengjør og polerer overflaten til tremøbler med håndverktøy og kraftdrevne verktøy. De påfører trebelegg på treoverflater ved å bruke forskjellige teknikker, som børsting eller bruk av sprøytepistol. De velger og påfører riktig beskyttelses- og/eller dekorbelegg."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7522> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/5a551d36-0e14-40ab-84a2-7aa9b37dc528> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7522.6" ;
    skos:prefLabel "møbelrestaurerer"@nb ;
    skos:definition "Møbelrestaurerere analyserer materialer og teknikker for å vurdere tilstanden til et gammelt møbel og identifisere og klassifisere det i henhold til kunst- og kulturhistorie. De bruker gamle eller moderne verktøy og teknikker for å restaurere møbelet og gi råd til kundene om restaurering, bevaring og vedlikehold av slike gjenstander."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7522> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/6f8f1da1-9160-4b9f-ba30-e3396d3b2f92> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7522.7" ;
    skos:prefLabel "modellbygger, rekreasjonsformål"@nb ;
    skos:definition "Modellbyggere, rekreasjonsformål designer og konstruerer modeller for rekreasjonsformål, i forskjellige materialer, som plast, tre, voks og metaller, og for det meste for hånd."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7522> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/b3b79192-f6e0-4aa0-92d1-f876508e05b3> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7531.1" ;
    skos:prefLabel "kostymemaker"@nb ;
    skos:definition "Kostymemakere konstruerer, syr, farger, tilpasser og vedlikeholder kostymer som skal brukes i liveopptredener og i filmer eller TV-programmer. Deres arbeid er basert på kunstnerisk visjon, skisser eller ferdige mønstre kombinert med kunnskap om menneskekroppen, slik at brukeren får størst mulig bevegelsesfrihet. De samarbeider tett med designerne."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7531> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/5589e8e0-48d9-4193-8c85-86ba9f17e0e9> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7531.2" ;
    skos:prefLabel "dameskredder"@nb ;
    skos:definition "Dameskreddere designer, lager, tilpasser, endrer og reparerer skreddersydde, bespokeplagg eller håndlagde plagg for kvinner og barn av tekstilstoffer, lett skinn, pels og annet materiale. De produserer spesiallagde klær i henhold til kundens eller plaggprodusentens spesifikasjoner. De kan lese og forstå størrelsestabeller, detaljer om ferdige mål og så videre."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7531> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/d2078576-9c43-40f7-bf52-356f53d650fd> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7531.3" ;
    skos:prefLabel "sorterer, hud"@nb ;
    skos:definition "Sorterere, hud sorterer huder og skinn etter naturlige egenskaper, kategori og vekt, og etter eventuelle feils størrelse, sted, antall og type. De sammenligner partier med spesifikasjoner, gir en egenskapsklassifisering og er ansvarlige for trimming."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7531> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/fd1c0f5a-f465-4067-af54-621e68c90f74> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7531.4" ;
    skos:prefLabel "hattemaker"@nb ;
    skos:definition "Hattemakere designer og produserer hatter og annet hodeplagg."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7531> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/978ae3a2-0831-415a-8396-b84dde656fc5> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7531.5" ;
    skos:prefLabel "skredder"@nb ;
    skos:definition "Skreddere designer, lager, tilpasser, endrer og reparerer skreddersydde, bespokeplagg eller håndlagde plagg av tekstilstoffer, lett skinn, pels og annet materiale, eller lager hatter eller parykker for menn. De produserer spesiallagde klær i henhold til kundens eller plaggprodusentens spesifikasjoner. De kan lese og forstå størrelsestabeller, detaljer om ferdige mål og så videre."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7531> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/bd206ee9-61d6-45de-a369-0c71b8429efa> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7531.6" ;
    skos:prefLabel "parykkmaker"@nb ;
    skos:definition "Parykkmakere lager, tilpasser og vedlikeholder hårproteser til bruk i liveopptreden. De arbeider ut fra skisser, bilder og kunstneriske visjoner kombinert med kunnskap om menneskekroppen, slik at får størst mulig bevegelsesfrihet. De samarbeider tett med designerne."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7531> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/c932109b-3e4f-43aa-b346-1ea421da0adb> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7534.1" ;
    skos:prefLabel "flyinteriørmekaniker"@nb ;
    skos:definition "Flyinteriørmekanikere produserer, setter sammen og reparerer innvendig utstyr til fly, som seter, gulvbelegg, dørpaneler, tak, belysning osv. De skifter også underholdningsutstyr, f.eks. videosystemer. De inspiserer bestilte materialer og klargjør fartøyet innvendig for montering av nye deler."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7534> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/92dc335d-a116-416f-ad2b-257e5382e574> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7534.2" ;
    skos:prefLabel "madrassprodusent"@nb ;
    skos:definition "Madrassprodusenter fremstiller madrasser med stopping og yttertrekk. De håndstopper madrassene og kutter, fordeler og fester stoppingen og yttertrekket rundt et fjærsystem."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7534> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/95a89206-4dc8-4753-a5d9-bc14a0e5f7ca> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7534.3" ;
    skos:prefLabel "tapetseringsarbeider"@nb ;
    skos:definition "Tapetseringsarbeidere polstrer eller trekker gjenstander som møbler, paneler, ortopediske hjelpemidler, inventar og bildeler. De kan installere, reparere eller skifte ut trekket og stopningen til gjenstander med materialer som tekstiler, lær, semsket skinn eller bomull. De monterer også bånd og fjærer som trengs for å dekke materialet."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7534> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/cd3f5356-a16f-4aca-9d4b-ceba2b2afec5> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7534.3.1" ;
    skos:prefLabel "møbeltapetserer"@nb ;
    skos:definition "Møbeltapetserere utstyrer møbler med polstring, fjærer, bånd og trekk. De må av og til fjerne gammel polstring og fyllmasse og knekte fjærer før de reparerer møbelet med verktøy som stiftfjerner, hammer og meisel. Målet er å gjenopprette komforten og det estetiske ved setet og ryggen på møbelet."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/95a89206-4dc8-4753-a5d9-bc14a0e5f7ca> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/423f4021-322b-4257-9a4e-d6ee5d166fbc> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7534.3.2" ;
    skos:prefLabel "salmaker, båt"@nb ;
    skos:definition "Salmakere, båt produserer, monterer og reparerer interiørkomponenter for alle typer båter. De bruker automatiske verktøy, håndverktøy og verkstedsutstyr for å klargjøre og feste materialer og påføre finish. De inspiserer også innkommende materialer og klargjør båtinnredningen for nye komponenter."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/95a89206-4dc8-4753-a5d9-bc14a0e5f7ca> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/c9874f14-5474-43f6-b4a2-77a94f9abfb3> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7534.3.3" ;
    skos:prefLabel "salmaker, kjøretøy"@nb ;
    skos:definition "Salmakere, kjøretøy lager produksjonsprototyper og fremstiller og monterer innvendige deler for biler, busser, lastebiler osv. De bruker kraftverktøy, håndverktøy og verkstedsmaskiner til å forberede og feste materialer. De kontrollerer også innkommende materialer og klargjør kjøretøyet innvendig for innredningselementer."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/95a89206-4dc8-4753-a5d9-bc14a0e5f7ca> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/69c24e54-567c-4415-b59b-cda97fdbc50c> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7534.3.4" ;
    skos:prefLabel "salmaker, togvogner"@nb ;
    skos:definition "Salmakere, togvogner lager produksjonsmaler, produserer og monterer interiørkomponenter for togvogner. De bruker automatiske verktøy, håndverktøy og CNC-maskiner for å klargjøre og feste materialer. De inspiserer også innkommende materialer og klargjør kjøretøyet innvendig for innredningselementer."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/95a89206-4dc8-4753-a5d9-bc14a0e5f7ca> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/e6eea1ed-e982-4583-bafe-a0ac796f6cf1> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7535.1" ;
    skos:prefLabel "lærsorterer"@nb ;
    skos:definition "Lærsorterere inspiserer og klassifiserer lær under og ved slutten av produksjonsprosessen etter kvalitet, bruksformål og kundekrav. De arbeider i garverier og på lagere, og kontrollerer kvalitet, farge, størrelse, tykkelse og mykhet og ser etter defekter."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7535> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/24e9f120-eae8-411a-8daf-c48e8ae2f5f6> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7536.1" ;
    skos:prefLabel "lærhåndverker"@nb ;
    skos:definition "Lærhåndverkere bruker verktøy til å forberede sammenføyning av deler, slik at de blir klare for søm, eller til å ferdigstille deler som allerede er sydd sammen, slik at lærvaren får sin endelige form."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7536> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/8f592e05-8035-4646-b33e-a4ea2c2314e3> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7536.1.1" ;
    skos:prefLabel "lærhåndverker, etterbehandling"@nb ;
    skos:definition "Lærhåndverkere, etterbehandling klargjør lærvarer for ferdigstilling ved hjelp av ulike sluttbehandlinger (f.eks. krem, olje, voks, polering, plastfoliering osv.). De bruker verktøy, hjelpemidler og materialer til å montere håndtak og metalldeler i vesker, kofferter og annet tilbehør. De studerer operasjonsrekkefølgen i tråd med informasjon fra den overordnede og de tekniske spesifikasjonene for modellen. De bruker teknikker for stryking, innkreming eller oljing, påføring av impregneringsvæske, lærvasking, rengjøring, polering, voksing, børsting, tuppbrenning, fjerning av limrester og farging av topplaget i henhold til tekniske spesifikasjoner. De sjekker også visuelt kvaliteten på det ferdige produktet ved å se nøye etter folder, rette sømmer og renhet. De retter opp i avvik eller mangler som kan rettes opp i etterbehandlingen og meldes til en overordnet."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/24e9f120-eae8-411a-8daf-c48e8ae2f5f6> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/1d188cae-90e9-4950-9666-3e1a9500de50> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7536.1.2" ;
    skos:prefLabel "tilskjærer av lærvarer"@nb ;
    skos:definition "Tilskjærere av lærvarer kontrollerer lær, materialer og stansejern, velger ut områdene som skal stanses, plasserer delene på lær og andre materialer, sammenholder lærvarekomponenter (deler) og kontrollerer utstansede deler mot spesifikasjoner og kvalitetskrav. Alle aktiviteter og oppgaver utføres manuelt."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/24e9f120-eae8-411a-8daf-c48e8ae2f5f6> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/e666c384-2a14-4cd9-981f-7067dc0bb9a9> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7536.1.3" ;
    skos:prefLabel "håndsyer, lærvarer"@nb ;
    skos:definition "Håndsyere, lærvarer syr sammen deler av lær og andre materialer ved hjelp av enkle verktøy som nål, tang og saks for å ferdigstille produktet. De håndsyr også av estetiske grunner."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/24e9f120-eae8-411a-8daf-c48e8ae2f5f6> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/f8e76759-811e-4b39-9adf-3e77429cff8f> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7536.2" ;
    skos:prefLabel "skomaker"@nb ;
    skos:definition "Skomakere bruker hender eller maskiner til tradisjonell produksjon av mange ulike typer fottøy. De reparerer også alle typer fottøy på et reparasjonsverksted."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7536> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/07ba3429-cccd-435b-a7d0-c02ba962bbd9> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7536.2.1" ;
    skos:prefLabel "skomaker, skreddersydde sko"@nb ;
    skos:definition "Skomakere, skreddersydde sko arbeider i små produksjonsmiljøer (for eksempel verksteder) der sko vanligvis spesialtilpasses. De designer, forbereder, kutter, syr, monterer og ferdigstiller skreddersydd fottøy."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/f8e76759-811e-4b39-9adf-3e77429cff8f> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/3fa9a480-ceb3-4c2a-8a91-0508e1bb6ba5> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7536.2.2" ;
    skos:prefLabel "CAD-mønsterkonstruktør, sko"@nb ;
    skos:definition "CAD-mønsterkonstruktører, sko designer, justerer og endrer mønstre for alle typer fottøy ved hjelp av CAD-systemer. De bruker CAD-systemets «nesting»-moduler til å sjekke ulike leggevarianter med hensyn til materialforbruk. Når prøvemodellen er godkjent for produksjon, lager disse fagarbeiderne en serie med mønstre (gradering) for å produsere en serie av den samme fottøysmodellen i ulike størrelser."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/f8e76759-811e-4b39-9adf-3e77429cff8f> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/ce594060-b05a-45d8-ac41-1cf3bb980085> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7536.2.3" ;
    skos:prefLabel "håndskomaker"@nb ;
    skos:definition "Håndskomakere syr sammen deler av lær og andre materialer med enkle verktøy som nål, tang og saks for å fremstille skaft. De syr også for hånd av estetiske grunner eller for å montere skaftet på sålen hvis det dreier seg om komplett fottøy."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/f8e76759-811e-4b39-9adf-3e77429cff8f> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/93aa611c-a58c-43ff-bc34-6e201dfdd0dd> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7536.2.4" ;
    skos:prefLabel "mønsterkonstruktør, skotøy"@nb ;
    skos:definition "Mønsterkonstruktører, skotøy designer og klipper ut mønstre for alle typer fottøy ved hjelp av mange ulike hånd- og maskinverktøy. De sjekker ulike nestingvarianter og anslår materialforbruk. Når prototypen er godkjent for produksjon, produserer de en serie av mønstre for fottøy i ulike størrelser."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/f8e76759-811e-4b39-9adf-3e77429cff8f> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/0a5001af-ce4b-4787-92e8-62af70089e53> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7536.2.5" ;
    skos:prefLabel "lestarbeider, skoproduksjon"@nb ;
    skos:definition "Lestarbeidere, skoproduksjon former og fester fôr og skaft over lesten for hånd. Lestarbeidere trekker front-, midt- og bunnstykket over lesten ved hjelp av håndredskaper for å oppnå den endelige formen til fottøysmodellen. De trekker først frontkantene av skaftet over lesten, og bruker press på midt- og bunnstykket. Deretter trykkes kantene flate, overflødig tåkappe og fôr skjæres av, og så fastsettes formen ved hjelp av søm eller lim."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/f8e76759-811e-4b39-9adf-3e77429cff8f> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/15419750-d6e6-4ab8-a77b-b42794f2e168> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7536.2.6" ;
    skos:prefLabel "ortopeditekniker"@nb ;
    skos:definition "Ortopediteknikere for fottøy designer fottøy og lager prototyper ved hjelp av produksjonsteknologi. De kompenserer for og løser tilpasningsproblemer ved fot og ankel, designer og produserer fottøy med tilhørende ortopediske komponenter, herunder ortoser, innleggssåler, skosåler og annet."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/f8e76759-811e-4b39-9adf-3e77429cff8f> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/dc9b98da-c389-4caf-a21a-c6f8c530c0bf> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7536.2.7" ;
    skos:prefLabel "skoflikker"@nb ;
    skos:definition "Skoflikkere reparerer og fornyer slitt fottøy og andre varer, som belter og vesker. De bruker håndverktøy og spesialmaskiner til å montere såler og hæler, skifte utslitte spenner og rengjøre og pusse sko."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/f8e76759-811e-4b39-9adf-3e77429cff8f> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/2aae7736-f58b-4027-8de4-6884281c3b0b> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "7542.1" ;
    skos:prefLabel "sprengningsbas"@nb ;
    skos:definition "Sprengningsbaser plasserer ut og detonerer eksplosiver på en trygg måte på et anleggssted for å sprenge og skille materiale på stedet."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C7542> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/41d4be58-3111-48b5-814a-83117983dd16> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "8113.1" ;
    skos:prefLabel "borearbeider på oljeplattform"@nb ;
    skos:definition "Borearbeidere på oljeplattform styrer plassering og bevegelse av borerør. De betjener det automatiserte utstyret for rørhåndtering. De har ofte ansvar for tilstanden til boreslammet."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C8113> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/622b1d5e-bf14-4ec0-b83e-3bfcf8dff624> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "8113.2" ;
    skos:prefLabel "drilloperatør"@nb ;
    skos:definition "Drilloperatører fører tilsyn med et team under klargjørings- og boreoperasjoner. De overvåker brønnaktiviteten og treffer tiltak i nødssituasjoner."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C8113> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/d3c1c718-a093-4e2e-80a0-2bd331266a8b> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "8113.3" ;
    skos:prefLabel "prosessoperatør, oljeplattform"@nb ;
    skos:definition "Prosessoperatører, oljeplattform har ansvar for motorene som driver boreutstyret. De sørger for at alt annet utstyr på plattformen fungerer som det skal."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C8113> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/2a7d4b37-e831-4e20-827c-0682fe7e370e> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "8113.4" ;
    skos:prefLabel "pumpeoperatør, rørledning"@nb ;
    skos:definition "Pumpeoperatører, rørledning betjener pumpeutstyr og -systemer som transporterer væsker og stoffer (f.eks. kjemiske løsninger, råolje, gass og annet) fra ett sted til et annet. De betjener slanger, pumper og annet utstyr etter hvilket produkt som skal transporteres. De sørger for god sirkulasjon og flyt av produktet i rørledningen."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C8113> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/8d765d88-c8d6-406e-8dfe-e37c5aa89be6> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "8113.5" ;
    skos:prefLabel "boreassistent"@nb ;
    skos:definition "Boreassistenter kobler til eller fra når borerøret kjøres inn i eller trekkes ut av borehullet. De setter sammen og demonterer rør og bor og samler inn kjerneprøver. De vedlikeholder og reparerer utstyr på boredekket."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C8113> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/86c49d9c-b37d-4a14-8e9d-d0357005a48d> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "8113.6" ;
    skos:prefLabel "borearbeider"@nb ;
    skos:definition "Borearbeidere vedlikeholder og reparerer utstyr og maskineri på oljefelt med hånd- og kraftverktøy. De gjør generelt arbeid, som rengjøring, grøftegraving, skraping og maling av plattformkomponenter."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C8113> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/5d549551-d94a-4e98-8444-d6608d70c8d8> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "8113.7" ;
    skos:prefLabel "administrativ medarbeider, boreplattform"@nb ;
    skos:definition "Administrative medarbeidere, boreplattform har ansvar for de daglige boreoperasjonene. De gjør for det meste administrativt arbeid. Administrative medarbeidere på boreplattform sørger for at oljeplattformen har tilstrekkelig med materialer, reservedeler og nok personell til å opprettholde den daglige driften. De gjennomfører boreaktiviteter i henhold til et fastsatt program og fører tilsyn med boremannskaper og utstyr."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C8113> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/7a0afb5e-f118-449a-82bd-d8b9230fd49f> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "8113.8" ;
    skos:prefLabel "maskinoperatør, tunnelboring"@nb ;
    skos:definition "Maskinoperatører, tunnelboring arbeider med store tunnelboremaskiner, som vanligvis omtales som TBM-er. De regulerer driften av maskinen, justerer dreiemomentet for det roterende skjærehjulet og transportskruen, slik at tunnelen blir mest mulig stabil før tunnelringer monteres. Tunnelboremaskinoperatører monterer deretter forsterkede betongringer ved hjelp av fjernkontroll."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C8113> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/46bbecf4-368a-44a8-9262-dcd775ae2c46> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "8113.9" ;
    skos:prefLabel "brønnborer"@nb ;
    skos:definition "Brønnborere betjener boremaskiner og -utstyr for å åpne og opprettholde brønner for utvinning av malm, væsker og gasser. De registrerer operasjonene, vedlikeholder utstyr, forsegler ubrukte brønner og forebygger forurensing av grunnen."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C8113> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/782ced63-e234-42a4-a7bd-a2d9a12ee61a> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "8131.1" ;
    skos:prefLabel "maskinoperatør, påfylling av kapsler"@nb ;
    skos:definition "Maskinoperatører, påfylling av kapsler styrer fyllingen av gelatinkapsler med bestemte legemidler."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C8131> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/0d61e7e7-afde-49ca-b554-4633842be030> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "8131.10" ;
    skos:prefLabel "operatør av kalkovn"@nb ;
    skos:definition "Operatører av kalkovner styrer utstyr som brenner kalkstein for å fremstille kalk og karbondioksid. De styrer strømmen av materiale, brennstoff og luft, og følger med på strømmen av materiale og luft, temperaturen, brennstoffdiagrammer og oksygenmålere, og gjør justeringer om nødvendig. De fører også produksjonsjournaler."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C8131> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/7c64479f-7a76-49e9-ac42-bd925f2bf99d> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "8131.11" ;
    skos:prefLabel "kontrollromoperatør, gruvedrift"@nb ;
    skos:definition "Kontrollromoperatører, gruvedrift utfører en rekke oppgaver fra kontrollrommet for en gruve. De overvåker prosessene ved hjelp av opplysninger som vises elektronisk på skjermer, målere og lamper. Kontrollromoperatører gjør endringer i variabler og kommuniserer med andre avdelinger for å sikre at prosessene går som de skal og i henhold til fastsatte prosedyrer. De treffer egnede tiltak ved uregelmessigheter eller nødssituasjoner."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C8131> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/30cdbb0a-4f62-4d0e-811c-72e3f95d017b> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "8131.12" ;
    skos:prefLabel "operatør, nitrering"@nb ;
    skos:definition "Operatører, nitrering overvåker og styrer utstyr som bearbeider kjemiske stoffer ved produksjon av eksplosiver. De har ansvar for lagring av produktet i tanker."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C8131> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/bfdc096e-e450-424d-9340-46968047ed68> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "8131.13" ;
    skos:prefLabel "prosessoperatør, nøytralisering av nitroglyserin"@nb ;
    skos:definition "Prosessoperatører, nøytralisering av nitroglyserin vedlikeholder blandetanker for eksplosiver ved å nøytralisere nitroglyserinet som prosessen avgir."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C8131> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/01da600c-ddb3-4a37-95e9-5301b459ae90> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "8131.14" ;
    skos:prefLabel "prosessoperatør, nitroglyserin"@nb ;
    skos:definition "Prosessoperatører, nitroglyserin betjener gravitasjonsseparatoren som brukes ved behandling av eksplosiver, og kontrollerer temperatur og væskestrøm for å separere nitroglyserin fra brukte syrer."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C8131> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/0152b59d-5005-470c-9273-ef321477d8dc> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "8131.15" ;
    skos:prefLabel "maskinoperatør, fiberstoff"@nb ;
    skos:definition "Maskinoperatører, fiberstoff utfører kjemiske bearbeidingsprosesser på fiberstoff."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C8131> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/d5ad1da5-cf69-4508-9148-a5338f4ffe0e> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "8131.16" ;
    skos:prefLabel "maskinoperatør, parfymeproduksjon"@nb ;
    skos:definition "Maskinoperatører, parfymeproduksjon betjener maskiner for parfymeproduksjon ved å klargjøre maskiner og verktøy, rengjøre og vedlikeholde utstyret og innrette seg etter produksjonsplanen."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C8131> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/c93d58bd-3aa6-4de4-812d-010542f1dec8> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "8131.17" ;
    skos:prefLabel "maskinoperatør, pilleproduksjon"@nb ;
    skos:definition "Maskinoperatører, pilleproduksjon betjener pillemaskinen som lager piller av ulik størrelse og form. De fyller også maskinen med nødvendige råvarer, åpner ventiler for å styre råvarestrømmen og regulerer temperaturen i maskinen."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C8131> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/3a67544c-919f-4051-b812-c08e69eec3fd> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "8131.18" ;
    skos:prefLabel "maskinoperatør, såpekomprimering"@nb ;
    skos:definition "Maskinoperatører, såpekomprimering styrer komprimeringsmaskinen som produserer såpestykker av ulike former og størrelser, og sørger for at sluttproduktet er i samsvar med spesifikasjonene og kvalitetskravene."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C8131> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/39e06c20-d262-44f9-a6a8-a0f3ba9e887c> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "8131.19" ;
    skos:prefLabel "såpekoker"@nb ;
    skos:definition "Såpekokere betjener utstyr og blandere for såpeproduksjon og sørger for at sluttproduktet er i samsvar med formelen."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C8131> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/29a36f21-da45-4a01-b015-cac4445e5025> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "8131.19.1" ;
    skos:prefLabel "maskinoperatør, såpeproduksjon"@nb ;
    skos:definition "Maskinoperatører, såpeproduksjon betjener maskiner som gjør om såpestykker til såpestrimler og sørger for at sluttproduktet er i samsvar med formelen. De håndterer også transport og lagring av såpestrimler."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/39e06c20-d262-44f9-a6a8-a0f3ba9e887c> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/34c191ec-e3e3-4746-ae10-7ff4306a2794> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "8131.19.2" ;
    skos:prefLabel "maskinoperatør, tørking av såpe"@nb ;
    skos:definition "Maskinoperatører, tørking av såpe styrer og opprettholder maskiner med flytende såpe ved produksjon av såpeflak. De tar prøver og sørger for at de tørkede såpeflakene samles opp i oppbevaringsbeholdere."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/39e06c20-d262-44f9-a6a8-a0f3ba9e887c> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/5b3ef95b-7d99-4af9-b2d0-41c6bc33f58c> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "8131.2" ;
    skos:prefLabel "maskinoperatør, blanding av kjemikalier"@nb ;
    skos:definition "Maskinoperatører, blanding av kjemikalier betjener og vedlikeholder blandetanker og miksere for å fremstille kjemiske produkter av råstoffer, og sørger for at sluttproduktene er i samsvar med spesifikasjonene for varepartiet."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C8131> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/81f8ea60-41d4-434a-b0fc-f870e83e7e27> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "8131.2.1" ;
    skos:prefLabel "maskinoperatør, blanding av gjødsel"@nb ;
    skos:definition "Maskinoperatører, blanding av gjødsel betjener og vedlikeholder maskiner som blander kjemikalier for å fremstille gjødsel, og sørger for at sluttproduktet er i samsvar med spesifikasjonene."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/5b3ef95b-7d99-4af9-b2d0-41c6bc33f58c> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/237e21f1-a7fa-4273-91eb-28e7b5d72f60> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "8131.2.2" ;
    skos:prefLabel "maskinoperatør, lakkblander"@nb ;
    skos:definition "Maskinoperatører, lakkblander betjener og vedlikeholder blandeinnretninger for lakk og syntetisk maling og sørger for at sluttproduktet er i samsvar med formelen."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/5b3ef95b-7d99-4af9-b2d0-41c6bc33f58c> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/8b273f5e-bdc5-4b73-80bd-3e324a20309b> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "8131.2.3" ;
    skos:prefLabel "maskinoperatør, blanding av maling"@nb ;
    skos:definition "Maskinoperatører, blanding av maling betjener og vedlikeholder maskiner som blander lakk, løsemidler og maling, og sørger for at sluttproduktet er i samsvar med den angitte formelen."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/5b3ef95b-7d99-4af9-b2d0-41c6bc33f58c> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/165f32b8-756a-4ef3-87f1-83fbbdc60db7> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "8131.2.4" ;
    skos:prefLabel "maskinoperatør, blanding av pesticider"@nb ;
    skos:definition "Maskinoperatører, blanding av pesticider betjener og vedlikeholder maskiner som blander tørre eller flytende kjemikalier for å produsere insektmidler, soppdrepende midler, rottegift eller ugressmiddel, og sørger for at sluttproduktet er i samsvar med formelen."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/5b3ef95b-7d99-4af9-b2d0-41c6bc33f58c> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/ee37a4a5-5360-4e94-a749-a2b8ead08500> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "8131.2.5" ;
    skos:prefLabel "maskinoperatør, sprengstoff"@nb ;
    skos:definition "Maskinoperatører, sprengstoff betjener maskiner og utstyr som brukes til å produsere tennhetter og sprengstoff ved å blande flytende og tørre kjemikalier og samtidig sørge for at de nødvendige parameterne er fastsatt, og at de brennbare blandingene er i samsvar med spesifikasjonene."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/5b3ef95b-7d99-4af9-b2d0-41c6bc33f58c> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/c76566f1-97a1-43e9-a7d8-155db0e56987> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "8131.2.6" ;
    skos:prefLabel "maskinoperatør, blanding av ferniss"@nb ;
    skos:definition "Maskinoperatører, blanding av ferniss betjener utstyr og blandere for fernissproduksjon ved å smelte, blande og koke de nødvendige kjemikaliene i samsvar med spesifikasjonene."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/5b3ef95b-7d99-4af9-b2d0-41c6bc33f58c> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/c7c3f05b-319b-4aa7-891e-78106f875de2> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "8131.20" ;
    skos:prefLabel "prosessoperatør, såpeproduksjon"@nb ;
    skos:definition "Prosessoperatører, såpeproduksjon styrer, overvåker og vedlikeholder driften av tørketårnet ved hjelp av kontrollpanelet, for å produsere såpepulver. De inspiserer driftsenheter for å sikre at strømmen av olje, luft, parfyme og damp er i samsvar med spesifikasjonene."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C8131> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/daa6197d-dba6-49b5-8223-b31b7a126e4e> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "8131.21" ;
    skos:prefLabel "prosessoperatør, voksbleking"@nb ;
    skos:definition "Prosessoperatører, voksbleking betjener og vedlikeholder filterpresser og tanker som brukes til voksbleking, ved produksjon av stearinlys."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C8131> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/8f71761e-6fa5-4237-a240-4d0c7feff026> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "8131.3" ;
    skos:prefLabel "koksverkoperatør"@nb ;
    skos:definition "Koksverkoperatører overvåker driften av en vanligvis automatisk industriovn som mates med knust, vasket og blandet bituminøst kull og varmer det til mellom 1 000 og 2 000 °C uten oksygentilførsel for å produsere koks. Den ferdige koksen bråkjøles så med vann eller luft og forberedes for transport."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C8131> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/ff5210a5-2ea9-43b4-bebc-8d565f928eaa> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "8131.4" ;
    skos:prefLabel "maskinoperatør, kosmetikkproduksjon"@nb ;
    skos:definition "Maskinoperatører, kosmetikkproduksjon betjener maskineri for produksjon av kosmetiske produkter ved å klargjøre maskiner og verktøy, rengjøre og vedlikeholde utstyr og følge produksjonsplanen."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C8131> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/310ad9e0-ffc9-4980-b47c-1e856a404eff> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "8131.5" ;
    skos:prefLabel "operatør av destillasjonsutstyr"@nb ;
    skos:definition "Operatører av destillasjonsutstyr utfører og passer på oljedestillasjonsprosessen og hjelper til med feilsøking. De betjener destilleringsutstyr for å separere mellomprodukter og urenheter fra olje. De skrur på ventiler og målere for å oppnå korrekt temperatur, materialstrøm, trykk osv."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C8131> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/1999bdfa-f9c4-4a0b-8565-0305108ca65e> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "8131.6" ;
    skos:prefLabel "tørkehusoperatør, fyrverkeri"@nb ;
    skos:definition "Tørkehusoperatører, fyrverkeri overvåker og vedlikeholder tørkehus og sørger for at pyrotekniske artikler tørkes og lagres under korrekte forhold og etter spesifikasjonene."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C8131> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/d3382c5a-589f-453d-a6d8-d28695057079> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "8131.7" ;
    skos:prefLabel "operatør, kjemisk fremstilling"@nb ;
    skos:definition "Operatører, kjemisk fremstilling styrer og vedlikeholder utstyr og tanker til produksjon av aktive og funksjonelle bestanddeler i legemidler, som for eksempel antibiotika og vitaminer. De arbeider også med produksjon av kosmetiske produkter eller produkter til personlig pleie."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C8131> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/21a42cfb-68c7-4f84-bdd7-81de07a6fff3> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "8131.8" ;
    skos:prefLabel "måler, oljeproduksjon"@nb ;
    skos:definition "Målere, oljeproduksjon tester oljen under bearbeiding og før utsendelse. De styrer pumpesystemer og regulerer flyten til oljeledningene."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C8131> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/0dae04a4-fa4c-40d3-8518-122cc0f7bfcf> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "8131.9" ;
    skos:prefLabel "maskinoperatør, granulator"@nb ;
    skos:definition "Maskinoperatører, granulator utfører blanding og granulering av ingredienser i pulverform med blande- og valsemaskiner for å klargjøre ingrediensene for komprimering til medisinske tabletter. De klargjør produksjonsmengden og følger ingrediensformler."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C8131> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/8b98dbc3-11f7-4720-86de-dcecee368be1> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "8142.1" ;
    skos:prefLabel "maskinoperatør, formblåsing"@nb ;
    skos:definition "Maskinoperatører, formblåsing betjener og overvåker formblåsingsmaskiner som former plastprodukter i henhold til kravene. De regulerer temperatur, lufttrykk og plastvolum i henhold til spesifikasjoner. Maskinoperatører for formblåsing fjerner de ferdige produktene og skjærer bort overskytende materiale med kniv. De kverner overskytende materiale og forkastede produkter for gjenbruk ved hjelp av en kvern."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C8142> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/4a5ceaae-0f05-4091-bdbf-59f250ce6374> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "8142.10" ;
    skos:prefLabel "utstyrsoperatør, varmebehandling av plast"@nb ;
    skos:definition "Utstyrsoperatører, varmebehandling av plast manipulerer plastprodukter ved hjelp av maskineri som ovner eller flammeherdingsmaskiner for å herde, gløde eller varmebehandle. De klargjør maskineriet og leser produksjonsinstruksene for å fastslå temperaturen i ovnen. Utstyrsoperatører for varmebehandling av plast fjerner produktene fra maskinene, lar dem kjøle seg ned, undersøker og tester produktene for å kontrollere at de er i samsvar med spesifikasjonene."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C8142> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/8ba8acb8-c0f2-4679-ae15-3a4f6e876c6f> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "8142.11" ;
    skos:prefLabel "maskinoperatør, produksjon av plastruller"@nb ;
    skos:definition "Maskinoperatører, produksjon av plastruller betjener og overvåker maskiner som produserer plastruller, eller som flater ut og reduserer materialet. De undersøker råstoffer og ferdige produkter for å sikre at de er i samsvar med spesifikasjonene."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C8142> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/c22724a3-079c-4897-bd92-d99e068b6ffc> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "8142.12" ;
    skos:prefLabel "maskinoperatør, profiltrekking"@nb ;
    skos:definition "Maskinoperatører, profiltrekking betjener, styrer og vedlikeholder maskiner som produserer komposittmaterialer med jevn profil ved å armere med fibre som f.eks. glassfiber i det eksisterende materialet og belegge resultatet med harpiks. Dette trekkes deretter gjennom en oppvarmet dyse, der det herdes."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C8142> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/ae3f1edd-d191-4a8d-8dfc-099dcdc6f1e8> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "8142.13" ;
    skos:prefLabel "maskinoperatør, produksjon av vinylplater"@nb ;
    skos:definition "Maskinoperatører, produksjon av vinylplater betjener en maskin som presser vinyl med et negativt avtrykk av en master-plate. Når det påføres trykk, presses vinylen inn i fordypningene i master-platen, og man får en spillbar plate."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C8142> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/6e18b923-7c5f-42d7-8ff0-de8d8ba30dbf> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "8142.14" ;
    skos:prefLabel "maskinoperatør, vakuumforming"@nb ;
    skos:definition "Maskinoperatører, vakuumforming betjener, styrer og vedlikeholder maskiner som varmer opp plastplater og legger dem rundt en støpeform ved hjelp av vakuumsuging; når platene blir avkjølt, har de samme form som støpeformen."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C8142> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/96514fed-b9a9-4df3-ab0b-20676369297d> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "8142.2" ;
    skos:prefLabel "operatør, plastpresse"@nb ;
    skos:definition "Operatører, plastpresse klargjør og betjener den hydrauliske pressen som komprimerer og sintrer plaststrimler i kakeformer for å produsere plastplater. De regulerer og tilpasser trykket og temperaturen."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C8142> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/ec238461-93b6-4516-a251-52d1153b53ac> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "8142.3" ;
    skos:prefLabel "maskinoperatør, formpresse"@nb ;
    skos:definition "Maskinoperatører, formpresse klargjør og betjener maskiner som former plastprodukter i henhold til spesifikasjoner. De velger ut og monterer former på pressen. Maskinoperatører, formpresse veier opp forhåndsblandet blanding og heller den over i formen. De regulerer formens temperatur."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C8142> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/25f45b01-550c-4d17-b69e-7c5ba57c4218> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "8142.4" ;
    skos:prefLabel "glassfiberlaminerer"@nb ;
    skos:definition "Glassfiberlaminerere former glassfibermaterialer til skrog og båtdekk. De leser arbeidstegninger og bruker hånd- og kraftverktøy til å skjære til komposittmaterialet. De påfører voks og lakk og klargjør overflatene for påføring av glassfibermatter. De bruker glassfiber mettet med harpiks til å feste armeringslekter av tre til lugarstrukturer og dekk. De klargjør også materialer ved å utsette dem for riktig temperatur. De ser etter mangler ved det ferdige produkter, og sikrer at de er i samsvar med spesifikasjonene."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C8142> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/772e57c5-fb25-4b0c-8cc8-f8944a9edfbc> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "8142.5" ;
    skos:prefLabel "maskinoperatør, glassfiberproduksjon"@nb ;
    skos:definition "Maskinoperatører, glassfiberproduksjon betjener og vedlikeholder maskinen som sprayer en blanding av harpiks og glassfiber på produkter som badekar og båtskrog for å oppnå sterke og lette kompositt-sluttprodukter."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C8142> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/88b21b2f-350c-4f41-9680-a53f8ea708ed> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "8142.6" ;
    skos:prefLabel "maskinoperatør, filamentvikling"@nb ;
    skos:definition "Maskinoperatører, filamentvikling betjener, styrer og vedlikeholder maskiner som belegger filament, vanligvis glassfiber eller karbon, med harpiks og vikler dem rundt en roterende form for å produsere rør, beholdere, slanger og andre hule, sylindriske produkter."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C8142> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/502fe307-ae65-46cb-a485-e559b9a35266> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "8142.7" ;
    skos:prefLabel "operatør av sprøytestøpemaskin"@nb ;
    skos:definition "Operatører av sprøytestøpemaskiner betjener og overvåker sprøytestøpemaskiner som støper produkter av termoplastmaterialer. De regulerer temperatur, trykk og plastvolum i samsvar med forhåndsdefinerte spesifikasjoner. Operatører av sprøytestøpemaskiner fjerner også de ferdige produktene og skjærer bort overskytende materiale med en kniv eller andre håndverktøy."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C8142> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/a4ab8347-782f-4ca1-940d-44ffea256ebf> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "8142.7.1" ;
    skos:prefLabel "operatør av støpemaskin, optisk disklesing"@nb ;
    skos:definition "Operatører av støpemaskin, optisk disklesing betjener støpemaskiner som smelter polykarbonatpelleter og injiserer plasten i et hulrom i en form. Deretter kjølner og stivner plasten, med et merke som kan leses digitalt."@nb ;
    skos:broader <http://data.europa.eu/esco/occupation/502fe307-ae65-46cb-a485-e559b9a35266> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/4a30b421-2fda-42d6-b7e1-1c31753f061d> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "8142.8" ;
    skos:prefLabel "prosessoperatør, opprulling av isoleringsrør"@nb ;
    skos:definition "Prosessoperatører, opprulling av isoleringsrør klargjør og betjener en maskin som ruller opp isoleringsrør og kapper dem i angitt lengde."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C8142> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/84d45916-eef7-4c58-a73c-3639c9965014> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "8142.9" ;
    skos:prefLabel "maskinoperatør, plastmøbler"@nb ;
    skos:definition "Maskinoperatører, plastmøbler betjener plastbehandlingsmaskiner som produserer ting som plaststoler og bord. De kontrollerer hvert enkelt produkt, oppdager avvik og fjerner produkter som ikke holder mål. I noen tilfeller setter de sammen ulike plastdeler for å fremstille sluttproduktet."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C8142> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/c706886d-5bc7-4430-9a72-051fc483235f> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "8143.1" ;
    skos:prefLabel "maskinoperatør, produksjon av absorberende materiale"@nb ;
    skos:definition "Maskinoperatører, produksjon av absorberende materiale betjener en maskin som blir matet med cellulosefibre og komprimerer dem til et svært absorberende porøst materiale for bruk i hygieneprodukter som bleier og tamponger."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C8143> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/eb5df714-15ce-4e31-853c-678d2aba568b> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "8143.2" ;
    skos:prefLabel "operatør av bølgepappmaskin"@nb ;
    skos:definition "Operatører av bølgepappmaskiner betjener en maskin som bretter et ark tungt papir og gir det et bølgeaktig mønster, dekker det på begge sider og lager et lett, solid materiale egnet til emballering."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C8143> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/65b88636-2ebb-4049-b509-2f6da5d6ea1c> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "8143.3" ;
    skos:prefLabel "maskinoperatør, konvoluttproduksjon"@nb ;
    skos:definition "Maskinoperatører, konvoluttproduksjon betjener en maskin som blir matet med papir og utfører operasjoner for å lage konvolutter: skjære og brette papiret, lime det, og deretter påføre et svakere og næringsmiddelgodkjent lim på flappen som forbrukeren lukker."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C8143> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/73270b73-8c71-445f-a8d3-4647b1ae38d0> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
    skos:notation "8143.4" ;
    skos:prefLabel "maskinoperatør, produksjon av papirposer"@nb ;
    skos:definition "Maskinoperatører, produksjon av papirposer betjener en maskin som blir matet med papir, som deretter blir brettet og limt for å lage papirposer av ulike størrelser, former og styrkegrader."@nb ;
    skos:broader <http://data.europa.eu/esco/isco/C8143> ;
    dcterms:source <https://esco.ec.europa.eu> .

<http://data.europa.eu/esco/occupation/fc9a86ec-7ad5-4ccb-a08f-1e369197e14a> a skos:Concept, esco:Occupation ;
    skos:inScheme <http://data.europa.eu/esco/concept-scheme/occupations> ;
