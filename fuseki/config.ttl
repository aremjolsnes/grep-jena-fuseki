## Fuseki-konfigurasjon for Grep-sandkassen.
##
## Lesing er åpen, skriving krever innlogging (brukeren "admin", passord fra Fly-secret
## FUSEKI_PASSWORD, skrevet til passordfilen ved oppstart, se Dockerfile).
##
## Datasettet har ingen endepunkter på roten (/ds) – alle operasjoner har egne navn,
## slik at det er entydig hva som er åpent.

PREFIX fuseki: <http://jena.apache.org/fuseki#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX tdb2:   <http://jena.apache.org/2016/tdb#>
PREFIX text:   <http://jena.apache.org/text#>
PREFIX u:      <http://psi.udir.no/ontologi/kl06/>
PREFIX udir:   <http://psi.udir.no/ontologi/>

[] rdf:type fuseki:Server .

<#service> rdf:type fuseki:Service ;
    fuseki:name "ds" ;
    # Åpent: spørringer og lesing via Graph Store Protocol
    fuseki:endpoint [ fuseki:operation fuseki:query ; fuseki:name "query" ] ;
    fuseki:endpoint [ fuseki:operation fuseki:query ; fuseki:name "sparql" ] ;
    fuseki:endpoint [ fuseki:operation fuseki:gsp-r ; fuseki:name "get" ] ;
    # Krever innlogging: SPARQL Update og skriving via Graph Store Protocol
    fuseki:endpoint [ fuseki:operation fuseki:update ; fuseki:name "update" ;
                      fuseki:allowedUsers "admin" ] ;
    fuseki:endpoint [ fuseki:operation fuseki:gsp-rw ; fuseki:name "data" ;
                      fuseki:allowedUsers "admin" ] ;
    fuseki:dataset <#tekst> .

# Fritekstsøk (jena-text med Lucene, innebygd i Fuseki). Indeksen ligger på volumet ved siden av
# databasen og oppdateres av hver skriving (PUT, MOVE, INSERT, CLEAR). uidField gjør at slettede
# tripler også forsvinner fra indeksen, slik at den ikke vokser fra natt til natt.
#
#   ?km text:query (udir:bokmaalTittel "kildekritikk") .   # bokmål, med norsk stamming
#   ?x  text:query (u:tittel "modell*") .                   # alle titler, alle språk
<#tekst> rdf:type text:TextDataset ;
    text:dataset <#tdb> ;
    text:index   <#indeks> .

<#indeks> rdf:type text:TextIndexLucene ;
    text:directory <file:/fuseki/lucene> ;
    text:entityMap <#feltkart> ;
    text:storeValues true .

<#feltkart> rdf:type text:EntityMap ;
    text:entityField  "uri" ;
    text:uidField     "uid" ;
    text:defaultField "bokmaal" ;
    text:map (
        [ text:field "bokmaal" ; text:predicate udir:bokmaalTittel ;
          text:analyzer [ rdf:type text:GenericAnalyzer ;
                          text:class "org.apache.lucene.analysis.no.NorwegianAnalyzer" ] ]
        [ text:field "nynorsk" ; text:predicate udir:nynorskTittel ;
          text:analyzer [ rdf:type text:GenericAnalyzer ;
                          text:class "org.apache.lucene.analysis.no.NorwegianAnalyzer" ] ]
        [ text:field "tittel"  ; text:predicate u:tittel ;
          text:analyzer [ rdf:type text:StandardAnalyzer ] ]
    ) .

# Samme TDB2-lokasjon som tidligere (--tdb2 --loc=/fuseki/databases), så eksisterende data beholdes.
#
# unionDefaultGraph: spørringer uten GRAPH/FROM ser unionen av alle named graphs
# (urn:graph:grep, urn:graph:ontologi, urn:graph:meta, ...). Den lagrede default graph
# blir da usynlig for spørringer; derfor ligger alle data i named graphs.
<#tdb> rdf:type tdb2:DatasetTDB2 ;
    tdb2:location "/fuseki/databases" ;
    tdb2:unionDefaultGraph true .
